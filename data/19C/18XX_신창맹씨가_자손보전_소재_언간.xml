<letter n="04" sender="완산이씨(어머니)" writer="완산이씨(어머니)" receiver="맹숙주(아들)" year="1704년">
<sent type="main" lang="kor" page="04" n="01">아긔게</sent>
<sent type="main" lang="kor" page="04" n="02">너ᄅᆞᆯ ᄯᅥ나 보내니</sent>
<sent type="main" lang="kor" page="04" n="03">모ᄌᆡ 처엄으로 먼리 ᄯᅥ나나</sent><!--'ᄯᅥ나나'에서 뒤에 오는 '나'는 재점으로 표기되어 있음-->
<sent type="main" lang="kor" page="04" n="04">못 닛ᄂᆞᆫ 졍은 닐러 알 일이 아니니</sent>
<sent type="main" lang="kor" page="04" n="05">다시 뎍디 아니ᄒᆞ거니와</sent>
<sent type="main" lang="kor" page="04" n="06">네 내 독ᄌᆞ로 ᄯᅩ 휵양ᄒᆞ미 간고ᄒᆞᆫ ᄉᆞ태우 집과 달라</sent>
<sent type="main" lang="kor" page="04" n="07">됴히 ᄌᆞ라기로 셰ᄐᆡᄅᆞᆯ 아디 못ᄒᆞ여</sent>
<sent type="main" lang="kor" page="04" n="08">냥반의 글이 귀ᄒᆞ며 녜의 념티 듕ᄒᆞᆫ 줄을 오히려 네 아디 못ᄒᆞ여</sent>
<sent type="main" lang="kor" page="04" n="09">ᄇᆞᆯ셔 나히 십삼 셰 되니</sent>
<sent type="main" lang="kor" page="04" n="10">혼ᄎᆔ 셩인이 머디 아녀시니</sent>
<sent type="main" lang="kor" page="04" n="11">어미 그리온 졍은 ᄉᆡᆼ각 말고</sent>
<sent type="main" lang="kor" page="04" n="12">ᄉᆞ댱이란 거ᄉᆞᆫ ᄒᆞᆯᄅᆞᆯ 슈ᄒᆞᆨᄒᆞ여도 죵신토록 공경ᄒᆞᄂᆞᆫ 거시니</sent>
<sent type="main" lang="kor" page="04" n="13">공경ᄒᆞ고 조심ᄒᆞ며 버릇업ᄉᆞᆫ 샹된 말 ᄒᆞ여 외오 녀기게 말며</sent>
<sent type="main" lang="kor" page="04" n="14">ᄌᆞᆷ심ᄒᆞ여 챡실이 ᄇᆡ화 션ᄇᆡ 도ᄅᆞᆯ 일티 아니미 ᄌᆞ식의 효되니</sent>
<sent type="main" lang="kor" page="04" n="15">너 룡ᄇᆡᆨ고 두계량을 아라실 거시니</sent>
<sent type="main" lang="kor" page="04" n="16">집의셔 내게 일의ᄒᆞ던 버ᄅᆞᄉᆞᆯ 말고</sent>
<sent type="main" lang="kor" page="04" n="17">온윤ᄒᆞ며 ᄌᆞ연ᄒᆞ여 말ᄉᆞᆷ과 거ᄅᆞᆷ을 쳔쳔이 ᄒᆞ여</sent>
<sent type="main" lang="kor" page="04" n="18">브ᄃᆡ 네 급거ᄒᆞᆫ 셩품을 ᄀᆞ다드머 고티기ᄅᆞᆯ ᄇᆞ라노라</sent>
<sent type="main" lang="kor" page="04" n="19">알로라 ᄒᆞ니 어ᄃᆡᄅᆞᆯ 엇디 알ᄂᆞᆫ다 일념이 브리이디 아녀라</sent>
<sent type="main" lang="kor" page="04" n="20">ᄂᆡ년 이ᄯᅢ예 모ᄌᆡ 됴히 됴히 만나 보기ᄅᆞᆯ 기드리노라</sent><!--'됴히 됴히'에서 뒤에 오는 '됴히'는 재점으로 표기되어 있음-->  
<sent type="main" lang="kor" page="04" n="21">ᄒᆡᆼ혀 네 술 먹으리라 ᄉᆡᆼ심도 술 먹디 말고</sent>
<sent type="main" lang="kor" page="04" n="22">음식이 식셩의 맛게 ᄒᆞ더냐</sent>
<sent type="main" lang="kor" page="04" n="23">잡것 드려 허비ᄒᆞ여 먹디 마리</sent>
<sent type="main" lang="kor" page="04" n="24">내 병이 날포 이러코</sent>
<sent type="main" lang="kor" page="04" n="24">내 유모년이 지금 못 ᄒᆞ려 ᄒᆡᆼ뎐 못 보내니 후의 보내리</sent>
<sent type="main" lang="kor" page="04" n="26">날이 치운ᄃᆡ 몸조심ᄒᆞ여 됴히 됴히 디내여라</sent><!--'됴히 됴히'에서 뒤에 오는 '됴히'는 재점으로 표기되어 있음-->  
<sent type="main" lang="kor" page="04" n="27">네 인ᄉᆡ 미평ᄒᆞ기 심ᄒᆞ다</sent>
<sent type="main" lang="kor" page="04" n="28">녕감이 슌력을 낫다 말도 잇닷 말도 업ᄉᆞ니</sent>
<sent type="main" lang="kor" page="04" n="29">네 편지 두루 다 뎐코 이 무궁ᄒᆞᆫ 잡셔찰은 미처 못 뎐코</sent>
<sent type="main" lang="kor" page="04" n="30">신 쳠디ᄂᆞᆫ 네 ᄉᆞ댱인가 시ᄇᆞ니</sent>
<sent type="main" lang="kor" page="04" n="31">이ᄌᆡ 뎐ᄒᆞ여 답장 맛다 후편의 보내마</sent>
<sent type="main" lang="kor" page="04" n="32">내 말을 브ᄃᆡ 닛디 말고 심심ᄒᆞ여도 글말이나 뭇고</sent><!--'심심ᄒᆞ여도'에서 뒤에 오는 '심'은 재점으로 표기되어 있음-->
<sent type="main" lang="kor" page="04" n="33">젹이 ᄎᆞ며 시ᄅᆞᆷ 노릇ᄒᆞ기 브ᄃᆡ 말믈 ᄇᆞ라노라</sent>
<sent type="main" lang="kor" page="04" n="34">모셔ᄅᆞᆯ 모화 간ᄉᆞᄒᆞ고 일티 마라</sent>
<sent type="main" lang="kor" page="04" n="35">년ᄒᆞ여 됴히 잇거라</sent>
<sent type="main" lang="kor" page="04" n="36">갑신 구월 삼십일 모</sent>
<sent type="main" lang="kor" page="04" n="37">네 글시 ᄡᅳ던 죠ᄒᆡ와 붓을 보내랴 말랴</sent>
<sent type="main" lang="kor" page="04" n="38">글시도 노디 말고 ᄡᅥ라 네 편지 글시 긔괴ᄒᆞ다</sent>
</letter>

<letter n="05" sender="완산이씨(어머니)" writer="완산이씨(어머니)" receiver="맹숙주(아들)" year="1705~1731년">
<sent type="main" lang="kor" page="05" n="01">요ᄉᆞ이 무ᄉᆞᄒᆞ냐</sent>
<sent type="main" lang="kor" page="05" n="02">듀야 일념의 니ᄌᆞᆫ ᄉᆞ이 업고</sent>
<sent type="main" lang="kor" page="05" n="03">ᄒᆡᄌᆔ 가실 적 텨로 나ᄃᆞᆫ니고 요란히 구ᄂᆞᆫ가</sent>
<sent type="main" lang="kor" page="05" n="04">글 아니 니ᇃᄂᆞᆫ가</sent>
<sent type="main" lang="kor" page="05" n="05">듀야 념녀 일시도 니ᄌᆞᆫ ᄉᆞ이 업고</sent>
<sent type="main" lang="kor" page="05" n="06">오ᄂᆞᆫ 가ᄂᆞᆫ 사ᄅᆞᆷ이 업서 쇼식도 ᄌᆞ로 모ᄅᆞ니</sent>
<sent type="main" lang="kor" page="05" n="07">답답 념녜 무궁무궁ᄒᆞ며</sent><!--'답답'과 ‘무궁무궁ᄒᆞ며’에서 뒤에 오는 '답'과 ‘무궁’은 재점으로 표기되어 있음-->  
<sent type="main" lang="kor" page="05" n="08">왕ᄂᆡ의 편지도 아니니</sent><!--'아니니'에서 뒤에 오는 '니'는 재점으로 표기되어 있음-->
<sent type="main" lang="kor" page="05" n="09">다ᄅᆞᆫ 일은 담디 아니코</sent> 
<sent type="main" lang="kor" page="05" n="10">언문 아니 ᄡᅳ기ᄂᆞᆫ ᄇᆡ홧ᄂᆞᆫ다 답답도 아니ᄒᆞ냐</sent><!--'답답도'에서 뒤에 오는 '답'은 재점으로 표기되어 있음-->
<sent type="main" lang="kor" page="05" n="11">글이나 챡실히 닑고 나ᄃᆞᆫ니기나 아니ᄒᆞᄂᆞᆫ다</sent>
<sent type="main" lang="kor" page="05" n="12">칼은 뎌적 무ᄅᆞ니 못 미처 ᄆᆡᆼ그랏다 ᄒᆞ더니</sent>
<sent type="main" lang="kor" page="05" n="13">옛 ᄒᆡᆼ낭의 역질로 통티 못ᄒᆞ기로 엇디 ᄒᆞᄂᆞᆫ디</sent>
<sent type="main" lang="kor" page="05" n="14">네 답답ᄒᆞ여 ᄒᆞᆯ 일 분별ᄒᆞ노라</sent><!--'답답ᄒᆞ여'에서 뒤에 오는 '답'은 재점으로 표기되어 있음--> 
<sent type="main" lang="kor" page="05" n="15">내 병은 통셰ᄂᆞᆫ 나ᄋᆞᄃᆡ 바히 음식을 못 머그ᄃᆡ</sent>
<sent type="main" lang="kor" page="05" n="16">경대ᄃᆞ려 무러 달라 ᄒᆞ여 가감냥격산 세 복 머그ᄃᆡ</sent>
<sent type="main" lang="kor" page="05" n="17">죠곰도 ᄯᆞᆷ과 음식 먹기 낫디 아니코</sent>
<sent type="main" lang="kor" page="05" n="18">수삼 일간은 목ᄆᆞᄅᆞ기 더 심ᄒᆞ여</sent>
<sent type="main" lang="kor" page="05" n="19">어ᄌᆡ 언양더려 최 거ᄉᆞ의 무러 달라 ᄒᆞ엿더니</sent>
<sent type="main" lang="kor" page="05" n="20">아직 긔쳑 업다</sent>
<sent type="main" lang="kor" page="05" n="21">손도 곡 각기디 못게 붓고</sent>
<sent type="main" lang="kor" page="05" n="22">삼만은 염병을 ᄒᆞ여 오ᄂᆞᆯ 토열ᄒᆞ되</sent>
<sent type="main" lang="kor" page="05" n="23">어룬 죵이 업서 츌막 못ᄒᆞ여 하 뒤심심ᄒᆞ여</sent><!--'뒤심심ᄒᆞ여'에서 뒤에 오는 '심'은 재점으로 표기되어 있음-->
<sent type="main" lang="kor" page="05" n="24">잠 뎍으며 네 져고리 ᄒᆞ나 네 아바님 홋것 가니</sent>
<sent type="main" lang="kor" page="05" n="25">진걸이 맛뎌 ᄌᆞ시 티보ᄒᆞ여 허고</sent>
<sent type="main" lang="kor" page="05" n="26">나디 아니케 ᄒᆞ라 ᄒᆞ고</sent>
<sent type="main" lang="kor" page="05" n="27">브ᄃᆡ브ᄃᆡ 나ᄃᆞᆫ니디 말고 글 ᄇᆡ호고</sent><!--'브ᄃᆡ브ᄃᆡ'에서 뒤에 오는 '브ᄃᆡ'는 재점으로 표기되어 있음--> 
<sent type="main" lang="kor" page="05" n="28">유 비쟝이 권당이니 홀ᄃᆡᄒᆞ여 버ᄅᆞᆺ업시 슈욕 말고</sent>
<sent type="main" lang="kor" page="05" n="29">후ᄃᆡᄒᆞ여 ᄃᆞ리고 잘 잇고 왕ᄂᆡ의 유무ᄒᆞ여라</sent>
<sent type="main" lang="kor" page="05" n="30">ᄑᆞᆯ ᄯᅥ러 겨요 뎍노라</sent> 
<sent type="main" lang="kor" page="05" n="31">ᄉᆞ월 초삼일 모 이 보과 거번 보과 다 올려 보내여라</sent>
<sent type="main" lang="kor" page="05" n="32">네 글이 미거미거ᄒᆞ니</sent><!--'미거미거ᄒᆞ니'에서 뒤에 오는 '미거'는 재점으로 표기되어 있음-->
<sent type="main" lang="kor" page="05" n="33">듀야 ᄆᆞᄋᆞᆷ의 걸려 ᄀᆞᆸᄀᆞᆸ 속이 존다</sent><!--'ᄀᆞᆸᄀᆞᆸ'에서 뒤에 오는 'ᄀᆞᆸ'은 재점으로 표기되어 있음-->
</letter>

<letter n="07" sender="성산이씨(종조모)" writer="성산이씨(종조모)" receiver="미상(손자)" year="1681~1767년*">
<sent type="main" lang="kor" page="07" n="01">츈한의 평안ᄒᆞᆫ 일 알고 든든 깃브나</sent>
<sent type="main" lang="kor" page="07" n="02">우환이 도로 못ᄒᆞ여 ᄯᅩ 피졉 낫다 ᄒᆞ니 ᄌᆞᆨ히 민망 민망ᄒᆞ랴</sent>
<sent type="main" lang="kor" page="07" n="03">념녀 ᄀᆞ이ᄀᆞ이업다</sent><!--'ᄀᆞ이ᄀᆞ이업다'에서 뒤에 오는 'ᄀᆞ이'는 재점으로 표기되어 있음-->
<sent type="main" lang="kor" page="07" n="04">다ᄒᆡᆼ으로 심난ᄒᆞᆷ 닛디 못ᄒᆞ다</sent>
<sent type="main" lang="kor" page="07" n="05">덥니블 엇디ᄒᆞ여 올고</sent>
<sent type="main" lang="kor" page="07" n="06">념녀 층냥업고 혼인은 ᄀᆞ린 날 젹</sent>
<sent type="main" lang="kor" page="07" n="07">그 엇디어 주ᄅᆞ ᄒᆞᆯ디 뒤 심난 뒤 심난ᄒᆞ다</sent>
<sent type="main" lang="kor" page="07" n="08">임대도 아직 잇기 비덧더니</sent>
<sent type="main" lang="kor" page="07" n="09">블의 가니 결연결연 섭기 ᄀᆞ이ᄀᆞ이업다</sent><!--'결연결연'과 ‘ᄀᆞ이ᄀᆞ입업다’에서 뒤에 오는 '결연'과 ‘ᄀᆞ이’는 재점으로 표기되어 있음--> 
<sent type="main" lang="kor" page="07" n="10">눈 감감 감감 겨유 잠</sent><!--'감감 감감'에서 뒤에 오는 '감감'은 재점으로 표기되어 있음--> 
<sent type="main" lang="kor" page="07" n="11">이번은 과거ᄒᆞ기 ᄇᆞ라노라</sent>
<sent type="main" lang="kor" page="07" n="12">념삼 죵조모</sent>
</letter>

<letter n="08" sender="달성서씨(외할머니)" writer="달성서씨(외할머니)" receiver="맹지대(외손자)" year="1750년">
<sent type="main" lang="kor" page="08" n="01">손ᄌᆞ의 답장</sent>
<sent type="main" lang="kor" page="08" n="02">ᄃᆞᆯ포 네 글시도 보지 못ᄒᆞ니 답답 그립더니</sent><!--'답답'에서 뒤에 오는 '답'은 재점으로 표기되어 있음-->
<sent type="main" lang="kor" page="08" n="03">일쳔 오나ᄂᆞᆯ 뎍으니</sent>
<sent type="main" lang="kor" page="08" n="04">보고 반가오나 셩치 못ᄒᆞ여라 ᄒᆞ여시니</sent>
<sent type="main" lang="kor" page="08" n="05">념녀 ᄀᆞ이업다</sent>
<sent type="main" lang="kor" page="08" n="06">나ᄂᆞᆫ 이제도 완인이 못 되여 지내니 괴롭다</sent>
<sent type="main" lang="kor" page="08" n="07">내 사랏다가 네 아ᄃᆞᆯ 낫는 양 볼 줄 어이 아라시리</sent>
<sent type="main" lang="kor" page="08" n="08">도로혀 고이ᄒᆞᆫ ᄃᆞᆺ시브고 긔특긔특ᄒᆞ다</sent><!--'긔특긔특ᄒᆞ다'에서 뒤에 오는 '긔특'은 재점으로 표기되어 있음--> 
<sent type="main" lang="kor" page="08" n="09">너도 네 형과 ᄒᆞᆫ가지로 와</sent>
<sent type="main" lang="kor" page="08" n="10">과거도 보고 죽어 가던 한미도 보고</sent>
<sent type="main" lang="kor" page="08" n="11">아ᄃᆞᆯ도 보고 겸필 와 ᄃᆞᆫ녀가게 ᄒᆞ여라</sent>
<sent type="main" lang="kor" page="08" n="12">ᄉᆞ연 남으나 쉬 올 ᄃᆞᆺᄒᆞ고 어득ᄒᆞ니 긋치며</sent>
<sent type="main" lang="kor" page="08" n="13">됴히 잇다가 오게 ᄒᆞ여라</sent>
<sent type="main" lang="kor" page="08" n="14">삼월 초십일 외조모</sent>
</letter>
(왼쪽 페이지 '조부긔일~'은?)

<letter n="10" sender="전의이씨(어머니)" writer="전의이씨(어머니)" receiver="맹지대(아들)" year="1773~1774년">
<sent type="main" lang="kor" page="10" n="01">주셔 답</sent>
<sent type="main" lang="kor" page="10" n="02">간 후 긔별 모ᄅᆞ니 답답 념이러니</sent><!--'답답'에서 뒤에 오는 '답'은 재점으로 표기되어 있음-->
<sent type="main" lang="kor" page="10" n="03">일로셔 온 편지 바다 긋ᄯᅢ 므ᄉᆞᄒᆞ고</sent> 
<sent type="main" lang="kor" page="10" n="04">길ᄒᆡ도 대단 연고 업시 간 일 다ᄒᆡᆼ 깃브며</sent>
<sent type="main" lang="kor" page="10" n="05">관쥬인 갈 제 편지ᄒᆞ엿더니</sent>
<sent type="main" lang="kor" page="10" n="06">보냐 죵이나 ᄇᆞᆯ셔 보내쟈 ᄒᆞᆫ 거시 일이 되들 아녀</sent>
<sent type="main" lang="kor" page="10" n="07">겨요겨요 이제야 브리며</sent><!--'겨요겨요'에서 뒤에 오는 '겨요'는 재점으로 표기되어 있음--> 
<sent type="main" lang="kor" page="10" n="08">그ᄉᆞ이 ᄀᆡᆨ괴 오ᄌᆞᆨᄒᆞ며</sent>
<sent type="main" lang="kor" page="10" n="09">더위 오시 졀박ᄒᆞᆷ 듀야 브리오지 못ᄒᆞᆯ다</sent>
<sent type="main" lang="kor" page="10" n="10">챵의 겹바지 젹삼 옷거ᄉᆞᆫ ᄒᆞ여 보내며</sent>
<sent type="main" lang="kor" page="10" n="11">젹삼을 겨요ᄒᆞ고 솝거ᄉᆞᆯ 못 ᄒᆞ여 보낼가 ᄒᆞ엿더니</sent>
<sent type="main" lang="kor" page="10" n="12">뵈 잇다 ᄒᆞ기 글노 ᄒᆞ여 보내며</sent>
<sent type="main" lang="kor" page="10" n="13">쇼챵옷 업시ᄂᆞᆫ 챵의 닙기 어려올 거시매</sent>
<sent type="main" lang="kor" page="10" n="14">모시 미처 사든 못ᄒᆞ고</sent>
<sent type="main" lang="kor" page="10" n="15">다시 올가 쟝ᄉᆞᄅᆞᆯ 기ᄃᆞ리나</sent>
<sent type="main" lang="kor" page="10" n="16">긔쳑은 업고 ᄒᆞᆯ 길 업서</sent>
<sent type="main" lang="kor" page="10" n="17">곱동 쇼챵 오ᄉᆞᆯ 몬져 보내니 아직 닙게 ᄒᆞ여라</sent>
<sent type="main" lang="kor" page="10" n="18">죠곰 젹은들 어이ᄒᆞ리</sent>
<sent type="main" lang="kor" page="10" n="19">미조차 쟝ᄉᆞ나 오면사 ᄒᆞ게 ᄒᆞ여시ᄃᆡ</sent>
<sent type="main" lang="kor" page="10" n="20">ᄆᆡᄉᆞ의 갑시 대강 업ᄉᆞ니 답답ᄒᆞ다</sent><!--'답답ᄒᆞ다'에서 뒤에 오는 '답'은 재점으로 표기되어 있음-->
<sent type="main" lang="kor" page="10" n="21">챵의도 이번이 어려올 거신ᄃᆡ 어이ᄒᆞᆯ지 답답ᄒᆞᆫ 일이이로다</sent><!--'답답ᄒᆞᆫ'에서 뒤에 오는 '답'은 재점으로 표기되어 있음-->  
<sent type="main" lang="kor" page="10" n="22">지긔 어ᄂᆞ ᄯᅢ 될고 졔ᄉᆞᄒᆞ고 어려오미 만하 ᄯᆞᆨᄒᆞ며</sent>
<sent type="main" lang="kor" page="10" n="23">나ᄂᆞᆫ 요ᄉᆞ이야 져기 나으ᄃᆡ</sent>
<sent type="main" lang="kor" page="10" n="24">이제도 긔 ᄇᆡ별치 못ᄒᆞ고 아직도 쾌ᄒᆞᆯ 날이 머러시니 ᄎᆞ마 답답ᄒᆞ다</sent><!--'답답ᄒᆞ다'에서 뒤에 오는 '답'은 재점으로 표기되어 있음-->
<sent type="main" lang="kor" page="10" n="25">ᄉᆞ식념 이제야 나 구미 죠곰 나오나</sent>
<sent type="main" lang="kor" page="10" n="26">ᄆᆞ양 먹고 보ᄂᆞᆫ 거ᄉᆞᆫ 지리ᄒᆞ니 ᄯᆞᆨᄒᆞ다</sent>
<sent type="main" lang="kor" page="10" n="27">한ᄌᆡ 참혹ᄒᆞ니 ᄂᆡ두 ᄉᆡᆼ계 난감ᄒᆞᆯ 일 말 아니 나더니</sent>
<sent type="main" lang="kor" page="10" n="28">이제야 이 풍은 ᄒᆞᆯ 만치 의외 비 오니</sent>
<sent type="main" lang="kor" page="10" n="29">농인은 셔두ᄒᆞ여 ᄂᆞᆯ치ᄂᆞᆫ디</sent>
<sent type="main" lang="kor" page="10" n="30">종싀 어즐 요란이 극진ᄒᆞ여 일변 우감 난다</sent> 
<sent type="main" lang="kor" page="10" n="31">ᄉᆞ연이 만만ᄒᆞ더니 다 닛치여 못ᄒᆞ며</sent><!--'만만ᄒᆞ더니'에서 뒤에 오는 '만'은 재점으로 표기되어 있음-->
<sent type="main" lang="kor" page="10" n="32">어ᄂᆞ 긔나 올 ᄃᆞᆺᄒᆞᆫ고 긔나 알게 ᄒᆞ여라</sent>
<sent type="main" lang="kor" page="10" n="33">내 죠곰 나은 후 아ᄒᆡ들이 다 알ᄂᆞᆫᄃᆡ</sent>
<sent type="main" lang="kor" page="10" n="34">온온 사흘을 알ᄂᆞᆫᄃᆡ 대통대통ᄒᆞ더니</sent><!--'대통대통ᄒᆞ더니'에서 뒤에 오는 '대통'은 재점으로 표기되어 있음-->
<sent type="main" lang="kor" page="10" n="35">죠곰 낫들 아니ᄒᆞ던 거시 못 견ᄃᆡ여 ᄒᆞ니 보기 잔잉 ᄀᆞᆸᄀᆞᆸᄒᆞ다</sent><!--'ᄀᆞᆸᄀᆞᆸᄒᆞ다'에서 뒤에 오는 'ᄀᆞᆸ'은 재점으로 표기되어 있음-->  
<sent type="main" lang="kor" page="10" n="36">ᄉᆞ연 지리 그치며 내내 므ᄉᆞᄒᆞ다가 오기ᄅᆞᆯ ᄇᆞ란다</sent><!--'내내'에서 뒤에 오는 '내'는 재점으로 표기되어 있음-->
<sent type="main" lang="kor" page="10" n="37">니집의게 편지 쓰기 어려워 못ᄒᆞᆫ다 닐어라</sent>
<sent type="main" lang="kor" page="10" n="38">십일일 모</sent>
<sent type="main" lang="kor" page="10" n="39">ᄒᆞ며 두 다리ᄅᆞᆯ 알하 굴신을 못 ᄒᆞ고</sent>
<sent type="main" lang="kor" page="10" n="40">듀야 누언 지 닷새 되여 죠곰도 낫든 아니ᄒᆞ고 잠시 안</sent>
</letter>

<letter n="11" sender="전의이씨(어머니나 할머니)" writer="전의이씨(어머니나 할머니)" receiver="미상(아들이나 손자)" year="1730~1774년*">
<sent type="main" lang="kor" page="11" n="01">경부</sent>
<sent type="main" lang="kor" page="11" n="02">그리 ᄯᅥ나가니 허우럭 섭섭ᄒᆞᆫ 듕 엇지들 가ᄂᆞᆫ고 념이며</sent>
<sent type="main" lang="kor" page="11" n="03">오ᄂᆞᆯ 아ᄎᆞᆷ 안개 므셔오니 가ᄂᆞᆫ 길도 그런가 념인다</sent>
<sent type="main" lang="kor" page="11" n="04">아ᄆᆞ려나 이번 과거도 브ᄃᆡ ᄒᆞ고 오게</sent>
<sent type="main" lang="kor" page="11" n="05">ᄒᆞᆷ ᄇᆞ란다 녜 ᄃᆡᆨ 빈혀 간 김 아ᄆᆞ거시나 ᄒᆞ여 주면 죠흘다</sent>
<sent type="main" lang="kor" page="11" n="06">즉금 샹례 혹간 이러타 관겨ᄒᆞ냐</sent>
<sent type="main" lang="kor" page="11" n="07">죠고마ᄒᆞᆫ 거ᄉᆞᆯ 이번 사 보내면 죠흘 ᄃᆞᆺᄒᆞ다</sent>
<sent type="main" lang="kor" page="11" n="08">내내 그ᄉᆞ이 므ᄉᆞ들 ᄒᆞ고</sent><!--'내내'에서 뒤에 오는 '내'는 재점으로 표기되어 있음-->
<sent type="main" lang="kor" page="11" n="09">과거 츌입 평안평안이들 ᄒᆞ기 ᄇᆞ란다</sent>
<sent type="main" lang="kor" page="11" n="10">팔일</sent>
</letter>

<letter n="13" sender="신창맹씨(넷째 고모)" writer="신창맹씨(넷째 고모)" receiver="맹지대(조카)" year="1730~1764년*"> <!--한국학중앙연구원 편(2005a：217)에서는 1764년 이전으로만 추정하였으나 이 판독자료집에서는 편지의 수신자를 맹지대로 판단하였으므로 맹지대(孟至大, 1730~1793)의 생몰년과 편지의 발신자인 맹지대의 넷째 고모(황운하의 처) 신창맹씨(1689~1764)의 생몰년을 고려하여 이 편지의 작성 시기를 1730~1764년으로 추정하였다.-->
<sent type="main" lang="kor" page="13" n="01">봄 일긔 사오나온ᄃᆡ</sent>
<sent type="main" lang="kor" page="13" n="02">뫼와 평안ᄒᆞᆫ 안부 알고 든든 반가옴 ᄀᆞ이업ᄉᆞ되</sent><!--'든든'에서 뒤에 오는 '든'은 재점으로 표기되어 있음-->
<sent type="main" lang="kor" page="13" n="03">겨을의 아ᄒᆡᄅᆞᆯ 굿긴 일 참혹 잔잉ᄒᆞᆷ ᄀᆞ이업ᄉᆞ며</sent>
<sent type="main" lang="kor" page="13" n="04">우리ᄂᆞᆫ 져년 녀ᄅᆞᆷ브터 이ᄯᅢᄀᆞ지 우ᄒᆡᆼ으로 디내고</sent>
<sent type="main" lang="kor" page="13" n="05">나도 셩치 못ᄒᆞ여 디내니 민망ᄒᆞᆷ 어이 다 측냥ᄒᆞ리</sent>
<sent type="main" lang="kor" page="13" n="06">ᄉᆞ연 남으되 총망 잠 내내 뫼와 평안ᄒᆞ여라</sent><!--'내내'에서 뒤에 오는 '내'는 재점으로 표기되어 있음-->
<sent type="main" lang="kor" page="13" n="07">삼촌</sent>
</letter>
(왼쪽 페이지 '텽튝삼월~'은?)

<letter n="15" sender="신창맹씨(다섯째 고모)" writer="신창맹씨(다섯째 고모)" receiver="맹지대(조카)" year="1762~1776년"> <!--한국학중앙연구원 편(2005a：223)에서는 1776년 이전으로만 되어 있으나 이 편지의 발신자인 맹지대(孟至大, 1730~ 1793)의 다섯째 고모 신창맹씨(1690~1776)의 생몰년과 신창맹씨의 남편 서종급(徐宗伋, 1668~1762)의 생몰년을 고려하여 1762~1776년으로 수정하였다.-->
<sent type="main" lang="kor" page="15" n="01">노염이 녜 업ᄉᆞᆫ ᄃᆞᆺᄒᆞ니 어이ᄃᆞᆯ 디내ᄂᆞ니</sent>
<sent type="main" lang="kor" page="15" n="02">나ᄂᆞᆫ 의외 평강이 ᄌᆡ상을 ᄒᆞ니</sent>
<sent type="main" lang="kor" page="15" n="03">신관이 즉시 나기로 그 더위예 급급히 오니</sent><!--'급급히'에서 뒤에 오는 '급'은 재점으로 표기되어 있음-->
<sent type="main" lang="kor" page="15" n="04">어이 측냥을 ᄒᆞ리</sent>
<sent type="main" lang="kor" page="15" n="05">ᄒᆞ마 주글 번ᄒᆞ여 주글 번 살 번 올나오니</sent>
<sent type="main" lang="kor" page="15" n="06">그런 욕이 어이 이시리</sent>
<sent type="main" lang="kor" page="15" n="07">죠ᄒᆡ도 다 바ᄃᆞ면 넉넉ᄒᆞᆯ 거시로ᄃᆡ</sent><!--'넉넉ᄒᆞᆯ'에서 뒤에 오는 '넉'은 재점으로 표기되어 있음-->
<sent type="main" lang="kor" page="15" n="08">글노 돈을 사마 ᄡᅳ니 나ᄆᆞᆫ 거시 업더니</sent>
<sent type="main" lang="kor" page="15" n="09">신관이 이ᄅᆞᆯ 보내여시니</sent>
<sent type="main" lang="kor" page="15" n="10">다ᄅᆞ니 보디 못ᄒᆞ여셔 공ᄌᆔ 죵 와시니 급급 보내며</sent><!--'급급'에서 뒤에 오는 '급'은 재점으로 표기되어 있음-->
<sent type="main" lang="kor" page="15" n="11">열 댱식 가지고 쟉어도 두어라</sent>
<sent type="main" lang="kor" page="15" n="12">열ᄒᆞᆯ날 왓더니 어ᄌᆡ브터 음식도 못 먹고</sent>
<sent type="main" lang="kor" page="15" n="13">십오일 삼촌 미망인</sent>
</letter>

<letter n="16" sender="신창맹씨(다섯째 고모)" writer="신창맹씨(다섯째 고모)" receiver="맹지대(조카)" year="1774년"> <!--한국학중앙연구원 편(2005a：223)에서는 수신자를 서명천(徐命天, 1720~?)으로 추정하였으나 발신자가 자신을 ‘삼촌 미망인’이라 하였고 金一根(1986/1991：176)에서도 맹지대(孟至大, 1730~1793)로 파악하였으므로 이 편지의 수신자를 맹지대로 추정하였다.-->
<sent type="main" lang="kor" page="16" n="01">아ᄋᆞ님 상ᄉᆞᄂᆞᆫ 하 쳔만 의외니</sent>
<sent type="main" lang="kor" page="16" n="02">ᄐᆞᆨᄐᆞᆨ 슬픈 밧 다시 뎍을 말이 업ᄉᆞ며</sent><!--'ᄐᆞᆨᄐᆞᆨ'에서 뒤에 오는 'ᄐᆞᆨ'은 재점으로 표기되어 있음-->
<sent type="main" lang="kor" page="16" n="03">너ᄒᆡ 망극 망극 셜워ᄒᆞᄂᆞᆫ 거동 보ᄂᆞᆫ ᄃᆞᆺ 더옥 슬허ᄒᆞ노라</sent><!--'망극 망극'에서 뒤에 오는 '망극'은 재점으로 표기되어 있음-->
<sent type="main" lang="kor" page="16" n="04">편지나 뎍고 젼위ᄒᆞ여 죵을 브리려 ᄒᆞ엿더니</sent>
<sent type="main" lang="kor" page="16" n="05">신녕셔 인마 와셔 며ᄂᆞ리ᄅᆞᆯ ᄃᆞ려가려 ᄒᆞ매</sent>
<sent type="main" lang="kor" page="16" n="06">관하인만 보내디 못ᄒᆞ여 내 죵을 ᄃᆞ려가기로</sent>
<sent type="main" lang="kor" page="16" n="07">지금 위장을 못 ᄒᆞ고 섭섭 괴알ᄒᆞ며</sent><!--'섭섭'에서 뒤에 오는 '섭'은 재점으로 표기되어 있음-->
<sent type="main" lang="kor" page="16" n="08">나ᄂᆞᆫ 므ᄉᆞ 일 이리 댱슈ᄒᆞ여 ᄒᆡ로 신구ᄒᆞᄃᆡ</sent>
<sent type="main" lang="kor" page="16" n="09">지금 굿디 못ᄒᆞᄂᆞᆫ 일 흉악ᄒᆞᆫ 일 어이 이시리</sent>
<sent type="main" lang="kor" page="16" n="10">ᄂᆞᆷ븟그려 ᄒᆞ노라</sent>
<sent type="main" lang="kor" page="16" n="11">장ᄉᆞᄂᆞᆫ 어ᄂᆞ ᄭᅴ로 디내ᄂᆞ니</sent>
<sent type="main" lang="kor" page="16" n="12">아ᄆᆞ려나 년ᄒᆞ여 부디ᄒᆞᆷ ᄇᆞ라노라</sent>
<sent type="main" lang="kor" page="16" n="13">갑오 삼월 초칠일 삼촌 미망</sent>
</letter>

<letter n="17" sender="신창맹씨(여동생)" writer="신창맹씨(여동생)" receiver="맹지대(오빠)" year="1772년"> <!--한국학중앙연구원 편(2005a：228)에서는 수신자를 서종섭으로 추정하였으나 편지의 작성 시기와 서종섭(徐宗燮, 1680~1734)의 생몰년을 고려할 때 맞지 않는다. 이 판독자료집에서는 발신자가 본인을 ‘동생 미망인’이라 밝히고 있으므로 수신자는 오빠인 맹지대(孟至大, 1730~1793)로 추정하였다.-->
<sent type="main" lang="kor" page="17" n="01">셰후 날이 자고 새여 약약히 칩ᄉᆞ오니</sent><!--'약약히'에서 뒤에 오는 '약'은 재점으로 표기되어 있음-->
<sent type="main" lang="kor" page="17" n="02">거ᄂᆞ리오셔 평안ᄒᆞ오신 문안 아ᄋᆞᆸ고져 ᄒᆞ오며</sent>
<sent type="main" lang="kor" page="17" n="03">겨ᄋᆞᆯ의 족하가 ᄯᆞᆯ의 신녜 미처 오마 ᄒᆞ기로 기ᄃᆞ리더니</sent>
<sent type="main" lang="kor" page="17" n="04">긔쳑 업ᄉᆞ 섭섭ᄒᆞ오며</sent><!--'섭섭ᄒᆞ오며'에서 뒤에 오는 '섭'은 재점으로 표기되어 있음-->
<sent type="main" lang="kor" page="17" n="05">나ᄒᆞᆺᄃᆞ ᄒᆞ나 병을 보아도 ᄂᆡ년을 기ᄃᆞ릴가 시브디 아녀</sent>
<sent type="main" lang="kor" page="17" n="06">이 죵을 보내오나</sent>
<sent type="main" lang="kor" page="17" n="07">첫 길히오 반빙ᄒᆞᆫ ᄃᆞᆺᄒᆞ니 어이 갈고 념이ᄋᆞᆸ</sent>
<sent type="main" lang="kor" page="17" n="08">계유 계유 뎍ᄉᆞ오며</sent><!--'계유 계유'에서 뒤에 오는 '계유'는 재점으로 표기되어 있음-->
<sent type="main" lang="kor" page="17" n="09">츈한의 내내 평안ᄒᆞ오심 ᄇᆞ라ᄋᆞᆸ</sent><!--'내내'에서 뒤에 오는 '내'는 재점으로 표기되어 있음-->
<sent type="main" lang="kor" page="17" n="10">임진 원일 동ᄉᆡᆼ 미망인</sent>
</letter>

<letter n="18" sender="신창맹씨(다섯째 고모)" writer="신창맹씨(다섯째 고모)" receiver="맹지대(조카)" year="1772년">
<sent type="main" lang="kor" page="18" n="01">념 듕 글시 보고 반갑고</sent>
<sent type="main" lang="kor" page="18" n="02">신원의 뫼와 평안ᄒᆞᆫ 안부 알고 깃브기 ᄀᆞ이업다</sent>
<sent type="main" lang="kor" page="18" n="03">신녜 전 오마 ᄒᆞ니 기ᄃᆞ리며</sent>
<sent type="main" lang="kor" page="18" n="04">나ᄂᆞᆫ 병이 괴괴ᄒᆞ여 ᄃᆞᆯ포 지ᄐᆡᆼᄒᆞ기ᄅᆞᆯ 기ᄃᆞ리디 못ᄒᆞ니</sent><!--'괴괴ᄒᆞ여'에서 뒤에 오는 '괴'는 재점으로 표기되어 있음-->
<sent type="main" lang="kor" page="18" n="05">오ᄂᆞᆯ 죽다 인뎨 드을ᄒᆞ니 ᄌᆞᆨᄒᆞ랴마ᄂᆞᆫ</sent>
<sent type="main" lang="kor" page="18" n="06">듀야 알키 민망타</sent>
<sent type="main" lang="kor" page="18" n="07">손ᄌᆞᄅᆞᆯ 보다니 긔특 귀ᄒᆞ기 측냥업ᄉᆞ며</sent>
<sent type="main" lang="kor" page="18" n="08">아ᄃᆞᆯ이 어ᄂᆞ 집의 귀ᄒᆞᆯ 것 아니로ᄃᆡ</sent>
<sent type="main" lang="kor" page="18" n="09">우리 가문의 아ᄃᆞᆯ 더옥 ᄂᆞ믜 업시 귀ᄒᆞ다</sent>
<sent type="main" lang="kor" page="18" n="10">졍과를 ᄒᆞ여 노코 보낼 길 업서</sent>
<sent type="main" lang="kor" page="18" n="11">아젹 연듁 먹은 ᄃᆞᆺᄒᆞᆫ 죵을 보내엿더니</sent>
<sent type="main" lang="kor" page="18" n="12">이 죵 올 줄 모ᄅᆞᆫ 줄 애ᄃᆞᆲ다</sent>
<sent type="main" lang="kor" page="18" n="13">ᄉᆞ연 어득 계유 뎍으며 내내 무양ᄒᆞᆷ ᄇᆞ라노라</sent><!--'내내'에서 뒤에 오는 '내'는 재점으로 표기되어 있음-->
<sent type="main" lang="kor" page="18" n="14">임진 원월 십오일 삼촌 미망인</sent>
</letter>

<letter n="20" sender="신창맹씨(다섯째 고모)" writer="신창맹씨(다섯째 고모)" receiver="맹지대(조카)" year="1769년">
<sent type="main" lang="kor" page="20" n="01">온 녀ᄅᆞᆷ ᄀᆞ으내 긔별을 모ᄅᆞ니</sent>
<sent type="main" lang="kor" page="20" n="02">답답 섭섭기 ᄀᆞ이업ᄉᆞ나</sent><!--'답답'과 ‘섭섭기’에서 뒤에 오는 '답'과 ‘섭’은 재점으로 표기되어 있음-->
<sent type="main" lang="kor" page="20" n="03">우환의 골몰ᄒᆞ고 노패ᄒᆞ기 날노 심ᄒᆞ야</sent>
<sent type="main" lang="kor" page="20" n="04">편지 ᄡᅳᆯ 길히 업서 지금 쳔연ᄒᆞ니</sent>
<sent type="main" lang="kor" page="20" n="05">못 닛ᄂᆞᆫ 보람도 업고 졍의 범연ᄒᆞᆫ ᄃᆞᆺ 어ᄂᆞ ᄯᆡ 니ᄌᆞ리</sent>
<sent type="main" lang="kor" page="20" n="06">나ᄂᆞᆫ 아기놈이 병이 듕ᄒᆞ야 근위 깁ᄒᆞ니</sent>
<sent type="main" lang="kor" page="20" n="07">수이 ᄒᆞ리기도 어렵고</sent>
<sent type="main" lang="kor" page="20" n="08">아마도 죵신지진이 된가 ᄀᆞᆸᄀᆞᆸ 잔잉ᄒᆞ고</sent><!--'ᄀᆞᆸᄀᆞᆸ'에서 뒤에 오는 'ᄀᆞᆸ'은 재점으로 표기되어 있음-->
<sent type="main" lang="kor" page="20" n="09">녀ᄅᆞᆷ ᄀᆞ으내 뉴 업ᄉᆞᆫ 가난의 지쳐</sent>
<sent type="main" lang="kor" page="20" n="10">아마도 오래 못 살리</sent>
<sent type="main" lang="kor" page="20" n="11">ᄆᆞᆺ족하 북ᄇᆡᆨ이 의외 상츌ᄒᆞ니</sent>
<sent type="main" lang="kor" page="20" n="12">가운이 망극ᄒᆞ고 ᄉᆞᄉᆞ 참달ᄒᆞ니</sent><!--'ᄉᆞᄉᆞ'에서 뒤에 오는 'ᄉᆞ'는 재점으로 표기되어 있음-->
<sent type="main" lang="kor" page="20" n="13">늙거야 이런 일 어ᄃᆡ 이시리</sent>
<sent type="main" lang="kor" page="20" n="14">날과 못 밧곤 줄 애ᄃᆞᆲ고 셟다</sent>
<sent type="main" lang="kor" page="20" n="15">올 츄슈ᄂᆞᆫ 실긔 아니ᄒᆞ냐</sent>
<sent type="main" lang="kor" page="20" n="16">조부모 쳔장은 엇디 디ᄂᆡ온고</sent>
<sent type="main" lang="kor" page="20" n="17">먼니셔 간 삭고 슬프고 너 근노ᄒᆞᆫ 일 못 닛노라</sent>
<sent type="main" lang="kor" page="20" n="18">ᄋᆞ쇼 우환은 업ᄂᆞ냐</sent>
<sent type="main" lang="kor" page="20" n="19">녀ᄅᆞᆷ의 졀션 어더거ᄂᆞᆯ</sent>
<sent type="main" lang="kor" page="20" n="20">너 오기로 ᄂᆞᆺᄎᆞ로 주랴 ᄒᆞ얏더니</sent>
<sent type="main" lang="kor" page="20" n="21">긔쳑 업ᄉᆞ니 편지 ᄡᅥ 보내고져 ᄒᆞ나</sent>
<sent type="main" lang="kor" page="20" n="22">실노 편지 ᄡᅳ기 어려워 못 보내더니</sent>
<sent type="main" lang="kor" page="20" n="23">ᄒᆡ 묵거 되니 보ᄂᆡ니 우ᄉᆞᆸ고</sent>
<sent type="main" lang="kor" page="20" n="24">너도 우이 너길 일 보ᄂᆞᆫ ᄃᆞᆺᄒᆞ다</sent>
<sent type="main" lang="kor" page="20" n="25">올노ᄂᆞᆫ 못 올 거시니 다시 못 볼가 ᄆᆞᄋᆞᆷ 굿브다</sent>
<sent type="main" lang="kor" page="20" n="26">ᄉᆞ연 ᄀᆞᄃᆞᆨᄒᆞ나 총총</sent><!--'총총'에서 뒤에 오는 '총'은 재점으로 표기되어 있음--> 
<sent type="main" lang="kor" page="20" n="27">겨요 뎍노라 내내 뫼ᄋᆞᆸ고 거ᄂᆞ려</sent><!--'내내'에서 뒤에 오는 '내'는 재점으로 표기되어 있음-->
<sent type="main" lang="kor" page="20" n="28">편안 편안ᄒᆞ기 ᄇᆞ라노라</sent><!--'편안 편안하기'에서 뒤에 오는 '편안'은 재점으로 표기되어 있음-->
<sent type="main" lang="kor" page="20" n="29">긔튝 십월 념일일 삼촌 미망인</sent>
</letter>

<letter n="25" sender="달성서씨(아랫동서)" writer="달성서씨(아랫동서)" receiver="밀양박씨(윗동서)" year="1758년">
<sent type="main" lang="kor" page="25" n="01">문안 알외ᄋᆞᆸ고 일긔 어즈럽ᄉᆞ온ᄃᆡ</sent>
<sent type="main" lang="kor" page="25" n="02">긔운 엇더ᄒᆞ오신 문안 아ᄋᆞᆸ고져 ᄇᆞ라오며</sent>
<sent type="main" lang="kor" page="25" n="03">셰환ᄒᆞ와 ᄃᆞᆯ포 문안 모ᄅᆞ오니</sent>
<sent type="main" lang="kor" page="25" n="04">하졍의 섭섭 복념 아ᄆᆞ라타 업ᄉᆞ와 ᄒᆞᄋᆞᆸᄂᆞ이다</sent><!--'섭섭'에서 뒤에 오는 '섭'은 재점으로 표기되어 있음-->
<sent type="main" lang="kor" page="25" n="05">아ᄒᆡ들도 다 죠히 잇ᄉᆞᆸᄂᆞ이잇가</sent>
<sent type="main" lang="kor" page="25" n="06">싀골은 역질이 흔타 ᄒᆞ오니 념녀 브리ᄋᆞᆸ디 못ᄒᆞ와 ᄒᆞᄋᆞᆸᄂᆞ이다</sent>
<sent type="main" lang="kor" page="25" n="07">알외올 말ᄉᆞᆷ 감ᄒᆞ오심 지번ᄒᆞ와</sent>
<sent type="main" lang="kor" page="25" n="08">이만 알외오며 내내 긔후 평안ᄒᆞᄋᆞᆸ심 ᄇᆞ라ᄋᆞᆸᄂᆞ이다</sent><!--'내내'에서 뒤에 오는 '내'는 재점으로 표기되어 있음-->
<sent type="main" lang="kor" page="25" n="09">무인 이월 념이일 뎨 셔 샹셔</sent>
</letter>
(왼쪽 페이지 한문은?)

<letter n="26" sender="연안김씨(어머니)" writer="연안김씨(어머니)" receiver="맹심원(아들)" year="1755~1764년">
<sent type="main" lang="kor" page="26" n="01">ᄉᆞ람 올 적 ᄃᆞᆯ포 만의 글시 보고 반갑기 ᄀᆞ이업고</sent>
<sent type="main" lang="kor" page="26" n="02">새ᄒᆡ예 됴히 이시니 깃브기 ᄀᆞ이업다</sent>
<sent type="main" lang="kor" page="26" n="03">그후 긔별 모ᄅᆞ니 엇디 잇ᄂᆞᆫ다</sent>
<sent type="main" lang="kor" page="26" n="04">글이나 탹실히 닑어라</sent>
<sent type="main" lang="kor" page="26" n="05">네 덜 나ᄃᆞᆫ닌다 ᄒᆞ여 겨시니</sent>
<sent type="main" lang="kor" page="26" n="06">ᄆᆞᄋᆞᆷ을 잡으면 ᄌᆞᆨ히 깃브랴</sent>
<sent type="main" lang="kor" page="26" n="07">예ᄂᆞᆫ 무ᄉᆞᄒᆞ니 깃브다</sent>
<sent type="main" lang="kor" page="26" n="08">아모커나 쉬이 볼 거시니</sent>
<sent type="main" lang="kor" page="26" n="09">내내 그ᄉᆞ이 됴히 됴히 이시믈 ᄇᆞ라노라</sent><!--‘내내’와 '됴히 됴히'에서 뒤에 오는 ‘내’와 '됴히'는 재점으로 표기되어 있음-->
<sent type="main" lang="kor" page="26" n="10">십삼일 모</sent>
</letter>

<letter n="27" sender="연안김씨(어머니)" writer="연안김씨(어머니)" receiver="맹심원(아들)" year="1750~1764년">
<sent type="main" lang="kor" page="27" n="01">경린이</sent>
<sent type="main" lang="kor" page="27" n="02">아현 죵 오ᄂᆞᆫᄃᆡ 긔별 드ᄅᆞ니 든든ᄒᆞ나</sent><!--'든든ᄒᆞ나'에서 뒤에 오는 '든'은 재점으로 표기되어 있음-->
<sent type="main" lang="kor" page="27" n="03">네 귀 밋ᄐᆡ 도든 거시 그ᄉᆞ이 엇더ᄒᆞᆫ고 념녀 측냥업다</sent>
<sent type="main" lang="kor" page="27" n="04">네 옷 주패 보ᄂᆞᆫ ᄃᆞᆺ 념녀 노히디 아니ᄒᆞᆫ다</sent>
<sent type="main" lang="kor" page="27" n="05">브ᄃᆡ 나ᄃᆞᆫ니디 말고 조심ᄒᆞ여라</sent>
<sent type="main" lang="kor" page="27" n="06">우희 죵이 간다 ᄒᆞ니 편지 ᄡᅥ 보내랴 ᄒᆞ더니</sent>
<sent type="main" lang="kor" page="27" n="07">못 가니 이제야 보낸다</sent>
<sent type="main" lang="kor" page="27" n="08">셰젼 죵 보내마</sent>
<sent type="main" lang="kor" page="27" n="09">ᄉᆞ연 다 못 ᄒᆞ노라</sent>
<sent type="main" lang="kor" page="27" n="10">십이일</sent>
</letter>

<letter n="28" sender="전주이씨(어머니)" writer="전주이씨(어머니)" receiver="맹흠구(아들)" year="1815~1843년"> <!-- 편지 여백에 ‘先妣 恭人 全州李氏 手蹟 先妣 戊戌生 癸卯卒 享年 六十六’이라고 적은 맹지대(孟至大, 1730~1793)의 부기(附記)가 있다.-->
<sent type="main" lang="kor" page="28" n="01">아ᄃᆞᆯ의 답</sent>
<sent type="main" lang="kor" page="28" n="02">쳔득 편 글시 보고 반갑기 측냥업ᄉᆞ며</sent>
<sent type="main" lang="kor" page="28" n="03">길ᄒᆡ 무ᄉᆞ이 드러간 일 긔특ᄒᆞ며</sent>
<sent type="main" lang="kor" page="28" n="04">너을 ᄯᅦ쳐 보내고 집이 다 븬 ᄃᆞᆺ</sent>
<sent type="main" lang="kor" page="28" n="05">허우럭 날포 되니 암암 그립기 ᄀᆞᆫ졀ᄒᆞ나</sent><!--'암암'에서 뒤에 오는 '암'은 재점으로 표기되어 있음-->
<sent type="main" lang="kor" page="28" n="06">네 공부ᄅᆞᆯ 위ᄒᆞ여 둘 거시니</sent>
<sent type="main" lang="kor" page="28" n="07">브ᄃᆡ 노지 말고 착실이 ᄒᆞ고 쟉난 말아</sent>
<sent type="main" lang="kor" page="28" n="08">일ᄉᆡᆼ 처엄으로 부모을 ᄯᅥ나 잇시니</sent>
<sent type="main" lang="kor" page="28" n="09">못 잇치고 미거ᄒᆞᆫ 거동을 ᄒᆞᆯ가 념녀롭다</sent>
<sent type="main" lang="kor" page="28" n="10">현암 동ᄂᆡ 블안ᄒᆞ다 ᄒᆞ니 가지 말고</sent>
<sent type="main" lang="kor" page="28" n="11">누의 올 젹 길ᄒᆡ 주막의셔 잠간 만나 보고 즉시 ᄯᅥ나게 ᄒᆞ여라</sent>
<sent type="main" lang="kor" page="28" n="12">망회간 인마을 보내라 ᄒᆞ더니</sent>
<sent type="main" lang="kor" page="28" n="13">동ᄂᆡ 블안ᄒᆞ니 초ᄉᆡᆼ 보내라 ᄒᆞ기 초팔일 보낸다마ᄂᆞᆫ</sent>
<sent type="main" lang="kor" page="28" n="14">죵도 업고 ᄇᆡᄒᆡᆼ도 업고 엇디 올 념녀롭다</sent>
<sent type="main" lang="kor" page="28" n="15">년산 올 젹 ᄃᆞᆫ녀오게 ᄒᆞ여라</sent>
<sent type="main" lang="kor" page="28" n="16">일ᄒᆡᆼ 올 젹 브ᄃᆡ 쥬인 ᄃᆡᆨ의 폐 되지 아니케 ᄒᆞ여라</sent>
<sent type="main" lang="kor" page="28" n="17">ᄒᆞᆯ ᄂᆡ 올 거시니 잠간 보고 죠곰도 지체 말게 ᄒᆞ여라</sent>
<sent type="main" lang="kor" page="28" n="18">춍급 ᄉᆞ연 다 못 ᄒᆞ니</sent>
<sent type="main" lang="kor" page="28" n="19">내내 공부 착실이 ᄒᆞ고 무양ᄒᆞ기 ᄇᆞ란다</sent><!--'내내'에서 뒤에 오는 '내'는 재점으로 표기되어 있음-->
<sent type="main" lang="kor" page="28" n="20">즉일 모</sent>
</letter>

<letter n="29" sender="전주이씨(어머니)" writer="전주이씨(어머니)" receiver="맹흠구(아들)" year="1815~1843년">
<sent type="main" lang="kor" page="29" n="01">아ᄃᆞᆯ의게</sent>
<sent type="main" lang="kor" page="29" n="02">무망의 죵</sent>
<sent type="main" lang="kor" page="29" n="03">오ᄂᆞᆯ 네 글시ᄂᆞᆫ 못 보니 섭섭ᄒᆞ나</sent><!--'섭섭ᄒᆞ나'에서 뒤에 오는 '섭'은 재점으로 표기되어 있음--> 
<sent type="main" lang="kor" page="29" n="04">심한 극한의 년일 무양ᄒᆞᆫ 일 다ᄒᆡᆼᄒᆞ며</sent>
<sent type="main" lang="kor" page="29" n="05">거번 너의 아바님겨오셔 흉ᄒᆞᆫ 일긔예 회환 안녕이 ᄒᆞ오시니 다ᄒᆡᆼᄒᆞ고</sent>
<sent type="main" lang="kor" page="29" n="06">겸ᄒᆞ여 글시 보고 더옥 반갑기 측냥업ᄉᆞ나</sent>
<sent type="main" lang="kor" page="29" n="07">뎡집 모ᄌᆞ을 보내니</sent>
<sent type="main" lang="kor" page="29" n="08">허우럭ᄒᆞ기ᄂᆞᆫ 니ᄅᆞ도 말고</sent>
<sent type="main" lang="kor" page="29" n="09">학슈 거동 날포 될ᄉᆞ록 눈의 발펴 못 견ᄃᆡ게시나</sent>
<sent type="main" lang="kor" page="29" n="10">이런 치위을 당ᄒᆞ여 엇디 견ᄃᆡᄂᆞᆫ고</sent>
<sent type="main" lang="kor" page="29" n="11">ᄎᆞᆷ아 블샹ᄒᆞ다</sent>
<sent type="main" lang="kor" page="29" n="12">너도 업ᄉᆞ니 더옥 집이 다 븬 ᄃᆞᆺ 심난ᄒᆞ다</sent>
<sent type="main" lang="kor" page="29" n="13">요ᄉᆞ이ᄂᆞᆫ 안질 쾌히 낫지 못ᄒᆞ다 ᄒᆞ니 어이 그러ᄒᆞᆫ고</sent>
<sent type="main" lang="kor" page="29" n="14">심난 념녀 노이지 아니ᄒᆞᆫ다</sent>
<sent type="main" lang="kor" page="29" n="15">그러ᄐᆞᆺ 공부도 착실이 못ᄒᆞᄂᆞᆫ가 시브니 민망ᄒᆞ다</sent>
<sent type="main" lang="kor" page="29" n="16">념후나 오랴ᄂᆞ냐</sent>
<sent type="main" lang="kor" page="29" n="17">예ᄂᆞᆫ 요ᄉᆞ이 감긔로 다 공극ᄒᆞ니 ᄀᆞ열ᄒᆞ다</sent>
<sent type="main" lang="kor" page="29" n="18">ᄉᆞ연 가득ᄒᆞ나 어득 심난 이만 긋친다</sent>
<sent type="main" lang="kor" page="29" n="19">ᄉᆞ연 션후 업ᄉᆞ나</sent>
<sent type="main" lang="kor" page="29" n="20">십ᄉᆞ일 졔ᄉᆞ니 ᄒᆞ 모양 업시 디내오니 더옥 한심ᄒᆞ다</sent>
<sent type="main" lang="kor" page="29" n="21">너도 업고 두루 심난ᄒᆞ다</sent>
<sent type="main" lang="kor" page="29" n="22">내내 무양ᄒᆞ다 수이 오기 ᄇᆞ란다</sent><!--'내내'에서 뒤에 오는 '내'는 재점으로 표기되어 있음-->
<sent type="main" lang="kor" page="29" n="23">즉일 모</sent>
</letter> 

<letter n="30" sender="전주이씨(어머니)" writer="전주이씨(어머니)" receiver="맹흠구(아들)" year="1815~1843년">
<sent type="main" lang="kor" page="30" n="01">아기 부 답</sent>
<sent type="main" lang="kor" page="30" n="02">글시 보고 반기며</sent>
<sent type="main" lang="kor" page="30" n="03">거번 그 치위예 엇지 가ᄂᆞᆫ 념녀 노이지 못ᄒᆞ더니</sent>
<sent type="main" lang="kor" page="30" n="04">셩ᄒᆞᆫ가 시브니 다ᄒᆡᆼᄒᆞ다</sent>
<sent type="main" lang="kor" page="30" n="05">졔갑은 어제 읍ᄂᆡ 가 단녀</sent>
<sent type="main" lang="kor" page="30" n="06">오ᄂᆞᆯ 형셰 오며 ᄇᆞ로 가노라 하직ᄒᆞ고 가니</sent>
<sent type="main" lang="kor" page="30" n="07">이 치위예 엇지 갈고 블샹 아연ᄒᆞ다</sent>
<sent type="main" lang="kor" page="30" n="08">너 못 보고 가니 섭섭ᄒᆞ다더라</sent><!--'섭섭ᄒᆞ다더라'에서 뒤에 오는 '섭'은 재점으로 표기되어 있음--> 
<sent type="main" lang="kor" page="30" n="09">담ᄇᆡ쟝은 보내나 다른 반찬도 못 ᄒᆞ여 보내니 ᄯᅡᆨᄒᆞ다</sent>
<sent type="main" lang="kor" page="30" n="10">눈은 죠곰 낫다</sent>
<sent type="main" lang="kor" page="30" n="11">즉일 모</sent>
</letter>

<letter n="31" sender="전주이씨(어머니)" writer="전주이씨(어머니)" receiver="맹흠구(아들)" year="1815~1843년">
<sent type="main" lang="kor" page="31" n="01">아ᄒᆡ 보아라</sent>
<sent type="main" lang="kor" page="31" n="02">거번 가던 날 죵일 비ᄅᆞᆯ 맛고 갓다 ᄒᆞ니 오ᄌᆞᆨᄒᆞ여시며</sent>
<sent type="main" lang="kor" page="31" n="03">오기ᄅᆞᆯ 기ᄃᆞ려더니 아니 오니 념녀 측냥업더니</sent>
<sent type="main" lang="kor" page="31" n="04">너의 쳐남 병환 긔별 드ᄅᆞ니</sent>
<sent type="main" lang="kor" page="31" n="05">그런 놀나온 념녀 어이 다 뎍으리</sent>
<sent type="main" lang="kor" page="31" n="06">사돈겨오셔 오ᄌᆞᆨ 심녀ᄒᆞ오시랴</sent>
<sent type="main" lang="kor" page="31" n="07">그ᄉᆞ이 죠곰 나으며 미음이나 ᄌᆞ시ᄂᆞ냐 ᄒᆞ□</sent>
</letter>

<letter n="32" sender="전주이씨(어머니)" writer="전주이씨(어머니)" receiver="맹흠구(아들)" year="1815~1843년">
<sent type="main" lang="kor" page="32" n="01">아기 부 답</sent>
<sent type="main" lang="kor" page="32" n="02">거번 글시ᄂᆞᆫ ᄌᆞ시 보고 탐탐 반갑기 측냥업ᄉᆞ며</sent><!--'탐탐'에서 뒤에 오는 '탐'은 재점으로 표기되어 있음-->
<sent type="main" lang="kor" page="32" n="03">요ᄉᆞ이ᄂᆞᆫ 체증 낫다 ᄒᆞ니 ᄆᆞᄋᆞᆷ이 죠곰 노이고</sent>
<sent type="main" lang="kor" page="32" n="04">경지년 모셩이 잇시니 깃브다</sent>
<sent type="main" lang="kor" page="32" n="05">대흥 긔별 드ᄅᆞ니 녕질 병 낫다 ᄒᆞ오니 긔특ᄒᆞ다</sent>
<sent type="main" lang="kor" page="32" n="06">샹 승지ᄂᆞᆫ 상ᄉᆞ 나시다 ᄒᆞ니 참혹ᄒᆞ나</sent>
<sent type="main" lang="kor" page="32" n="07">거번 드ᄅᆞ니 구슬 놈이 병 만븐 위즁ᄒᆞ다 ᄒᆞ니</sent>
<sent type="main" lang="kor" page="32" n="08">놀납고 블샹ᄒᆞ고</sent>
<sent type="main" lang="kor" page="32" n="09">며ᄂᆞ리 ᄒᆞ 걱졍ᄒᆞ니 심난ᄒᆞ다</sent>
<sent type="main" lang="kor" page="32" n="10">냥식은 두 말 보낸다</sent>
<sent type="main" lang="kor" page="32" n="11">십삼 일즉 오게 ᄒᆞ여라</sent>
<sent type="main" lang="kor" page="32" n="12">아기ᄂᆞᆫ 두통 요ᄉᆞ이ᄂᆞᆫ 죠곰 낫다</sent>
<sent type="main" lang="kor" page="32" n="13">즉일 모</sent>
</letter>
</doc>

