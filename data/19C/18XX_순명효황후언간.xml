<img n="추가01">https://kohico.kr/_media/image/19C_순명효황후언간/추가01.jpg</img>
<letter n="추가01" sender="순명효황후(세자빈)" writer="순명효황후(세자빈)" receiver="김상덕(세자의 스승)" year="1894년">
<sent type="main" lang="kor" page="추가01" n="1">평일 존명만 듯ᄉᆞᆸ고 셔신 ᄒᆞᆫ 슌 못 ᄒᆞ와ᄉᆞᆸ더니</sent>
<sent type="main" lang="kor" page="추가01" n="2">오ᄂᆞᆯᄂᆞᆯ 긴히 부치올 일이 잇ᄉᆞ와 ᄇᆡᆨ 번 밋ᄉᆞᆸ고 이 말ᄉᆞᆷ이오며</sent>
<sent type="main" lang="kor" page="추가01" n="3">일면부디오니 셔신 브치ᄂᆞᆫ 것도 녜 아니오 옛 사람의긔 죄오나</sent>
<sent type="main" lang="kor" page="추가01" n="4">젼일 밋기을 송현 외슉의 ᄋᆞᄅᆡ 아니오</sent>
<sent type="main" lang="kor" page="추가01" n="5">ᄯᅩ 영감이 나을 엇디 아셔ᄂᆞᆫ지 그ᄂᆞᆫ 모르오나</sent>
<sent type="main" lang="kor" page="추가01" n="7">나ᄂᆞᆫ 유하의 남의 업시</sent>
<sent type="main" lang="kor" page="추가01" n="8">디통을 품은 무부모형뎨ᄒᆞᆫ 혈혈단신이 겸ᄒᆞ여</sent><!--‘혈혈단신’의 뒤에 오는 ‘혈’은 재점으로 표기돼 있음-->
<sent type="main" lang="kor" page="추가01" n="9">ᄉᆞ고무친이 쥬야 앙텬 탄식이더니</sent>
<sent type="main" lang="kor" page="추가01" n="10">영감 션셩을 듯고 </sent>
<sent type="main" lang="kor" page="추가01" n="11">일가의 감치 아닌 졍이 ᄉᆡᆼ뎐 변치 아니키을 긔약ᄒᆞ더니</sent>
<sent type="main" lang="kor" page="추가01" n="12">명되 박ᄒᆞ고 ᄯᆡ을 못 만나</sent>
<sent type="main" lang="kor" page="추가01" n="13">일됴의 국가의 망극ᄒᆞ온 거시 이 지경 되오니</sent>
<sent type="main" lang="kor" page="추가01" n="14">다시 무ᄉᆞᆫ 말 ᄒᆞᆯ 말ᄉᆞᆷ이 업ᄉᆞ오며</sent>
<sent type="main" lang="kor" page="추가01" n="15">기시의 망극ᄒᆞ옴과 긔구ᄒᆞ오미 엇디 지금 사라 잇다가</sent>
<sent type="main" lang="kor" page="추가01" n="16">올너오시ᄂᆞᆫ 말ᄉᆞᆷ 드를 줄 알어ᄀᆡᄉᆞᆸᄂᆞ잇가</sent>
<sent type="main" lang="kor" page="추가01" n="17">ᄂᆡ 말ᄉᆞᆷ은 통곡ᄒᆞ올 일이거니와</sent>
<sent type="main" lang="kor" page="추가01" n="18">ᄃᆡ져 인쳔 갓ᄉᆞ온 분운ᄒᆞᆫ 험지의 일 업시 겨오시다</sent>
<sent type="main" lang="kor" page="추가01" n="19">올너오신 일 만분 다ᄒᆡᆼᄒᆞ오며 이 말ᄉᆞᆷ ᄒᆞᄋᆞᆸ기 ᄇᆡᆨ 번 난안 슈괴오나</sent>
<sent type="main" lang="kor" page="추가01" n="20">도시 ᄉᆞ셰가 소소 허믈을 ᄉᆡᆼ각ᄒᆞ옵다가</sent><!--'소소'의 뒤에 오는 ‘소’은 재점으로 표기되어 있음.-->
<sent type="main" lang="kor" page="추가01" n="21">긔회을 노치오면 어ᄂᆞ ᄯᆡ을 ᄇᆞ라오며</sent>
<sent type="main" lang="kor" page="추가01" n="22">논변의 방황ᄒᆞᆯ 졔 누을 잡고 말ᄉᆞᆷᄒᆞ오릿가</sent>
<sent type="main" lang="kor" page="추가01" n="23">ᄉᆡᆼ각다 못 긔별ᄒᆞ오니</sent>
<sent type="main" lang="kor" page="추가01" n="24">유모 말ᄉᆞᆷᄒᆞ옵는 것슨 영감 읍의ᄂᆞᆫ 구ᄒᆞ실 수 잇ᄉᆞ올 터이니</sent>
<sent type="main" lang="kor" page="추가01" n="25">만일 신쳥치 아니시면 더옥 븟그려 죽을 터이오니 심냥ᄒᆞ옵소셔</sent>
<sent type="main" lang="kor" page="추가01" n="26">ᄇᆡᆨ이ᄉᆞ디ᄒᆞ와도 이 밧긔 업ᄉᆞ옵ᄂᆞ이다</sent>
</letter>

<img n="10">https://kohico.kr/_media/image/19C_순명효황후언간/10.jpg</img>
<letter n="10" sender="순명효황후(세자빈)" writer="순명효황후(세자빈)" receiver="김상덕(세자의 스승)" year="1894~1897년">
<sent type="main" lang="kor" page="10" n="1">규리 소찰이 비례온 줄 지긔ᄒᆞ나</sent>
<sent type="main" lang="kor" page="10" n="2">지금 당ᄒᆞᆫ 바가 셰부득이오</sent>
<sent type="main" lang="kor" page="10" n="3">ᄯᅩ 평일 지친의 감치 아니튼 일노 다시 향니 임별ᄒᆞ오ᄆᆡ 슈ᄌᆞ 뎍ᄉᆞ오며</sent>
<sent type="main" lang="kor" page="10" n="4">나의 비고ᄒᆞᆫ 일ᄉᆞᄂᆞᆫ 임의 명명이 아시거니와</sent><!--'명명이'의 뒤에 오는 ‘명’은 재점으로 표기되어 있음.-->
<sent type="main" lang="kor" page="10" n="5">혈혈지신이 다시 지통을 픔어</sent>
<sent type="main" lang="kor" page="10" n="6">ᄉᆡᆼ셰지념이 ᄉᆞ연ᄒᆞ고 고초 듕 향인ᄒᆞ여 난홀 곳이 업ᄉᆞᆸ더니</sent>
<sent type="main" lang="kor" page="10" n="7">지금 당ᄒᆞ여 더옥 일신 쥬변이 여림박빙이나</sent>
<sent type="main" lang="kor" page="10" n="8">외간 ᄉᆞ뎍은 더옥 머러 유명이 격ᄒᆞᆫ 듯ᄒᆞᆫ 듕</sent>
<sent type="main" lang="kor" page="10" n="9">올너와 겨신 후ᄂᆞᆫ 슈심을 펴올가 ᄒᆞ엿더니</sent>
<sent type="main" lang="kor" page="10" n="10">향니로 가신다니 ᄉᆞ뎡이 결연ᄒᆞ오며</sent>
<sent type="main" lang="kor" page="10" n="11">고셔을 박남치 못ᄒᆞ여ᄉᆞ나 약간 ᄉᆞ긔을 본즉</sent>
<sent type="main" lang="kor" page="10" n="12">어진 명신은 벼ᄉᆞᆯ을 ᄇᆞ리고 ᄌᆞ최을 감초아 </sent>
<sent type="main" lang="kor" page="10" n="13">탁난ᄒᆞᆫ 셰계을 참녜치 안ᄂᆞᆫ다 ᄒᆞᄂᆞᆫ</sent> 
<sent type="main" lang="kor" page="10" n="14">난ᄃᆡ을 당ᄒᆞ여ᄂᆞᆫ 격분 강ᄀᆡᄒᆞ더니</sent>
<sent type="main" lang="kor" page="10" n="15">오ᄂᆞᆯᄂᆞᆯ 목젼의 당ᄒᆞᆯ 줄 알ᄀᆡᄉᆞᆸᄂᆞ잇가</sent><!--'오ᄂᆞᆯᄂᆞᆯ'의 뒤에 오는 ‘ᄂᆞᆯ’은 재점으로 표기되어 있음.-->
<sent type="main" lang="kor" page="10" n="16">왕도을 ᄇᆞ리시고 향니로 가시ᄆᆡ</sent>
<sent type="main" lang="kor" page="10" n="17">격졀ᄒᆞ온 듕 심의 운건 쳥졍ᄒᆞᆫ 거ᄉᆞᆯ 못 보시고</sent>
<sent type="main" lang="kor" page="10" n="18">군상이 이뎍의 긔슈 우듕 쳐ᄒᆞ신 터의 ᄯᅥᄂᆞ시ᄂᆞᆫ 졍ᄉᆡ 창앙ᄒᆞ시려니와</sent>
<sent type="main" lang="kor" page="10" n="19">신ᄌᆞ 직분ᄲᅮᆫ이려니와</sent>
<sent type="main" lang="kor" page="10" n="20">이곳 난쳐ᄒᆞ고 망극ᄒᆞᆫ ᄉᆞ졍과 ᄂᆡ도ᄒᆞ온 듕</sent> 
<sent type="main" lang="kor" page="10" n="21">지극 슬프기ᄂᆞᆫ 혹ᄌᆞ 부견쳔일ᄒᆞ면 녯말ᄒᆞ고</sent>
<sent type="main" lang="kor" page="10" n="22">이곳 ᄉᆞ심을 펴와 나의긔 안면지인마다 갑기을 계교ᄒᆞ더니</sent>
<sent type="main" lang="kor" page="10" n="23">ᄉᆞ셰지ᄎᆞᄒᆞ와 보고 듯ᄂᆞᆫ 거시 다 심신이 비월ᄒᆞ고 통곡쳐이오</sent>
<sent type="main" lang="kor" page="10" n="24">인인마다 퇴귀을 작뎡ᄒᆞ니 한심심ᄒᆞ고 시졀과 명도을 탄식이오니</sent><!--'인인마다', '한심심ᄒᆞ고'의 뒤에 오는 ‘인’과 '심'은 재점으로 표기되어 있음.-->
<sent type="main" lang="kor" page="10" n="25">부ᄃᆡ부ᄃᆡ 하향 무ᄉᆞᄒᆞ시고</sent><!--'부ᄃᆡ부ᄃᆡ'의 뒤에 오는 ‘부ᄃᆡ’는 재점으로 표기되어 있음.--> 
<sent type="main" lang="kor" page="10" n="26">먼니 겨시나 일년의 ᄒᆞᆫ 번식이나 신을 ᄭᅳᆺ지 마시면 튱의오</sent>
<sent type="main" lang="kor" page="10" n="27">나도 신의니 익이 심양심양ᄒᆞ옵소셔 </sent><!--'심양심양ᄒᆞ옵소셔'의 뒤에 오는 ‘심양’은 재점으로 표기되어 있음.-->
<sent type="main" lang="kor" page="10" n="28">향니로 가시면 이졔ᄂᆞᆫ 녯일이 츈몽이라</sent>
<sent type="main" lang="kor" page="10" n="29">다시 호시졀을 만나보기을 조이오나 가이 엇ᄉᆞ오릿가</sent>
<sent type="main" lang="kor" page="10" n="30">젼후ᄉᆞ가 ᄒᆞᆫ번 죽어 모르미 원이오나 이도 난쳐ᄒᆞ오며</sent>
<sent type="main" lang="kor" page="10" n="31">부ᄃᆡ부ᄃᆡ 무신 무의나 ᄒᆡᆼ치 마옵쇼셔</sent><!--'부ᄃᆡ부ᄃᆡ'의 뒤에 오는 ‘부ᄃᆡ’는 재점으로 표기되어 있음.-->
<sent type="main" lang="kor" page="10" n="32">슈디 업시ᄒᆞ옵쇼셔</sent>
<sent type="main" lang="kor" page="10" n="33">금일노븟터 이만 셔신도 못 ᄒᆞᄂᆞ니다</sent>
<sent type="main" lang="kor" page="10" n="34">규듕심절의 소작이 타인이 아오면</sent>
<sent type="main" lang="kor" page="10" n="35">슈신 ᄒᆡᆼ도의 험이 되올가 ᄒᆞ오니 보시고 드려보ᄂᆡᄋᆞᆸ소셔</sent>
</letter>

<img n="09ㆍ05">https://kohico.kr/_media/image/19C_순명효황후언간/09ㆍ05.jpg</img>
<letter n="09ㆍ05" sender="순명효황후(세자빈)" writer="순명효황후(세자빈)" receiver="김상덕(세자의 스승)" year="1897년">
<sent type="main" lang="kor" page="09ㆍ05" n="1">일ᄎᆞ 황송 듕 젹거ᄒᆞ신 후 소식 망연이오니</sent>
<sent type="main" lang="kor" page="09ㆍ05" n="2">쥬소 탄셕이온 듕 긔력 평부을 부지오니</sent>
<sent type="main" lang="kor" page="09ㆍ05" n="3">명운이 블니ᄒᆞᄉᆞ 초야의 뭇치시믈 한탄이옵더니</sent>
<sent type="main" lang="kor" page="09ㆍ05" n="4">기후 젼셜 탐문ᄒᆞᆫ즉 은ᄉᆞ을 무르샤 향니의 도라가신 일 만만 츅슈오며 일캇ᄌᆞ옵고</sent><!--'만만'의 뒤에 오는 ‘만’은 재점으로 표기되어 있음.-->
<sent type="main" lang="kor" page="09ㆍ05" n="5">지ᄂᆡ나 인편 슌치 못ᄒᆞ여 일 댱 셔찰도 븟치지 못ᄒᆞ니 본심과 갓지 못ᄒᆞ오며</sent>
<sent type="main" lang="kor" page="09ㆍ05" n="6">여긔셔ᄂᆞᆫ ᄃᆡ소됴 졔졀 강녕ᄒᆞ시고 기간 환어되시니 만만 경츅이오며</sent><!--'만만'의 뒤에 오는 ‘만’은 재점으로 표기되어 있음.-->
<sent type="main" lang="kor" page="09ㆍ05" n="7">ᄎᆞ인은 근근 부지ᄒᆞ오나 무비 심난ᄒᆞ온 마음ᄲᅮᆫ이오며</sent><!--'근근'의 뒤에 오는 ‘근’은 재점으로 표기되어 있음.-->
<sent type="main" lang="kor" page="09ㆍ05" n="8">경향이 머온들 엇지 그리 일 댱 봉셔을 아니시니</sent>
<sent type="main" lang="kor" page="09ㆍ05" n="9">젼일 밋든 ᄇᆡ 안닌가 ᄒᆞᄂᆞ이다</sent>
<sent type="main" lang="kor" page="09ㆍ05" n="10">무삼 일노 오신 거ᄉᆞᆫ 나도 반이나 아ᄋᆞᆸ거니와</sent>
<sent type="main" lang="kor" page="09ㆍ05" n="11">문안은 엇지 아니 드러오시며 벼ᄉᆞᆯᄒᆞ시기 밋ᄂᆞ이다</sent>
<sent type="main" lang="kor" page="09ㆍ05" n="12">한심심ᄒᆞᆫ 말ᄉᆞᆷ 만ᄉᆞ오나 다 못ᄒᆞᄂᆞ이다</sent><!--'한심심ᄒᆞᆫ'의 뒤에 오는 ‘심’은 재점으로 표기되어 있음.-->
<sent type="main" lang="kor" page="09ㆍ05" n="13">어ᄂᆞ ᄯᆡ 가시ᄂᆞ잇가 듯ᄂᆞ니 간단 말만 들니니 어ᄂᆞ ᄯᆡ나 태평ᄒᆞᆫ ᄯᆡ오닛가</sent>
<sent type="main" lang="kor" page="09ㆍ05" n="14">가시면 아조 ᄉᆡᆼ각도 아니시고 오셔야 셔찰을 ᄒᆞ시니 심궁의 갓치인 ᄆᆞ음 야쇽ᄒᆞ오이다</sent>
</letter>

<img n="02">https://kohico.kr/_media/image/19C_순명효황후언간/02.jpg</img>
<letter n="02" sender="순명효황후(세자빈)" writer="순명효황후(세자빈)" receiver="김상덕(세자의 스승)" year="1897년">
<sent type="envelop1-1" lang="kor" page="02" n="1">홍듀 김 승지 젼</sent>
<sent type="main" lang="kor" page="02" n="1">봉셔 보옵고 느리 블평 듕 지ᄂᆡ시는가 보오니 향니 침폐ᄒᆞ신 연고이온 듯 장시 일캇ᄉᆞᆸ고</sent>
<sent type="main" lang="kor" page="02" n="2">예ᄂᆞᆫ 대ᄂᆡ 문안 만안ᄒᆞ오시니 경츅 만만이오며</sent><!--'만만이오며'의 뒤에 오는 ‘만’은 재점으로 표기되어 있음.-->
<sent type="main" lang="kor" page="02" n="3">나는 쳬증으로 여름을 지ᄂᆡ오니 답답ᄒᆞ오며</sent><!--'답답ᄒᆞ오며'의 뒤에 오는 ‘답’은 재점으로 표기되어 있음.-->
<sent type="main" lang="kor" page="02" n="4">향일은 우연이 시험ᄒᆞᆫ 글시옵고 ᄃᆡᄉᆞ롭지 아닌 거신ᄃᆡ 도로여 블안ᄒᆞ오이다</sent>
<sent type="main" lang="kor" page="02" n="5">금년은 년ᄉᆞ나 풍셩ᄒᆞ여 민졍이나 위로되기 ᄇᆞ라옵ᄂᆞ이다</sent>
<sent type="main" lang="kor" page="02" n="6">셩념의 태평이 지ᄂᆡ시기 ᄇᆞ라옵ᄂᆞ이다</sent>
<sent type="main" lang="kor" page="02" n="7">나라의 경츅이 금년 갓ᄉᆞ온 ᄯᆡ 드무오니 ᄒᆞ졍이 읏더타 ᄒᆞ올 길 읍ᄉᆞ오나</sent>
<sent type="main" lang="kor" page="02" n="8">일변 츄모지통이 미ᄉᆞ지젼의 잇ᄉᆞ올 길 읍ᄉᆞ오이다 </sent>
<sent type="main" lang="kor" page="02" n="9">칠월 초칠일</sent>
</letter>

<img n="01">https://kohico.kr/_media/image/19C_순명효황후언간/01.jpg</img>
<letter n="01" sender="순명효황후(세자빈)" writer="순명효황후(세자빈)" receiver="김상덕(세자의 스승)" year="1897년">
<sent type="main" lang="kor" page="01" n="1">오ᄅᆡ간만의 봉셔 보옵고 기간 지ᄂᆡ신 말ᄉᆞᆷ은 무ᄉᆞᆫ 말ᄉᆞᆷ을 ᄒᆞ오릿가</sent>
<sent type="main" lang="kor" page="01" n="2">겸ᄒᆞ와 누삭 미령 졔졀이 ᄃᆡ단ᄒᆞ시든 일 지ᄂᆡᆫ 일이오나 놀납ᄉᆞ오며</sent>
<sent type="main" lang="kor" page="01" n="3">궁향의 됴셥ᄒᆞ시는 범ᄇᆡᆨ이나 편ᄒᆞ신지 궁금ᄒᆞ오며</sent>
<sent type="main" lang="kor" page="01" n="4">예ᄂᆞᆫ 대소됴 졔졀 만안ᄒᆞ오시옵고</sent>
<sent type="main" lang="kor" page="01" n="5">폐ᄒᆞ 탄신일이 머지아니ᄒᆞ오시오니 경츅 만만이온 듕션마마 셩음이 졈졈 머러지옵고</sent><!--'만만이온', '듕션마마', '졈졈'의 뒤에 오는 ‘만’, '마', '졈'은 재점으로 표기되어 있음.-->
<sent type="main" lang="kor" page="01" n="6">ᄯᅩ 년ᄉᆡ 면흉이 못 되와 민졍이 분요ᄒᆞᆫ 일 슉식의 못 닛치옵ᄂᆞ이다</sent>
<sent type="main" lang="kor" page="01" n="7">나는 잘 잇ᄉᆞ오나 심신이 강ᄀᆡᄒᆞᆫ 일이 만ᄉᆞ오니 협견을 아실 듯ᄒᆞ오이다</sent>
<sent type="main" lang="kor" page="01" n="8">역 칠실의 탄이나 지지 안ᄉᆞ오이다 </sent><!--'지지'의 뒤에 오는 ‘지’는 재점으로 표기되어 있음.-->
<sent type="main" lang="kor" page="01" n="9">칠월 십삼일</sent>
</letter>

<img n="04">https://kohico.kr/_media/image/19C_순명효황후언간/04.jpg</img>
<letter n="04" sender="순명효황후(태자비)" writer="순명효황후(태자비)" receiver="김상덕(태자의 스승)" year="1902년">
<sent type="main" lang="kor" page="04" n="1">작년 일ᄎᆞ 봉셔 보온 후 연ᄒᆞ와 긔후 강건ᄒᆞ오시옵고</sent>
<sent type="main" lang="kor" page="04" n="2">작년 갓ᄉᆞ온 겸년과 치위의 읏지 지ᄂᆡ신지 궁금ᄒᆞ옵드니</sent>
<sent type="main" lang="kor" page="04" n="3">과셰 안강이 ᄒᆞ오신 긔별 듯ᄌᆞ오니 만ᄒᆡᆼ이오며</sent>
<sent type="main" lang="kor" page="04" n="4">예ᄂᆞᆫ 대소됴 문안 만안ᄒᆞ오시옵고</sent>
<sent type="main" lang="kor" page="04" n="5">금년 갓ᄉᆞ온 경츅지시을 당ᄒᆞ오니 경츅ᄒᆞᆫ ᄒᆞ졍 측냥읍ᄉᆞ오며</sent>
<sent type="main" lang="kor" page="04" n="6">나도 별고 읍ᄉᆞ옵고 신년브터난 가국이 일쳬 태평ᄒᆞ여 신민이 안도낙업ᄒᆞ기을 ᄇᆞ랄 ᄲᅮᆫ이외다 </sent>
<sent type="main" lang="kor" page="04" n="7">졍월 염삼일</sent>
</letter>

<img n="06">https://kohico.kr/_media/image/19C_순명효황후언간/06.jpg</img>
<letter n="06" sender="순명효황후(태자비)" writer="순명효황후(태자비)" receiver="김상덕(태자의 스승)" year="1902년">
<sent type="envelop" lang="kor" page="06" n="1">ᄐᆡᄌᆞ비궁 젼하 봉셔 임인 졍월</sent>
<sent type="main" lang="kor" page="06" n="1">회답ᄒᆞ소셔 만 번 밋ᄉᆞᆸᄂᆞ니</sent>
<sent type="main" lang="kor" page="06" n="2">이번 문약이 ᄒᆡᆼᄎᆞ의 동ᄒᆡᆼᄒᆞ옵소셔</sent>
<sent type="main" lang="kor" page="06" n="3">심간을 쏘다 진졍으로 쳥ᄒᆞᆯ 일 잇ᄉᆞ오니</sent>
<sent type="main" lang="kor" page="06" n="4">능이 드르시릿가 국ᄉᆞ을 위ᄒᆞᄉᆞ 블셕신명ᄒᆞ소셔</sent>
</letter>

<img n="08">https://kohico.kr/_media/image/19C_순명효황후언간/08.jpg</img>
<letter n="08" sender="순명효황후(태자비)" writer="순명효황후(태자비)" receiver="김상덕(태자의 스승)" year="1904년">
<sent type="envelop1-1" lang="kor" page="08" n="1">홍듀 김 직각 보ᄋᆞᆸ소셔</sent>
<sent type="main" lang="kor" page="08" n="1">거년의 쇼식 듯ᄉᆞ온 후 궁금ᄒᆞ와 ᄆᆡ양 말ᄉᆞᆷ이옵더니</sent>
<sent type="main" lang="kor" page="08" n="2">환셰 태평이 ᄒᆞ오신가 보오니 흔츅허오며</sent>
<sent type="main" lang="kor" page="08" n="3">예셔ᄂᆞᆫ 지ᄂᆡ온 ᄇᆞ는 ᄉᆡᆼ각이 기시의 밋ᄉᆞ오면</sent>
<sent type="main" lang="kor" page="08" n="4">ᄎᆞ신이 읍고져 ᄒᆞ는 말ᄉᆞᆷ 일필난긔오이다</sent>
<sent type="main" lang="kor" page="08" n="5">이ᄉᆞ이ᄂᆞᆫ 셩후 만안ᄒᆞ오시옵고 예후도 ᄒᆡᆼ보 종시 블평ᄒᆞ오시오나</sent>
<sent type="main" lang="kor" page="08" n="6">다른 제졀은 만안ᄒᆞ오시니 츅슈오며</sent>
<sent type="main" lang="kor" page="08" n="7">나는 신병이 셩헌 날 읍ᄉᆞ오며</sent>
<sent type="main" lang="kor" page="08" n="8">셔ᄉᆡ 지리ᄒᆞ와 ᄃᆡ강 뎍ᄉᆞᆸᄂᆞ이다 </sent>
<sent type="main" lang="kor" page="08" n="9">졍월 이십삼일</sent>
</letter>

<img n="03">https://kohico.kr/_media/image/19C_순명효황후언간/03.jpg</img>
<letter n="03" sender="순명효황후(태자비)" writer="순명효황후(태자비)" receiver="김상덕(태자의 스승)" year="1904년">
<sent type="envelop1-1" lang="chi" page="03" n="1">川弓 後洞 上書 金直閣宅 入納</sent>
<sent type="main" lang="kor" page="03" n="2">거월의 봉셔 보옵고 긔후 안강ᄒᆞ오신 소식 듯ᄉᆞ오니</sent>
<sent type="main" lang="kor" page="03" n="3">오ᄅᆡ 궁금ᄒᆞ옵든 마음이 든든ᄒᆞ오이다</sent><!--'든든ᄒᆞ오이다'의 뒤에 오는 ‘든’은 재점으로 표기되어 있음.-->
<sent type="main" lang="kor" page="03" n="4">예ᄂᆞᆫ 황상 폐ᄒᆞ 셩후 만안ᄒᆞ오시옵고</sent>
<sent type="main" lang="kor" page="03" n="5">츈궁 졔졀 만안ᄒᆞ오시니이 밧 경츅이 읍ᄉᆞ오며</sent>
<sent type="main" lang="kor" page="03" n="6">나는 몸이 별양 읍ᄉᆞ오나 몸이 지통의 잠겨시니</sent>
<sent type="main" lang="kor" page="03" n="7">ᄋᆡ락 간 죄인이라 쳔지만믈의 가이 조흔 거시 읍는 듕</sent>
<sent type="main" lang="kor" page="03" n="8">무뎡ᄒᆞᆫ 셰월은 ᄌᆞ로 맛ᄂᆞ이니 ᄉᆡᆼᄉᆞ의 붓그럽ᄉᆞ오이다</sent>
<sent type="main" lang="kor" page="03" n="9">향니 고됴로 지ᄂᆡ시는 일 단단ᄒᆞ오이다 </sent><!--'단단ᄒᆞ오이다'의 뒤에 오는 ‘단’은 재점으로 표기되어 있음.-->
<sent type="main" lang="kor" page="03" n="10">삼월 초오일</sent>
</letter>

