<letter n="1" sender="임일유(아버지)" writer="임일유(아버지)" receiver="나주임씨(딸)" year="1611~1683년">
<sent type="envelop1-1" lang="kor" page="1" n="01">ᄇᆡ오개 답셔</sent>
<sent type="envelop1-1" lang="kor" page="1" n="02">[수결]</sent>
<sent type="main" lang="kor" page="1" n="03">젼일 유무 보되</sent>
<sent type="main" lang="kor" page="1" n="04">지금 ᄃᆡ답 몯 ᄒᆞ엿더니</sent>
<sent type="main" lang="kor" page="1" n="05">ᄯᅩ 유무 보고 든든ᄒᆞ며</sent><!--'든든ᄒᆞ며'에서 뒤에 오는 '든'은 재점(〃)으로 표기되어 있음-->
<sent type="main" lang="kor" page="1" n="06">무ᄉᆞ히 잇ᄂᆞᆫ가 시브니 다ᄒᆡᆼᄒᆞ다</sent>
<sent type="main" lang="kor" page="1" n="07">우리도 무ᄉᆞ히 디내노라</sent>
<sent type="main" lang="kor" page="1" n="08">밧바 잠</sent>
<sent type="main" lang="kor" page="1" n="09">유월 슌뉵</sent>
<sent type="main" lang="kor" page="1" n="10">총암 셔</sent>
</letter>

<letter n="2" sender="임일유(아버지)" writer="임일유(아버지)" receiver="나주임씨(딸)" year="1611~1683년">
<sent type="main" lang="kor" page="2" n="01">ᄇᆡ오개집 답셔</sent>
<sent type="main" lang="kor" page="2" n="02">[수결]</sent>
<sent type="main" lang="kor" page="2" n="03">긔별 모ᄅᆞ니 답답ᄒᆞ더니</sent><!--'답답ᄒᆞ더니'에서 뒤에 오는 '답'은 재점(〃)으로 표기되어 있음-->
<sent type="main" lang="kor" page="2" n="04">유무 보고 깃브되</sent>
<sent type="main" lang="kor" page="2" n="05">병이 지금 ᄒᆞ리 못ᄒᆞ엿ᄂᆞᆫ가 시브니 엇디 그런고</sent>
<sent type="main" lang="kor" page="2" n="06">예 이신 제 잠간 ᄒᆞᆫ ᄉᆞ이 ᄎᆞᆫ ᄃᆡ 안니다</sent>
<sent type="main" lang="kor" page="2" n="07">듕ᄒᆞᆫ 증이 아니 날 거시로ᄃᆡ</sent>
<sent type="main" lang="kor" page="2" n="08">지금 ᄒᆞ리디 못ᄒᆞᆫ가 시브니 분별ᄒᆞ노라</sent>
<sent type="main" lang="kor" page="2" n="09">우리ᄂᆞᆫ 반혼이 드러오니</sent>
<sent type="main" lang="kor" page="2" n="10">새로이 참혹ᄒᆞ믈 다 뎍으랴</sent>
<sent type="main" lang="kor" page="2" n="11">보션 와시니 두거니와</sent>
<sent type="main" lang="kor" page="2" n="12">후의ᄂᆞᆫ 마라 안심티 아니타</sent>
<sent type="main" lang="kor" page="2" n="13">ᄉᆞ월 념오일</sent>
<sent type="main" lang="kor" page="2" n="14">총암</sent>
</letter>

<letter n="3" sender="임일유(아버지)" writer="임일유(아버지)" receiver="나주임씨(딸)" year="1611~1683년">
<sent type="envelop1-1" lang="kor" page="3" n="01">ᄇᆡ오개집 답셔</sent>
<sent type="envelop1-1" lang="kor" page="3" n="02">[수결]</sent>
<sent type="main" lang="kor" page="3" n="03">젼일 유무 보고 깃브되</sent>
<sent type="main" lang="kor" page="3" n="04">병환이 채 ᄒᆞ리디 몯ᄒᆞ엿ᄂᆞᆫ가 시브니</sent>
<sent type="main" lang="kor" page="3" n="05">위연 든 병이 의약도 싀골도곤 나을 거시로ᄃᆡ</sent>
<sent type="main" lang="kor" page="3" n="06">지금 몯 됴핫ᄂᆞᆫ가 시브니 념녀ᄒᆞ노라</sent>
<sent type="main" lang="kor" page="3" n="07">보션은 병듕의 므스 일 슈고이 기워 보낸고 ᄒᆞ며 즉시 신과다</sent>
<sent type="main" lang="kor" page="3" n="08">우리ᄂᆞᆫ 계요 디내거니와</sent>
<sent type="main" lang="kor" page="3" n="09">심ᄉᆡ야 됴흔 ᄠᅢ 이시랴</sent>
<sent type="main" lang="kor" page="3" n="10">ᄇᆞᆯ셔 답장이나 ᄒᆞᆯ 거ᄉᆞᆯ 왕ᄂᆡ 업서 이제야 뎌그며</sent>
<sent type="main" lang="kor" page="3" n="11">병환이나 쉬 쾌차ᄒᆞᆷ ᄇᆞ라노라</sent>
<sent type="main" lang="kor" page="3" n="12">윤월 슌삼일</sent>
<sent type="main" lang="kor" page="3" n="13">총암 셔</sent>
</letter>

<letter n="4" sender="임일유(아버지)" writer="임일유(아버지)" receiver="나주임씨(딸)*" year="1611~1683년">
<sent type="main" lang="kor" page="4" n="01">새ᄒᆡ예 됴히 잇ᄂᆞᆫ다</sent>
<sent type="main" lang="kor" page="4" n="02">졍일 뎌그니 보고 본 ᄃᆞᆺ 든든ᄒᆞᄃᆡ</sent><!--'든든ᄒᆞᄃᆡ'에서 뒤에 오는 '든'은 재점(〃)으로 표기되어 있음-->
<sent type="main" lang="kor" page="4" n="03">왕ᄂᆡ 이신 적도 몸의 병도 들고 슌마다 총총ᄒᆞ여</sent><!--'총총ᄒᆞ여'에서 뒤에 오는 '총'은 재점(〃)으로 표기되어 있음-->
<sent type="main" lang="kor" page="4" n="04">유무도 ᄌᆞ연 ᄆᆞᄋᆞᆷ대로 뎍디 못ᄒᆞ며 서운ᄒᆞ여 ᄒᆞ노라</sent>
<sent type="main" lang="kor" page="4" n="05">예셔도 과셰ᄂᆞᆫ 편히 ᄒᆞ나</sent>
<sent type="main" lang="kor" page="4" n="06">녕감 긔운도 ᄆᆞ양 블평ᄒᆞ시니 민망ᄒᆞ여 디내노라</sent>
<sent type="main" lang="kor" page="4" n="07">긔운도 곤ᄒᆞ고 총총ᄒᆞ여 잠 뎍노라</sent><!--'총총ᄒᆞ여'에서 뒤에 오는 '총'은 재점(〃)으로 표기되어 있음-->
<sent type="main" lang="kor" page="4" n="08">계 원월 초삼</sent>
<sent type="main" lang="kor" page="4" n="09">총암 큰ᄃᆡᆨ의셔</sent>
</letter>

<letter n="5" sender="임일유(아버지)" writer="임일유(아버지)" receiver="나주임씨(딸)" year="1682~1683년">
<sent type="envelop1-２" lang="kor" page="5" n="01">ᄇᆡ오개집 답셔</sent>
<sent type="envelop1-２" lang="kor" page="5" n="02">봉</sent>
<sent type="main" lang="kor" page="5" n="03">두 슌 연ᄒᆞ여 뎌그니</sent>
<sent type="main" lang="kor" page="5" n="03">보고 답장이나 ᄇᆞᆯ셔 뎌글 거ᄉᆞᆯ ᄆᆡ일 쳔연ᄒᆞ여 못 뎍으며</sent>
<sent type="main" lang="kor" page="5" n="04">서온ᄒᆞ여 ᄒᆞ더니라</sent>
<sent type="main" lang="kor" page="5" n="05">예셔ᄂᆞᆫ 영감 긔운도 평안ᄒᆞ시고 므ᄉᆞ히 디내노라</sent>
<sent type="main" lang="kor" page="5" n="06">뫼임 아긔 과거ᄂᆞᆫ 하 됴티 아니ᄒᆞ니 그런 애ᄃᆞᆯ온 일이 업서 ᄒᆞ노라</sent>
<sent type="main" lang="kor" page="5" n="07">졍낭은 녀환의 고롭기가 위위 ᄀᆞ이업ᄉᆞ니 치위예 샹ᄒᆞᆯ가 민망ᄒᆞ여 ᄒᆞ노라</sent><!--'위위'에서 뒤에 오는 '위'는 재점(〃)으로 표기되어 있음-->
<sent type="main" lang="kor" page="5" n="08">길도 ᄎᆞ리고 요요ᄒᆞ여 잠 뎍노라</sent><!--'요요ᄒᆞ여'에서 뒤에 오는 '요'는 재점(〃)으로 표기되어 있음-->
<sent type="main" lang="kor" page="5" n="09">시월 십칠</sent>
<sent type="main" lang="kor" page="5" n="10">총암 셔</sent>
</letter>

<letter n="6" sender="임일유(아버지)" writer="임일유(아버지)" receiver="나주임씨(딸)" year="1611~1683년">
<sent type="envelop1-1" lang="kor" page="6" n="01">ᄇᆡ오개집 답셔</sent>
<sent type="main" lang="kor" page="6" n="02">ᄇᆡ오개 영결셔라</sent>
<sent type="main" lang="kor" page="6" n="03">서ᄅᆞ 알안 디 삼십십여 년이로다</sent>
<sent type="main" lang="kor" page="6" n="04">졍이 졍이 깁고 ᄯᅳ디 서ᄅᆞ 마ᄌᆞ니</sent>
<sent type="main" lang="kor" page="6" n="05">쇼쇼 블여ᄒᆞᆫ 일 이버시나</sent><!--'쇼쇼'에서 뒤에 오는 '쇼'는 재점(〃)으로 표기되어 있음-->
<sent type="main" lang="kor" page="6" n="06">봄눈 스ᄃᆞᆺ ᄒᆞᄂᆞᆫ도다</sent>
<sent type="main" lang="kor" page="6" n="07">이제 아조 영결ᄒᆞ니 비창티 아니ᄒᆞᆯ고마ᄂᆞᆫ</sent>
<sent type="main" lang="kor" page="6" n="08">졍혼이 다 ᄂᆞᆯ고</sent>
<sent type="main" lang="kor" page="6" n="09">마치 업□□소 안차 블 길 알으나 못 ᄒᆞ니</sent>
<sent type="main" lang="kor" page="6" n="10">됴히됴히 ᄂᆞᆯ녀가 ᄇᆡᆨ연알 잘 디내소</sent>
<sent type="main" lang="kor" page="6" n="11">이 홋니블은 내 ᄉᆞ랑ᄒᆞ던 거시니</sent>
<sent type="main" lang="kor" page="6" n="12">고ᄉᆡᆼ모 아니 쥬고 보내니</sent>
<sent type="main" lang="kor" page="6" n="13">날 본 ᄃᆞᆺ 겹겻 ᄒᆞ여 겨시소</sent>
<sent type="main" lang="kor" page="6" n="14">ᄉᆞ창동 마노라 슈지 내 관 속의 여흐라</sent>
</letter>

<letter n="7" sender="임일유(아버지)" writer="임일유(아버지)" receiver="나주임씨(딸)" year="1611~1683년">
<sent type="envelop1-1" lang="kor" page="7" n="01">□오개집 답셔</sent>
<sent type="envelop1-1" lang="kor" page="7" n="02">봉</sent>
<sent type="envelop1-1" lang="kor" page="7" n="03">[봉투 후면] 녯 슈지니 내 관 속의 잘 녀흐라</sent>
</letter>

<letter n="8" sender="임일유(아버지)" writer="임일유(아버지)" receiver="나주임씨(딸)" year="1611~1683년">
<sent type="envelop1-1" lang="kor" page="8" n="01">ᄇᆡ오개 뎐송</sent>
<sent type="envelop1-1" lang="kor" page="8" n="02">부예 총암 셔</sent>
<sent type="envelop1-1" lang="kor" page="8" n="03">[봉투 후면]ᄉᆞ월 념ᄉᆞ□</sent>
</letter>
