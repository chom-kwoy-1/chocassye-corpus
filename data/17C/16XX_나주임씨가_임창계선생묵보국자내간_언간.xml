<letter n="01" sender="임영(아들)" writer="임영(아들)" receiver="임천조씨(어머니)" year="1682년">
<sent type="main" lang="kor" page="01" n="01">ᄒᆞᆫ 번 편지ᄒᆞ온 후 일졀 왕ᄂᆡ 업ᄉᆞ와 </sent>
<sent type="main" lang="kor" page="01" n="02">다시 쇼식을 통티 못ᄒᆞ오니</sent>
<sent type="main" lang="kor" page="01" n="03">섭섭 답답ᄒᆞ옴 ᄀᆞ이업ᄉᆞ오며</sent><!--'섭섭'에서 뒤에 오는 '섭'은 재점(〃)으로 표기되어 있음--><!--'답답ᄒᆞ옴'에서 뒤에 오는 '답'은 재점(〃)으로 표기되어 있음-->
<sent type="main" lang="kor" page="01" n="04">몽치 올 제과 형님 ᄒᆡᆼ듕ᄋᆡ 년ᄒᆞ여 하셔ᄂᆞᆫ ᄌᆞ시 보ᄋᆞᆸ고</sent>
<sent type="main" lang="kor" page="01" n="05">못내 든든 반갑ᄉᆞᆸ더이다</sent><!--'든든'에서 뒤에 오는 '든'은 재점(〃)으로 표기되어 있음-->
<sent type="main" lang="kor" page="01" n="06">이ᄯᅢ 긔후 대되 엇더ᄒᆞᄋᆞᆸ시니잇가</sent>
<sent type="main" lang="kor" page="01" n="07">ᄌᆞᄂᆞᆫ 계유 무ᄉᆞ히 잇ᄉᆞ오나</sent>
<sent type="main" lang="kor" page="01" n="08">여섯 번 슈망의 낙뎜을 죵시 아니ᄒᆞ시니</sent>
<sent type="main" lang="kor" page="01" n="09">각별 대단히 오지ᄒᆞᆫ 일 업시 그러ᄒᆞ오니 </sent>
<sent type="main" lang="kor" page="01" n="10">ᄂᆞᆷ 대되 고이히 녀기ᄋᆞᆸ</sent>
<sent type="main" lang="kor" page="01" n="11">마치 ᄂᆞ려가려키예</sent>
<sent type="main" lang="kor" page="01" n="12">혹 아르시고 믜이 녀기시ᄂᆞᆫ가 의심이 잇ᄉᆞ오나</sent>
<sent type="main" lang="kor" page="01" n="13">어이 짐쟉으로 아오리잇가</sent>
<sent type="main" lang="kor" page="01" n="14">대경의 ᄆᆞᆯ도 병 드럿고</sent>
<sent type="main" lang="kor" page="01" n="15">급급히 말ᄆᆡᄒᆞ기도 엇더구러 ᄒᆞ오니</sent>
<sent type="main" lang="kor" page="01" n="16">서로 슈원 형님과 동ᄒᆡᆼᄒᆞ여 가올가 시브ᄋᆞᆸ</sent>
<sent type="main" lang="kor" page="01" n="17">붓골은 피졉은 즉시 낫ᄉᆞ오나</sent>
<sent type="main" lang="kor" page="01" n="18">난 집도 오래 못 이실 집이니 엇딜고 ᄒᆞᄋᆞᆸ</sent>
<sent type="main" lang="kor" page="01" n="19">잇다감 가 보기ᄂᆞᆫ 보ᄋᆞᆸ거니와</sent>
<sent type="main" lang="kor" page="01" n="20">ᄌᆞ연 ᄌᆞᆺ기 쉽디 아니ᄒᆞᄋᆞᆸ</sent>
<sent type="main" lang="kor" page="01" n="21">계예ᄂᆞᆫ 어마님 편지를 ᄎᆞ고 ᄃᆞᆫ니니</sent><!--'ᄃᆞᆫ니니'에서 뒤에 오는 '니'는 재점(〃)으로 표기되어 있음-->
<sent type="main" lang="kor" page="01" n="22">졍이 업디 아닌가 긔특ᄒᆞᄋᆞᆸ</sent>
<sent type="main" lang="kor" page="01" n="23">곳츤 ᄇᆞᆯ셔 다 뎌실 거시니</sent>
<sent type="main" lang="kor" page="01" n="24">그런 애ᄃᆞᆲᄉᆞ온 일이 업ᄉᆞᆸ</sent>
<sent type="main" lang="kor" page="01" n="25">반찬을 엇디ᄒᆞ시ᄂᆞᆫ고</sent>
<sent type="main" lang="kor" page="01" n="26">뉴의 념녀롭ᄉᆞᆸ</sent>
<sent type="main" lang="kor" page="01" n="27">마ᄌᆞᆷ 뎐뎐 사ᄅᆞᆷ 가올ᄉᆡ 잠 알외ᄋᆞᆸ</sent><!--'뎐뎐'에서 뒤에 오는 '뎐'은 재점(〃)으로 표기되어 있음-->
<sent type="main" lang="kor" page="01" n="28">아마도 긔운 평안ᄒᆞᄋᆞᆸ심 ᄇᆞ라ᄋᆞᆸᄂᆞ이다</sent>
<sent type="main" lang="kor" page="01" n="29">임슐 삼월 이십일 야</sent>
<sent type="main" lang="kor" page="01" n="30">ᄌᆞ 영 ᄉᆞᆯ이</sent>
</letter>

<letter n="02" sender="임영(아들)" writer="임영(아들)" receiver="임천조씨(어머니)" year="1682년">
<sent type="main" lang="kor" page="02" n="01">슈원 형님 오ᄋᆞᆸᄂᆞᆫ ᄃᆡ</sent>
<sent type="main" lang="kor" page="02" n="02">하셔 밧ᄌᆞ와 못내 알외오며</sent>
<sent type="main" lang="kor" page="02" n="03">됴 셔방집 말 드르니</sent>
<sent type="main" lang="kor" page="02" n="04">긔운이 평안티 못ᄒᆞ신 ᄃᆡ 잇ᄂᆞᆫ가 시브오ᄃᆡ </sent>
<sent type="main" lang="kor" page="02" n="05">아니 긔별ᄒᆞ여 겨ᄋᆞᆸ시니 답답ᄒᆞᄋᆞᆸ</sent><!--'답답ᄒᆞᄋᆞᆸ'에서 뒤에 오는 '답'는 재점(〃)으로 표기되어 있음-->
<sent type="main" lang="kor" page="02" n="06">ᄌᆞᄂᆞᆫ 젼후 아홉 번 슈망의 낙뎜을 아니ᄒᆞ시니</sent>
<sent type="main" lang="kor" page="02" n="07">황공은 ᄒᆞᄋᆞᆸ거니와</sent>
<sent type="main" lang="kor" page="02" n="08">오래 이셔도 마치 아모리ᄒᆞ여 그리ᄒᆞ시ᄂᆞᆫ 줄은 알 길히 업ᄉᆞᆸ고</sent>
<sent type="main" lang="kor" page="02" n="09">본ᄃᆡ 쉬이 가오려 ᄒᆞ엿다가</sent>
<sent type="main" lang="kor" page="02" n="10">ᄯᅩ 오래 머므오면</sent>
<sent type="main" lang="kor" page="02" n="11">그ᄉᆞ이 ᄯᅩ 아모 난편ᄒᆞᆫ 일이 이실 줄 아디 못ᄒᆞ오니</sent>
<sent type="main" lang="kor" page="02" n="12">아흐랜 말믜 바다셔 열이튼날 길 나랴 ᄒᆞᄋᆞᆸᄂᆞ이다</sent>
<sent type="main" lang="kor" page="02" n="13">여라 가지로 혜고 ᄉᆡᆼ각ᄒᆞᄋᆞᆸᄂᆞᆫ 일이니</sent>
<sent type="main" lang="kor" page="02" n="14">그르디 아닐 법 잇ᄉᆞᆸᄂᆞ니이다</sent>
<sent type="main" lang="kor" page="02" n="15">츈당ᄃᆡᄂᆞᆫ 과연 념젼으로 ᄒᆞ게 ᄒᆞ엿ᄉᆞ오니</sent>
<sent type="main" lang="kor" page="02" n="16">즉시 대경의게 긔별ᄒᆞ엿더니</sent>
<sent type="main" lang="kor" page="02" n="17">오늘 드러오노라 ᄒᆞ엿ᄉᆞᆸ</sent>
<sent type="main" lang="kor" page="02" n="18">글 ᄡᅳ리ᄂᆞᆫ 쥬션ᄒᆞ여 보오려니와</sent>
<sent type="main" lang="kor" page="02" n="19">엇기 쉽디 아닐가 시브니 겨시ᄋᆞᆸ</sent>
<sent type="main" lang="kor" page="02" n="20">됴 셔방집은 요ᄉᆞ이ᄂᆞᆫ 이리 와 이시니 든든ᄒᆞᄋᆞᆸ</sent><!--'든든ᄒᆞᄋᆞᆸ'에서 뒤에 오는 '든'은 재점(〃)으로 표기되어 있음-->
<sent type="main" lang="kor" page="02" n="21">아마도 긔운 평안ᄒᆞᄋᆞᆸ심 ᄇᆞ라ᄋᆞᆸᄂᆞ이다</sent>
<sent type="main" lang="kor" page="02" n="22">임슐 ᄉᆞ월 초뉵일</sent>
<sent type="main" lang="kor" page="02" n="23">ᄌᆞ 영 ᄉᆞᆯ이</sent>
</letter>

<letter n="03" sender="임영(남동생)" writer="임영(남동생)" receiver="나주임씨(막내누나)" year="1683년">
<sent type="main" lang="kor" page="03" n="01">오ᄂᆞᆫ 날 편지 ᄇᆞᆯ셔 보완 디 오란가 ᄒᆞ며 </sent>
<sent type="main" lang="kor" page="03" n="02">이리 온 후ᄂᆞᆫ 부예 긔별도 ᄒᆞᆫ 번도 못 드러시니</sent>
<sent type="main" lang="kor" page="03" n="03">더옥 겟 긔별이야 어이 드를 길히 이실고 </sent>
<sent type="main" lang="kor" page="03" n="04"> 아ᄋᆞ라히 ᄉᆡᆼ각ᄲᅮᆫ이며</sent>
<sent type="main" lang="kor" page="03" n="05">나ᄂᆞᆫ 이 스므ᄒᆞᄅᆞ날이야 산소의 드러오니</sent>
<sent type="main" lang="kor" page="03" n="06">셜온 졍ᄉᆞ를 어이 형용ᄒᆞ여 니를고</sent>
<sent type="main" lang="kor" page="03" n="07">쇽졀업스나 그려도 ᄆᆞ음의 든든ᄒᆞ여 잇ᄂᆡ</sent><!--'든든ᄒᆞ여'에서 뒤에 오는 '든'은 재점(〃)으로 표기되어 있음-->
<sent type="main" lang="kor" page="03" n="08">셕믈은 망듀과 계절과 상돌을 다 시작ᄒᆞ여 ᄒᆞ랴 ᄒᆞ니</sent>
<sent type="main" lang="kor" page="03" n="09">역ᄉᆡ 젹디 아니코</sent>
<sent type="main" lang="kor" page="03" n="10">한아바님 계졀도 셕믈이 미비ᄒᆞ매 그도 ᄒᆞ랴 ᄒᆞ고</sent>
<sent type="main" lang="kor" page="03" n="11">부예셔 가져온 상돌이 됴티 아니ᄒᆞ매</sent>
<sent type="main" lang="kor" page="03" n="12">예셔 고티랴 ᄒᆞ니</sent>
<sent type="main" lang="kor" page="03" n="13">구월 ᄂᆡ로 필역을 밋디 못ᄒᆞ니</sent>
<sent type="main" lang="kor" page="03" n="14">아직 ᄒᆡᆼ긔 디속을 뎡티 못ᄒᆞᆯ쇠</sent>
<sent type="main" lang="kor" page="03" n="15">진ᄉᆞᄂᆞᆫ 아바님 ᄒᆡᆼ차 뎨서 아니 ᄯᅥ나겨신 ᄯᅢ</sent>
<sent type="main" lang="kor" page="03" n="16">밋처 가랴키예 수이 도라가니</sent>
<sent type="main" lang="kor" page="03" n="17">심ᄉᆡ를 더옥 뎡티 못ᄒᆞᆯ쇠</sent>
<sent type="main" lang="kor" page="03" n="18">박뫼셔ᄂᆞᆫ 사ᄅᆞᆷ이 ᄌᆞ조 ᄃᆞᆫ니 퍽 든든ᄒᆡ</sent>
<sent type="main" lang="kor" page="03" n="19">누의님은 년졔 미처 ᄂᆞ려오려거니와</sent>
<sent type="main" lang="kor" page="03" n="20">그ᄯᅢ 마ᄌᆞᆷ 더브러 ᄃᆞᆫ니리나 이실가 아디 못ᄒᆞ니</sent>
<sent type="main" lang="kor" page="03" n="21">ᄒᆡᆼ혀 혬과 달나 만나기 쉽디 아닐가 념녀ᄒᆞᄂᆡ</sent>
<sent type="main" lang="kor" page="03" n="22">경여ᄂᆞᆫ 글을 이제나 챡실이 시쟉ᄒᆞ연가</sent>
<sent type="main" lang="kor" page="03" n="23">올 ᄯᅢ 감ᄉᆡ가 미리 사ᄅᆞᆷ 브려</sent>
<sent type="main" lang="kor" page="03" n="23">ᄒᆡᆼ긔을 알어셔 ᄉᆞᆷ녜로 나와 보고</sent>
<sent type="main" lang="kor" page="03" n="24">안흐로셔 반찬도 ᄒᆞ여 보내여시니 관곡ᄒᆞᆫ 사ᄅᆞᆷ이며</sent>
<sent type="main" lang="kor" page="03" n="25">거번 됴셩긔 ᄡᅵ게 편지ᄂᆞᆫ 즉시 뎐ᄒᆞ여시려니와</sent>
<sent type="main" lang="kor" page="03" n="26">일뎡 니편ᄒᆞ여 ᄒᆞᆯ 거시니 고되 만히 샹ᄒᆞᆫ가 ᄒᆞᄂᆡ</sent>
<sent type="main" lang="kor" page="03" n="27">나ᄂᆞᆫ 음식은 집이예셔ᄂᆞᆫ 낫게 먹오되</sent>
<sent type="main" lang="kor" page="03" n="28">긔운이 심히 곤ᄒᆞ여 민망ᄒᆡ ᄉᆞ연 다 못 뎍어 이만</sent>
<sent type="main" lang="kor" page="03" n="29">계ᄒᆡ 팔월 초일일</sent>
<sent type="main" lang="kor" page="03" n="30">동ᄉᆡᆼ 상인 영 임ᄉᆡᆼ의게</sent>
<sent type="main" lang="kor" page="03" n="31">ᄉᆞᆯ이ᄂᆞᆫ 바다 가ᄂᆡ</sent>
</letter>

<letter n="04" sender="임영(남동생)" writer="임영(남동생)" receiver="나주임씨(막내누나)" year="1684년">
<sent type="main" lang="kor" page="04" n="01">함평셔 뎐뎐으로 편지 어더 보고</sent><!--'뎐뎐으로'에서 뒤에 오는 '뎐'은 재점(〃)으로 표기되어 있음-->
<sent type="main" lang="kor" page="04" n="02">이리 와셔 ᄯᅩ 편지 보니 든든ᄒᆞ며</sent><!--'든든ᄒᆞ며'에서 뒤에 오는 '든'은 재점(〃)으로 표기되어 있음-->
<sent type="main" lang="kor" page="04" n="03">우리ᄂᆞᆫ 발인 장ᄉᆞᄂᆞᆫ 무ᄉᆞ히 디내고</sent>
<sent type="main" lang="kor" page="04" n="04">이 보롬날 룡담으로 드러왓ᄂᆡ</sent>
<sent type="main" lang="kor" page="04" n="05">범ᄉᆞ를 감ᄉᆡ 극진극진이 ᄒᆞ니</sent><!--'극진극진이'에서 뒤에 오는 '극진'은 재점(〃)으로 표기되어 있음-->
<sent type="main" lang="kor" page="04" n="06">젼년이예셔 더욱 ᄀᆞᆺᄌᆞᆸ게 디내고</sent>
<sent type="main" lang="kor" page="04" n="07">광듕 토식도 져년이나 다ᄅᆞ디 아니ᄒᆞ니 다ᄒᆡᆼᄒᆞ데</sent>
<sent type="main" lang="kor" page="04" n="08">내 병은 첫 ᄉᆡᆼ각ᄋᆡ 응당 못 견딀가 ᄒᆞ더니</sent>
<sent type="main" lang="kor" page="04" n="09">년ᄒᆞ여 약도 먹고 과도히 됴리ᄒᆞ기예 무ᄉᆞ히 디내여나니</sent>
<sent type="main" lang="kor" page="04" n="10">그런 의외 일이 업ᄂᆡ</sent>
<sent type="main" lang="kor" page="04" n="11">이제ᄂᆞᆫ 석 나은 듯ᄒᆞ나</sent>
<sent type="main" lang="kor" page="04" n="12">잠간 ᄒᆞ여도 병근이 잇기예</sent>
<sent type="main" lang="kor" page="04" n="13">긔운이 오르니 민망ᄒᆞ나</sent>
<sent type="main" lang="kor" page="04" n="14">미리 아라 됴리ᄒᆞ면 그리 대단히 국기든 아닐쇠</sent>
<sent type="main" lang="kor" page="04" n="15">예ᄂᆞᆫ 범ᄉᆡ 서어ᄂᆞᆫ ᄒᆞ되</sent>
<sent type="main" lang="kor" page="04" n="16">뫼히 깁고 집압희 큰 믈이 둘넛고 ᄀᆞ장 유벽ᄒᆞ니</sent>
<sent type="main" lang="kor" page="04" n="17">평시예 뫼셔 왓던들</sent>
<sent type="main" lang="kor" page="04" n="18">이도 됴흔 ᄯᅡ히런가 시브나 쇼졀 이실가</sent>
<sent type="main" lang="kor" page="04" n="19">잡손 업고 약ᄌᆡ도 향ᄌᆡ 토산은 흔ᄒᆞ니</sent>
<sent type="main" lang="kor" page="04" n="20">됴병의ᄂᆞᆫ 므던ᄒᆞ나</sent>
<sent type="main" lang="kor" page="04" n="21">뉴의 졔ᄉᆞ의도 반찬이 극난ᄒᆞ고 식되 ᄀᆞ장 어려우니</sent>
<sent type="main" lang="kor" page="04" n="22">ᄀᆞ을노 나ᄌᆔ로 ᄂᆞ리고져 ᄒᆞ나</sent>
<sent type="main" lang="kor" page="04" n="23">그도 아직 채 뎡티 못ᄒᆞ엿ᄂᆡ</sent>
<sent type="main" lang="kor" page="04" n="24">소셜은 ᄉᆞᄒᆡᆼ의 쇼식이 됴흔가 시브니</sent>
<sent type="main" lang="kor" page="04" n="25">이제ᄂᆞᆫ 인심이 퍽 딘뎐ᄒᆞ연가 ᄒᆞᄂᆡ</sent>
<sent type="main" lang="kor" page="04" n="26">이제도 이만 편지 ᄡᅳ기가 퍽 슈고로와</sent>
<sent type="main" lang="kor" page="04" n="27">긔운이 오를 듯ᄒᆞ니 민망ᄒᆡ</sent>
<sent type="main" lang="kor" page="04" n="28">이러ᄒᆞ여 녀ᄂᆞ 곳 편지ᄂᆞᆫ 못ᄒᆞᄂᆡ</sent>
<sent type="main" lang="kor" page="04" n="29">경예ᄂᆞᆫ 년ᄒᆞ여 글 닑고 셩ᄒᆞᆫ가</sent>
<sent type="main" lang="kor" page="04" n="30">산ᄎᆡ가 두룹 승엄초 하 됴흐니</sent>
<sent type="main" lang="kor" page="04" n="31">누의님 ᄉᆡᆼ각ᄒᆞᄂᆡ</sent>
<sent type="main" lang="kor" page="04" n="32">당□□□□□ 엿 약□□□ 더 ᄡᅳ고져 ᄒᆞ면 긔별ᄒᆞ소</sent>
<sent type="main" lang="kor" page="04" n="33">다만 슈원 형님 편지 가기 보내기 어려올가 시븨</sent>
<sent type="main" lang="kor" page="04" n="34">세 집이 □□□졉ᄒᆞᆯ ᄃᆡ 어더 이시니</sent>
<sent type="main" lang="kor" page="04" n="35">도로혀 죵용은 ᄒᆞᆫ가 시븨</sent>
<sent type="main" lang="kor" page="04" n="36">ᄉᆡᆼ동셔 응당 내 쇼식를 알고져 ᄒᆞᆯ 거시니 </sent>
<sent type="main" lang="kor" page="04" n="37">무ᄉᆞ히 왕환ᄒᆞᆫ 줄 긔별ᄒᆞ소</sent>
<sent type="main" lang="kor" page="04" n="38">밧바 이만</sent>
<sent type="main" lang="kor" page="04" n="39">갑ᄌᆞ 삼월 념일</sent>
<sent type="main" lang="kor" page="04" n="40">동ᄉᆡᆼ 상인 영</sent>

</letter>

<letter n="05" sender="임영(남동생)" writer="임영(남동생)" receiver="나주임씨(막내누나)" year="1685년">
<sent type="main" lang="kor" page="05" n="01">고을 ᄂᆡᄒᆡᆼ에 편지 어더 보고</sent>
<sent type="main" lang="kor" page="05" n="02">ᄉᆞ연 ᄌᆞ시 알고 못내 든든ᄒᆞ며</sent><!--'든든ᄒᆞ며'에서 뒤에 오는 '든'은 재점(〃)으로 표기되어 있음-->
<sent type="main" lang="kor" page="05" n="03">나ᄂᆞᆫ 면죵으로 날포 굿기더니</sent>
<sent type="main" lang="kor" page="05" n="04">이제ᄂᆞᆫ 다 ᄒᆞ렷ᄂᆡ</sent>
<sent type="main" lang="kor" page="05" n="05">도튱이 ᄇᆞᆯ셔 산소의 ᄃᆞᆫ녀와시매</sent>
<sent type="main" lang="kor" page="05" n="06">나ᄂᆞᆫ 형님ᄒᆞ고 오늘 길 나 산소로 가니</sent>
<sent type="main" lang="kor" page="05" n="07">그믐 젼으로 도라올가 시븨</sent>
<sent type="main" lang="kor" page="05" n="08">젼의 팔월 초ᄉᆡᆼ 난 편지예 됴보을 ᄒᆞᆫ ᄃᆡ 봉ᄒᆞ엿던가</sent>
<sent type="main" lang="kor" page="05" n="09">편지만 뎐ᄒᆞ고 됴보ᄂᆞᆫ 아니 뎐ᄒᆞ고 </sent>
<sent type="main" lang="kor" page="05" n="10">열이튼날 난 편지과 됴보ᄂᆞᆫ 원 아니 왓거늘</sent>
<sent type="main" lang="kor" page="05" n="11">구관 ᄒᆡ유 하인 오ᄂᆞᆫᄃᆡ</sent>
<sent type="main" lang="kor" page="05" n="12">ᄒᆞᆫ 편지 본 후 ᄎᆞᄌᆞ니</sent>
<sent type="main" lang="kor" page="05" n="13">처엄 보낸 됴보과 열이튼날 보내 됴보을 ᄎᆞ자 보ᄂᆡ고</sent>
<sent type="main" lang="kor" page="05" n="14">열이틀날 편지ᄂᆞᆫ 죵시 못 어더 보니</sent>
<sent type="main" lang="kor" page="05" n="15">므슴 번거ᄒᆞᆫ 말이나 잇던가</sent>
<sent type="main" lang="kor" page="05" n="16">편지 뎐키가 ᄒᆞ 셩실티 아니ᄒᆞ니 그런 민망이 업ᄂᆡ</sent>
<sent type="main" lang="kor" page="05" n="17">겨울ᄒᆡ ᄂᆞ려오려 ᄒᆞ면 아므려나 인마 두 필과 죠림 솔권ᄒᆞ여 보냄새</sent>
<sent type="main" lang="kor" page="05" n="18">자ᄂᆡ 편지 보고 블고만ᄉᆞᄒᆞ고 가련노라 ᄒᆞᄂᆡ</sent>
<sent type="main" lang="kor" page="05" n="19">초상브터 ᄒᆞᆫ 번 졔ᄉᆞ의 참예티 못ᄒᆞ여시니 </sent>
<sent type="main" lang="kor" page="05" n="20">오랴 ᄒᆞᄂᆞᆫ 거시 인졍 텬리예 응당ᄒᆞᆫ 일이니</sent>
<sent type="main" lang="kor" page="05" n="21">엇던 그리 바히 못 가리라 막막이 말오실고</sent><!--'막막이'에서 뒤에 오는 '막'은 재점(〃)으로 표기되어 있음-->
<sent type="main" lang="kor" page="05" n="22">하 어려워 말고 죵용이 ᄉᆞᆯ와셔</sent>
<sent type="main" lang="kor" page="05" n="23">뎡ᄒᆞᆫ 허락 밧ᄌᆞ온 후 즉시 긔별ᄒᆞ소</sent>
<sent type="main" lang="kor" page="05" n="24">나ᄂᆞᆫ 요ᄉᆞᄉᆞ이 ᄯᅩ 고봉 졀뎡의 새 터흘 어덧더니</sent>
<sent type="main" lang="kor" page="05" n="25">누의님 말도 뉴리ᄒᆞ나 굿ᄒᆞ여 ᄆᆡ양 그러랴 ᄒᆞᄂᆡ</sent>
<sent type="main" lang="kor" page="05" n="26">시방 길 ᄎᆞᆯ혀 시방 나매 총총ᄒᆞ여 이만</sent><!--'총총ᄒᆞ여'에서 뒤에 오는 '총'은 재점(〃)으로 표기되어 있음-->
<sent type="main" lang="kor" page="05" n="27">아마도 평안 평안히 잇소</sent><!--'평안 평안히'에서 뒤에 오는 '평안'은 재점(〃)으로 표기되어 있음-->
<sent type="main" lang="kor" page="05" n="28">을튝 구월 초뉵일</sent>
<sent type="main" lang="kor" page="05" n="29">동ᄉᆡᆼ 상인 영</sent>
</letter>

<letter n="06" sender="임영(남동생)" writer="임영(남동생)" receiver="나주임씨(막내누나)" year="1683~1686년">
<sent type="envelop1-1" lang="kor" page="06" n="01">누의님 젼 답소샹</sent>
<sent type="envelop1-1" lang="kor" page="06" n="02">됴 셔방 ᄃᆡᆨ</sent>
<sent type="main" lang="kor" page="06" n="03">몽필 부예□□오나늘</sent>
<sent type="main" lang="kor" page="06" n="04">칠□□□ 편지 보고 못내 든든ᄒᆞ나</sent><!--'든든ᄒᆞ나'에서 뒤에 오는 '든'은 재점(〃)으로 표기되어 있음-->
<sent type="main" lang="kor" page="06" n="05">곽난 듕 □□□낸가 시브니 놀납고 ᄆᆞ음 굿브며</sent>
<sent type="main" lang="kor" page="06" n="06">□예 니질 그저 채 ᄒᆞ리디 못ᄒᆞ엿ᄂᆞᆫ가</sent>
<sent type="main" lang="kor" page="06" n="07">□브니 ᄀᆞ장 념녀ᄒᆞᄂᆡ</sent>
<sent type="main" lang="kor" page="06" n="08">나ᄂᆞᆫ 시방 □□으로 머므니</sent>
<sent type="main" lang="kor" page="06" n="09">시월 초ᄉᆡᆼ이면 □□□고 도라갈가 시븨</sent>
<sent type="main" lang="kor" page="06" n="10">인녁이 하□□□□ 어궁히</sent>
<sent type="main" lang="kor" page="06" n="11">비록 산소 위ᄒᆞ온 일□□□히 안심티 아니ᄒᆡ</sent>
<sent type="main" lang="kor" page="06" n="12">이ᄃᆞᆯ 초ᄉᆡᆼ □□□ 아바님 ᄒᆡᆼᄎᆞ 도라가실 제 편지 잠 브□□더니</sent>
<sent type="main" lang="kor" page="06" n="13">본가 냥 셔방집도 올나가랴 □□니</sent>
<sent type="main" lang="kor" page="06" n="14">누의님도 ᄂᆞ려와셔 ᄒᆞᆫ ᄉᆞ이나 동ᄉᆡᆼ덜ᄀᆞ지나 모들가 ᄇᆞ라나</sent>
<sent type="main" lang="kor" page="06" n="15">셜온 고븨ᄂᆞᆫ 더옥 ᄀᆞ이업ᄉᆞᆯ가 ᄒᆞᄂᆡ </sent>
<sent type="main" lang="kor" page="06" n="16">산소의 ᄃᆞᆯ포 이시니 아쇠온 ᄆᆞ음의 퍽 □□ᄒᆞ나</sent>
<sent type="main" lang="kor" page="06" n="17">아마도 ᄆᆞ음을 위로ᄒᆞᆯ 길히 □고 </sent>
<sent type="main" lang="kor" page="06" n="18">이ᄒᆡ도 다 진ᄒᆞ여 가니 그립고 셜□ 못 견ᄃᆡᆯ쇠</sent>
<sent type="main" lang="kor" page="06" n="19">극진ᄒᆞ온 졍을 쇽□업시 긋처 ᄇᆞ리고</sent>
<sent type="main" lang="kor" page="06" n="20">혼자셔 나ᄃᆞᆯ□ 디내며 쵹쳐ᄋᆡ 셟고 졀박ᄒᆞ니□</sent>
<sent type="main" lang="kor" page="06" n="21">누의님내과 나 ᄒᆞᆫ ᄉᆞ이 모와</sent>
<sent type="main" lang="kor" page="06" n="22">셜□ 말이나 ᄒᆞ면 잠 나을가 ᄒᆞᄂᆡ</sent>
<sent type="main" lang="kor" page="06" n="23">마ᄌᆞᆷ 옛 냥반 과거 보라 셔울 가매 □□ᄂᆡ </sent>
<sent type="main" lang="kor" page="06" n="24">회진셔ᄂᆞᆫ 과거들을 □□기 ᄒᆞ고</sent>
<sent type="main" lang="kor" page="06" n="25">득닌 약닌 다 문무 초시를 ᄒᆞ니</sent>
<sent type="main" lang="kor" page="06" n="26">문운은 극통ᄒᆞ엿ᄂᆞᆫ가 시븨</sent>
<sent type="main" lang="kor" page="06" n="27">엇디 우리 ᄯᆞ려 이리 졀박은 화고을 만난고</sent>
<sent type="main" lang="kor" page="06" n="28">아마도 의약 인ᄉᆞ 잘못ᄒᆞᆫ 타신가</sent>
<sent type="main" lang="kor" page="06" n="29">더옥 통ᄒᆞᆫᄒᆞ여 ᄆᆞ음이 하 치이ᄂᆡ</sent>
<sent type="main" lang="kor" page="06" n="30">ᄉᆞ연 총총ᄒᆞ여 이만</sent><!--'총총ᄒᆞ여'에서 뒤에 오는 '총'은 재점(〃)으로 표기되어 있음-->
<sent type="main" lang="kor" page="06" n="31">구월 십뉵일</sent>
<sent type="main" lang="kor" page="06" n="32">동ᄉᆡᆼ 상□ □</sent>
</letter>

<letter n="07" sender="임영(남동생)" writer="임영(남동생)" receiver="나주임씨(막내누나)" year="1691년">
<sent type="main" lang="kor" page="07" n="01">편지 박산으로셔 년ᄒᆞ여 어더 보고 반기며</sent>
<sent type="main" lang="kor" page="07" n="02">예ᄂᆞᆫ 겨요 디내ᄂᆡ</sent>
<sent type="main" lang="kor" page="07" n="03">니현도 ᄉᆡᆼ도을 어덧ᄂᆡ</sent>
<sent type="main" lang="kor" page="07" n="04">회진 역질이 그만ᄒᆞᆯ가 시브니</sent>
<sent type="main" lang="kor" page="07" n="05">이ᄃᆞᆯ노 도라갈가 시븨</sent>
<sent type="main" lang="kor" page="07" n="06">경예ᄂᆞᆫ 마쳔ᄉᆞ 열뎐을 ᄂᆞ리 외오이고</sent>
<sent type="main" lang="kor" page="07" n="07">이제야 문션이나 닑히랴 ᄒᆞᄂᆡ</sent>
<sent type="main" lang="kor" page="07" n="08">겟 소망이 ᄆᆡ양 글편이 듕ᄒᆞ매</sent>
<sent type="main" lang="kor" page="07" n="09">이 톄 옛글을 더 슝샹ᄒᆞ기예</sent>
<sent type="main" lang="kor" page="07" n="10">경셔를 만히 닑히디 못ᄒᆞ니 앗가외</sent>
<sent type="main" lang="kor" page="07" n="11">문리ᄂᆞᆫ 젼년이예셔 퍽 엇ᄂᆡ</sent>
<sent type="main" lang="kor" page="07" n="12">짓기도 잘 지을가 시븨</sent>
<sent type="main" lang="kor" page="07" n="13">밧바 이만</sent>
<sent type="main" lang="kor" page="07" n="14">신미 삼 삼</sent><!--'삼 삼'에서 뒤에 오는 '삼'은 재점(〃)으로 표기되어 있음-->
<sent type="main" lang="kor" page="07" n="15">함□</sent>
</letter>

<letter n="08" sender="임영(남동생)" writer="임영(남동생)" receiver="나주임씨(막내누나)" year="1649~1696년">
<sent type="main" lang="kor" page="08" n="01">ᄉᆡᆼ각 밧긔 병환이 비경타 ᄒᆞ니 념 ᄀᆞ이업ᄂᆡ</sent>
<sent type="main" lang="kor" page="08" n="02">날이 져머시매</sent>
<sent type="main" lang="kor" page="08" n="03">죵을 보내디 못ᄒᆞ여</sent>
<sent type="main" lang="kor" page="08" n="04">밤의 편지ᄅᆞᆯ 겨유 뎌거 새벽 보내랴 ᄒᆞᄂᆡ</sent>
<sent type="main" lang="kor" page="08" n="05">념녀 ᄀᆞ이업ᄂᆡ</sent>
<sent type="main" lang="kor" page="08" n="06">아ᄒᆡ덜 ᄒᆞ여 증셰ᄅᆞᆯ ᄌᆞ시 보내랴 ᄒᆞᄂᆡ</sent>
<sent type="main" lang="kor" page="08" n="07">념녀 ᄀᆞ이업ᄂᆡ</sent>
<sent type="main" lang="kor" page="08" n="08">나ᄂᆞᆫ 두어 날 더욱 머리 알ᄒᆞ니</sent>
<sent type="main" lang="kor" page="08" n="09">민망ᄒᆡ 겨유 뎍ᄂᆡ</sent>
</letter>

<letter n="09" sender="임영(남동생)" writer="임영(남동생)" receiver="나주임씨(막내누나)" year="1649~1696년">
<sent type="envelop1-２" lang="kor" page="09" n="01">됴 셔방 ᄃᆡᆨ</sent>
<sent type="main" lang="kor" page="09" n="02">우리ᄂᆞᆫ ᄎᆞᆷ아□□□□□일절□□□□ 반혼 뫼셔 집의 도라오니</sent>
<sent type="main" lang="kor" page="09" n="03">강산과 집 거□□□□ 신쥬만 뫼시고 와셔 </sent>
<sent type="main" lang="kor" page="09" n="04">ᄎᆞᆷ아 어이 눈 드러 보ᄂᆞᆫ □□□</sent>
<sent type="main" lang="kor" page="09" n="05">셜운 졍ᄉᆞ과 ᄒᆡᆼ상 영장의 대쇼 ᄉᆞ셜이 만□□□□ᄃᆞ려 니를고</sent>
<sent type="main" lang="kor" page="09" n="06">누의님도 아니 이시니</sent>
<sent type="main" lang="kor" page="09" n="07">내 ᄆᆞ음을 더옥 죠곰도 의지ᄒᆞᆯ ᄃᆡ 업서 ᄒᆞᄂᆞᆫ 줄</sent>
<sent type="main" lang="kor" page="09" n="08">일뎡 각별 ᄉᆡᆼ각ᄒᆞᄂᆞᆫ가 ᄒᆞᄂᆡ</sent>
<sent type="main" lang="kor" page="09" n="09">발인 적 집 ᄯᅥ나 압강으로 나가던 일과</sent>
<sent type="main" lang="kor" page="09" n="10">은진 디날 적 산소 드러갈 적</sent>
<sent type="main" lang="kor" page="09" n="11">장ᄉᆞ 적 반혼□□□ 적</sent>
<sent type="main" lang="kor" page="09" n="12">집의 도라온 경샹은 초상의셔 다ᄅᆞᆫ 일이 업□□샹ᄒᆞ올 적은 극진이 ᄒᆞ와</sent>
<sent type="main" lang="kor" page="09" n="13">감ᄉᆞ도 ᄉᆞᆷ녜 나와셔 기들너 됴샹ᄒᆞ고 티뎐ᄒᆞ고</sent>
<sent type="main" lang="kor" page="09" n="14">담군 밧역냥 역군 각 관ᄋᆡ 극히 쥬족이 분뎡ᄒᆞ엿고</sent>
<sent type="main" lang="kor" page="09" n="15">초우 ᄌᆡ우 졔도 무안 함평의 뎡ᄒᆞ엿데 </sent>
<sent type="main" lang="kor" page="09" n="16">다 여셔 쳥티 아닌 거슬 당신 ᄉᆡᆼ각ᄒᆞ여 ᄒᆞ니 위연티 아니ᄒᆞ고</sent>
<sent type="main" lang="kor" page="09" n="17">각 관 슈령덜도 거의 다 디경의 와 마자 호상ᄒᆞ고</sent>
<sent type="main" lang="kor" page="09" n="18">길ᄀᆞ 아닌 슈령도 길노 나와 보ᄂᆞ니도 만ᄒᆞ고</sent>
<sent type="main" lang="kor" page="09" n="19">담군을 ᄇᆡᆨ여 명으로 가기의 보ᄂᆞᆫ 사ᄅᆞᆷ은 웅장이 녀기고</sent>
<sent type="main" lang="kor" page="09" n="20">비록 우리 ᄆᆞ음의도 □□□히 젹막디 아니시니</sent>
<sent type="main" lang="kor" page="09" n="21">그ᄂᆞᆫ 다ᄒᆡᆼᄒᆞ고</sent>
<sent type="main" lang="kor" page="09" n="22">군이 만ᄒᆞ고 영니ᄉᆡᆼ□□□□상ᄒᆞᄂᆞᆫ 사ᄅᆞᆷ이 다 극진 경틱ᄒᆞ고 조심ᄒᆞ기예</sent>
<sent type="main" lang="kor" page="09" n="23">놉ᄒᆞᆫ ᄃᆡ ᄂᆞᄌᆞᆫ ᄃᆡ 업시</sent>
<sent type="main" lang="kor" page="09" n="24">마치 평안ᄒᆞ긔 요둉티 아니셔 뫼시니</sent>
<sent type="main" lang="kor" page="09" n="25">실노 극진이 ᄒᆡᆼ상은 ᄒᆞ되</sent>
<sent type="main" lang="kor" page="09" n="26">일ᄉᆡᆼ 길 ᄃᆞᆫ닐 제 뫼셔 ᄃᆞᆫ니던 거시라</sent>
<sent type="main" lang="kor" page="09" n="27">가마 뒤ᄒᆡ셔 말ᄉᆞᆷ 못ᄒᆞᆯ ᄯᅢ 굼굼굼굼ᄒᆞ여 ᄒᆞ다가</sent><!--'굼굼굼굼ᄒᆞ여'에서 뒤에 오는 '굼'은 재점(〃)으로 표기되어 있음--><!--'굼굼굼굼ᄒᆞ여'에서 뒤에 오는 '굼'은 재점(〃)으로 표기되어 있음-->
<sent type="main" lang="kor" page="09" n="28">가마 브리면 ᄎᆞ례 못 ᄒᆞ여 보오면</sent>
<sent type="main" lang="kor" page="09" n="29">반갑던 일이 더옥 ᄉᆡᆼ각ᄒᆞ이여 셟기를 어이 니를고</sent>
<sent type="main" lang="kor" page="09" n="30">장ᄉᆞ도 ᄇᆡᆨ믈 쥬죡ᄒᆞᄒᆞ여</sent>
<sent type="main" lang="kor" page="09" n="31">감ᄉᆞ도 영미 석 셤을 각□ 관로 분뎡ᄒᆞ여 실녀 보내고</sent>
<sent type="main" lang="kor" page="09" n="32">그 고을덜도 각 ᄒᆞᆫ 셤□□내고</sent>
<sent type="main" lang="kor" page="09" n="33">다ᄅᆞᆫ ᄃᆡ셔도 ᄡᆞᆯ노 열ᄒᆞᆫ 셤이나 되고</sent>
<sent type="main" lang="kor" page="09" n="34">역군은 무뎡□히 □□게 ᄒᆞ매</sent>
<sent type="main" lang="kor" page="09" n="35">인녁으로 ᄒᆞᆯ 일은 극진이 ᄒᆞ니</sent>
<sent type="main" lang="kor" page="09" n="36">한아바님 장ᄉᆞ□을 우리게셔ᄂᆞᆫ □□내□□□□ 나더니</sent>
<sent type="main" lang="kor" page="09" n="37">이번은 비교티 못ᄒᆞ□□□□별ᄒᆞ온 거동이□…□아</sent>
<sent type="main" lang="kor" page="09" n="38">□…□ᄌᆞ니 망극ᄒᆞ더니</sent>
<sent type="main" lang="kor" page="09" n="39">홀연이□…□다시 보토ᄒᆞ고져 ᄒᆞᄂᆡ</sent>
<sent type="main" lang="kor" page="09" n="40">상돌도 비로시□…□로 드러와 ᄒᆞ고 </sent>
<sent type="main" lang="kor" page="09" n="41">원도 감ᄉᆞ의 말 아니 닐러셔 드려올□…□인ᄒᆞ여 ᄡᅳ든 못ᄒᆞᆯ가 시븨</sent>
<sent type="main" lang="kor" page="09" n="42">이ᄂᆞᆫ 다□…□광듕토식이 오□이 분명ᄒᆞ고 </sent>
<sent type="main" lang="kor" page="09" n="43">□강ᄒᆞ기 돌□□□ᄂᆞᆫ □…□창ᄒᆞ시다가</sent>
<sent type="main" lang="kor" page="09" n="44">쉬이 업스시믈□□블□□□□□가 ᄒᆞ여</sent>
<sent type="main" lang="kor" page="09" n="45">장일□…□</sent>
</letter>

<letter n="10" sender="임영(남동생)" writer="임영(남동생)" receiver="나주임씨(막내누나)" year="1649~1696년">
<sent type="main" lang="kor" page="10" n="01">시예ᄂᆞᆫ ᄒᆡ가 쾌히 비최니</sent>
<sent type="main" lang="kor" page="10" n="02">그ᄂᆞᆫ 극ᄒᆞᆫ 다ᄒᆡᆼ이레</sent>
<sent type="main" lang="kor" page="10" n="03">장ᄉᆞ 디낸 날 ᄃᆞᆯ도 ᄇᆞᆰ던 거시어니와 </sent>
<sent type="main" lang="kor" page="10" n="04">새볘 ᄯᅢ 뇌뎡이 진동ᄒᆞ니 </sent>
<sent type="main" lang="kor" page="10" n="05">그ᄯᅢ 셟고 안심티 아니키를 어이 다 니를고</sent>
<sent type="main" lang="kor" page="10" n="06">비 ᄌᆞ로 오ᄃᆡ 죵시 일의 해롭긔 아니ᄒᆞ니 </sent>
<sent type="main" lang="kor" page="10" n="07">그ᄂᆞᆫ 더옥 공교로온 듯ᄒᆞ여 다ᄒᆡᆼᄒᆞ데</sent>
<sent type="main" lang="kor" page="10" n="08">디내ᄂᆞᆫ 일이 다 ᄎᆞᆷ아 못ᄒᆞᆯ 일이나</sent>
<sent type="main" lang="kor" page="10" n="09">그 듕의 낭패ᄒᆞᄂᆞᆫ ᄆᆞᄃᆡ나 업서</sent>
<sent type="main" lang="kor" page="10" n="10">송둉 대ᄉᆞᄂᆞᆫ 그리 미진ᄒᆞᆫ 일이 업ᄉᆞ니</sent>
<sent type="main" lang="kor" page="10" n="11">이ᄂᆞᆫ 어마님 젹션ᄒᆞ신 덕인가 ᄒᆞᄂᆡ </sent>
<sent type="main" lang="kor" page="10" n="12">나도 실노 견ᄃᆡ여 나디 못ᄒᆞᆯ □□더니 </sent>
<sent type="main" lang="kor" page="10" n="13">길희셔 눈믈과 ᄯᆞᆷ의 ᄂᆞᆺ가족이 부뤄셔 다 버서디고</sent>
<sent type="main" lang="kor" page="10" n="14">산소□□□간 날은 밤의 오좀을 다 ᄡᆞ되 </sent>
<sent type="main" lang="kor" page="10" n="15">원긔 각별 대패ᄒᆞ든 안니ᄒᆞ여시니</sent>
<sent type="main" lang="kor" page="10" n="16">몸숨이 질긔거나 도으시ᄂᆞᆫ 일이 잇ᄂᆞᆫ가</sent>
<sent type="main" lang="kor" page="10" n="17">그런 의외 업ᄂᆡ</sent>
<sent type="main" lang="kor" page="10" n="18">단오 미처 ᄂᆞ려가려 ᄒᆞ니</sent>
<sent type="main" lang="kor" page="10" n="19">예셔 스므닐엔날 ᄯᅥ나가셔 졔ᄉᆞ 디내고 </sent>
<sent type="main" lang="kor" page="10" n="20">수일이나 쉬여 올 거시니</sent>
<sent type="main" lang="kor" page="10" n="21">ᄂᆡ월 망간으로 도라올가 시븨</sent>
<sent type="main" lang="kor" page="10" n="22">누의님은 병이 ᄆᆞ이 든가 시브니</sent>
<sent type="main" lang="kor" page="10" n="23">브ᄃᆡ ᄆᆞ음을 진뎡ᄒᆞ여 수이 셩ᄒᆞ여 낫다가</sent>
<sent type="main" lang="kor" page="10" n="24">겨을노나 ᄂᆞ려와 ᄃᆞᆫ녀가소</sent>
<sent type="main" lang="kor" page="10" n="25">냥집도 오랴 ᄒᆞ데</sent>
<sent type="main" lang="kor" page="10" n="26">경예ᄂᆞᆫ 누의님 올 제 더브러 와셔 관셰ᄒᆞ여 두거나</sent>
<sent type="main" lang="kor" page="10" n="27">도로 ᄃᆞ려가거나 ᄒᆞ미 편당ᄒᆞᆯ가 시븨</sent>
<sent type="main" lang="kor" page="10" n="28">누의님 젼의 ᄒᆞᆫ 편지과 이번 편지 다 ᄌᆞ시 보고</sent>
<sent type="main" lang="kor" page="10" n="29">셜온 ᄉᆞ셜이나 보니 □□ᄒᆞ여 ᄒᆞᄂᆡ</sent>
<sent type="main" lang="kor" page="10" n="30">경예 젼의 편지ᄒᆞ여시니 반기며 슬퍼ᄒᆞᄂᆡ </sent>
<sent type="main" lang="kor" page="10" n="31">장ᄉᆞ 디내온 날 ᄭᅮᆷ의 분영이 흐므시 뵈오니</sent>
<sent type="main" lang="kor" page="10" n="32">밧 가온 ᄯᅢ 발 벗톄 누어 겨시거늘</sent>
<sent type="main" lang="kor" page="10" n="33">내 ᄂᆞᆺᄎᆞ로 발을 부븨슷츠니</sent>
<sent type="main" lang="kor" page="10" n="34">초상 적과 달라 발이 부드러워 겨시니</sent>
<sent type="main" lang="kor" page="10" n="35">그ᄂᆞᆫ 길ᄒᆞᆫ ᄭᅮᆷ인 듯ᄒᆞ데</sent>
<sent type="main" lang="kor" page="10" n="36">앗가 낫 ᄭᅮᆷ을 ᄀᆞᆺ ᄭᅮ엇더니</sent>
<sent type="main" lang="kor" page="10" n="37">자ᄂᆡ 편지를 보니 아ᄅᆞ시미 잇ᄂᆞᆫ가</sent>
<sent type="main" lang="kor" page="10" n="38">셜운 듕 일변 든든ᄒᆡ</sent><!--'든든ᄒᆡ'에서 뒤에 오는 '든'은 재점(〃)으로 표기되어 있음-->
<sent type="main" lang="kor" page="10" n="39">산소 가기의 오래 편지도 못 ᄒᆞᆯ가 ᄒᆞ여</sent>
<sent type="main" lang="kor" page="10" n="40">졍신도 어즐ᄒᆞ되 강잉ᄒᆞ여 뎍ᄂᆡ</sent>
<sent type="main" lang="kor" page="10" n="41">ᄉᆞ월 시구일</sent>
<sent type="main" lang="kor" page="10" n="42">동ᄉᆡᆼ 영</sent>
</letter>

<letter n="11" sender="임영(남동생)" writer="임영(남동생)" receiver="나주임씨(막내누나)" year="1683~1686년">
<sent type="envelop1-1" lang="kor" page="11" n="01">누의님 젼 소샹</sent>
<sent type="envelop1-1" lang="kor" page="11" n="02">됴 셔방 ᄃᆡᆨ</sent>
<sent type="main" lang="kor" page="11" n="03">금졍 ᄒᆡᆼᄎᆞ 오실 적 만ᄒᆞᆫ 편지 ᄌᆞ시 □□ 본 듯 든든ᄒᆞ나</sent><!--'든든ᄒᆞ나'에서 뒤에 오는 '든'은 재점(〃)으로 표기되어 있음-->
<sent type="main" lang="kor" page="11" n="04">가ᄂᆞᆫ 사ᄅᆞᆷ 업다 ᄒᆞ매 □장도 □□□고 섭섭ᄒᆞ여 ᄒᆞ더니</sent><!--'섭섭ᄒᆞ여'에서 뒤에 오는 '섭'은 재점(〃)으로 표기되어 있음-->
<sent type="main" lang="kor" page="11" n="05">□□ 하인 □□ᄃᆡ ᄯᅩ 답장 어□ 보□□□ 반갑기 ᄌᆞ연티 아니ᄃᆡ</sent>
<sent type="main" lang="kor" page="11" n="06">그 후 하□ 일졀 업ᄉᆞ니 섭섭ᄒᆞᆫ 듕 아니 셜□ 일이 업ᄂᆡ</sent><!--'섭섭ᄒᆞᆫ'에서 뒤에 오는 '섭'은 재점(〃)으로 표기되어 있음-->
<sent type="main" lang="kor" page="11" n="07">우리ᄂᆞᆫ 계요 디내□□</sent>
<sent type="main" lang="kor" page="11" n="08">ᄃᆞ리 오라가니 ᄌᆞ연 ᄆᆞ음이 녜ᄉᆞ□ᄒᆞ여 □□히여 니치일 셰</sent>
<sent type="main" lang="kor" page="11" n="09">이시□□ 각고 셜워 ᄒᆞ다 쇼졀 이실가마ᄂᆞᆫ  </sent>
<sent type="main" lang="kor" page="11" n="10">졈□ 녜일ᄀᆞ티 되여 가ᄂᆞᆫ 줄이 더옥 더 □샹코</sent>
<sent type="main" lang="kor" page="11" n="11">셜위 경예 말 드르니</sent>
<sent type="main" lang="kor" page="11" n="12">더옥 □잉 어엿븨 글도 잘 지엇다 니르□□□와</sent>
<sent type="main" lang="kor" page="11" n="13">그리 급박히 ᄎᆡᆨ망ᄒᆞ여ᄂᆞᆫ □□ 못 될 거슬</sent>
<sent type="main" lang="kor" page="11" n="14">엇디 그리ᄒᆞᄂᆞᆫ고 모롤쇠</sent>
<sent type="main" lang="kor" page="11" n="15">진셔 편지예 잠ᄭᅡᆫ 그리 말 줄을 범논ᄒᆞ여 긔별ᄒᆞᄂᆡ</sent>
<sent type="main" lang="kor" page="11" n="16">죵슈ᄂᆞᆫ 글시도 이제□ ᄂᆡ도 □□엿고</sent>
<sent type="main" lang="kor" page="11" n="17">글도 잘□다 ᄒᆞ기예</sent>
<sent type="main" lang="kor" page="11" n="18">저도 흥심을 내여서 젼일히 ᄇᆡ홀 ᄲᅮᆫ 아니라</sent>
<sent type="main" lang="kor" page="11" n="19">왼갓 글ᄋᆡ 시비 논난이 어궁ᄒᆞ고</sent>
<sent type="main" lang="kor" page="11" n="20">잇다감 긔특ᄒᆞᆫ 소견이 이시니</sent><!--'소견이 이시니'에서 뒤에 오는 '이'는 재점(〃)으로 표기되어 있음-->
<sent type="main" lang="kor" page="11" n="21">ᄆᆡ양 경예를 더옥 ᄉᆡᆼ각ᄒᆞᄂᆡ</sent>
<sent type="main" lang="kor" page="11" n="22">겨을ᄒᆡ ᄂᆞ려올 말은 여러 번 ᄒᆞ되</sent>
<sent type="main" lang="kor" page="11" n="23">답말이 업ᄉᆞ니 게셔 아직 들머기디 아니매 그런가 답답ᄒᆞ여 ᄒᆞ외</sent><!--'답답ᄒᆞ여'에서 뒤에 오는 '답'은 재점(〃)으로 표기되어 있음-->
<sent type="main" lang="kor" page="11" n="24">젼나도 긔별은 요ᄉᆞ이ᄂᆞᆫ 바히 업ᄂᆡ </sent>
<sent type="main" lang="kor" page="11" n="25">니현ᄋᆡ 병은 엇더ᄒᆞ엿다 ᄒᆞᄂᆞᆫ고</sent>
<sent type="main" lang="kor" page="11" n="26">이 편지 뎐ᄒᆞ여 주소</sent>
<sent type="main" lang="kor" page="11" n="27">황ᄒᆡ 감ᄉᆡ 뎡지환을 급급히 지어 보내여시니</sent><!--'급급히'에서 뒤에 오는 '급'은 재점(〃)으로 표기되어 있음-->
<sent type="main" lang="kor" page="11" n="28">고마외 잇다감 왕ᄂᆡ에 게도 아ᄒᆡ나 주게</sent>
<sent type="main" lang="kor" page="11" n="29">과즐 닙히나 가ᄂᆞᆫ가</sent>
<sent type="main" lang="kor" page="11" n="30">그리□□□ 니저 ᄒᆞ시던 거슬 ᄂᆞᆷᄋᆡ □□□□듯ᄒᆞ니</sent>
<sent type="main" lang="kor" page="11" n="31">불샹ᄒᆡ □□ □가매 잠 뎍ᄂᆡ</sent>
<sent type="main" lang="kor" page="11" n="32">뉵월 초뉵</sent>
<sent type="main" lang="kor" page="11" n="33">□□□</sent>
</letter>

<letter n="12" sender="임영(남동생)" writer="임영(남동생)" receiver="나주임씨(막내누나)" year="1649~1696년">
<sent type="envelop1-1" lang="kor" page="12" n="01">누의님 젼 답소샹</sent>
<sent type="envelop1-1" lang="kor" page="12" n="02">근봉</sent>
<sent type="main" lang="kor" page="12" n="03">하 오래 쇼식 몰나</sent>
<sent type="main" lang="kor" page="12" n="04">금졍으로 유무ᄒᆞ여 보내엿더니</sent>
<sent type="main" lang="kor" page="12" n="05">겟 편지을 뎐ᄒᆞ셔늘</sent>
<sent type="main" lang="kor" page="12" n="06">두 슌 뎐 온 것 ᄌᆞ시 보고 못내 싀훤 든든ᄒᆞ나</sent><!--'든든ᄒᆞ나'에서 뒤에 오는 '든'은 재점(〃)으로 표기되어 있음-->
<sent type="main" lang="kor" page="12" n="07">ᄉᆞ연 볼 적마다 새로이 셜워 ᄒᆞᄂᆡ</sent>
<sent type="main" lang="kor" page="12" n="08">예ᄂᆞᆫ 대되 무ᄉᆞᄒᆞ되</sent>
<sent type="main" lang="kor" page="12" n="09">오시 복학이 지금 채 ᄒᆞ리디 아니ᄒᆞ이 글노 념녀ᄒᆞᄂᆡ</sent>
<sent type="main" lang="kor" page="12" n="10">젼라도 긔별 오월 두경 ᄃᆞᆫ녀온 후ᄂᆞᆫ 다시 왕ᄂᆡ 업스니</sent>
<sent type="main" lang="kor" page="12" n="11">아모 쇼식도 모롤쇠</sent>
<sent type="main" lang="kor" page="12" n="12">ᄂᆡ월 열흘ᄭᅴ 내 ᄂᆞ려갈 거시니</sent>
<sent type="main" lang="kor" page="12" n="13">그 미처 편지나 ᄒᆞ여 보내소</sent>
<sent type="main" lang="kor" page="12" n="14">셔울 긔별은 자ᄂᆡ 편지도 보고 듀닌도 잇다감 긔별ᄒᆞ매</sent>
<sent type="main" lang="kor" page="12" n="15">약간 드르니 시절이 긔괴ᄒᆞ엿ᄂᆞᆫ가 시브니</sent>
<sent type="main" lang="kor" page="12" n="16">그런 한심ᄒᆞᆫ 일이 업ᄂᆡ</sent>
<sent type="main" lang="kor" page="12" n="17">예도 요ᄉᆞ이ᄂᆞᆫ 우슈 뎍듕ᄒᆞ되</sent>
<sent type="main" lang="kor" page="12" n="18">이 압 들흔 믈이 세 번재 ᄭᅵ이니 못 먹을 ᄃᆡ 만ᄒᆞ고</sent>
<sent type="main" lang="kor" page="12" n="19">냥도 어ᄂᆡ 어려올가 시브니</sent>
<sent type="main" lang="kor" page="12" n="20">오래 잇기도 뎡티 못ᄒᆞᆯ가 시븨</sent>
<sent type="main" lang="kor" page="12" n="21">홍 셔방집을 ᄂᆡ월 초ᄉᆡᆼ 가 더브러 오랴 ᄒᆞ니</sent>
<sent type="main" lang="kor" page="12" n="22">더옥 젼의 누의님 못 ᄃᆞ려와 ᄒᆞ시던 일이 ᄉᆡᆼ각ᄒᆞ이며</sent>
<sent type="main" lang="kor" page="12" n="23">아모 일도 하 믯믯 쉽살ᄒᆞ니</sent><!--'믯믯'에서 뒤에 오는 '믯'은 재점(〃)으로 표기되어 있음-->
<sent type="main" lang="kor" page="12" n="24">어이 젼의ᄂᆞᆫ 그리 ᄆᆡᄉᆡ 어렵돗던고 ᄒᆞᄂᆡ</sent>
<sent type="main" lang="kor" page="12" n="25">자고 새여 새나 ᄃᆞᆯ만 보고</sent>
<sent type="main" lang="kor" page="12" n="26">아므 곳도 졍 ᄆᆞ음 펼 곳시 업스니</sent>
<sent type="main" lang="kor" page="12" n="27">일신을 텰업서 이다감 혼자 울고 안잣ᄂᆡ</sent>
<sent type="main" lang="kor" page="12" n="28">젼 □지과 이 편지 ᄒᆞᆫ가지로 뎐ᄒᆞ여 갈 법 잇ᄂᆞ니</sent>
<sent type="main" lang="kor" page="12" n="29">□장 쉬이 볼가 기드리ᄂᆡ</sent>
<sent type="main" lang="kor" page="12" n="30">경여ᄂᆞᆫ 그리 날을 닛□□니 ᄒᆞᄂᆞᆫ가 시브니 </sent>
<sent type="main" lang="kor" page="12" n="31">어엿브고 일변 블샹ᄒᆞ여 ᄒᆞᄂᆡ</sent>
<sent type="main" lang="kor" page="12" n="32">골샹이 그만ᄒᆞ고 글을 못ᄒᆞᆫ가</sent>
<sent type="main" lang="kor" page="12" n="33">제 글시ᄂᆞᆫ 됴코 글도 잘 지엇□</sent>
<sent type="main" lang="kor" page="12" n="34">그 슈지ᄂᆞᆫ 즉시 업시 ᄒᆞ엿ᄂᆡ</sent>
<sent type="main" lang="kor" page="12" n="35">그리 당부 아니ᄒᆞ다</sent>
<sent type="main" lang="kor" page="12" n="36">그 쳥이□ ᄌᆞᆨ히 쉬올가</sent>
<sent type="main" lang="kor" page="12" n="37">부체 올흔 마치 세 곳셔 왓거늘</sent>
<sent type="main" lang="kor" page="12" n="38">ᄒᆞᆫ 곳 치을 두엇더니 □□니</sent>
<sent type="main" lang="kor" page="12" n="39">니 세 ᄌᆞᄅᆞ 자ᄂᆡ 가지고 두 ᄌᆞᄅᆞ란 내 말노 니현 주소</sent>
<sent type="main" lang="kor" page="12" n="40">대녜란 홍집 올 제 블너오고 시븨</sent>
<sent type="main" lang="kor" page="12" n="41">ᄉᆞ연 다 못 뎍어 이만</sent>
<sent type="main" lang="kor" page="12" n="42">윤월 초십일</sent>
<sent type="main" lang="kor" page="12" n="43">동ᄉᆡᆼ □□□</sent>
<sent type="main" lang="kor" page="12" n="44">남한□□ᄒᆞ니 뎐□ 긔서 편□로 슝슝□ 답장 못□</sent><!--'슝슝□'에서 뒤에 오는 '슝'은 재점(〃)으로 표기되어 있음-->
</letter>

<letter n="13" sender="임영(남동생)" writer="임영(남동생)" receiver="나주임씨(막내누나)" year="1649~1696년">
<sent type="main" lang="kor" page="13" n="01">이 사ᄅᆞᆷ의 보롬날 편지 보고 든든ᄒᆞ되 </sent><!--'든든ᄒᆞ되'에서 뒤에 오는 '든'은 재점(〃)으로 표기되어 있음-->
<sent type="main" lang="kor" page="13" n="02">경예 니질이 비경ᄒᆞ던가 시브니</sent>
<sent type="main" lang="kor" page="13" n="03">디난 일이나 놀납기 ᄀᆞ업고</sent>
<sent type="main" lang="kor" page="13" n="04">이제도 채 ᄒᆞ리디 못ᄒᆞ엿ᄂᆞᆫ가 시브니 념녀ᄒᆞ며</sent>
<sent type="main" lang="kor" page="13" n="05">녜 일이 다 업서시니 ᄌᆞᆨ히 념녀ᄒᆞ실가마ᄂᆞᆫ </sent>
<sent type="main" lang="kor" page="13" n="06">ᄂᆞᆷ의 집 일 ᄀᆞᆺᄒᆞ니 더옥 블샹ᄒᆡ</sent>
<sent type="main" lang="kor" page="13" n="07">이제나 채 ᄒᆞ렷ᄂᆞᆫ가 ᄒᆞ려셔</sent>
<sent type="main" lang="kor" page="13" n="08">내게 편지ᄒᆞ기를 벼로ᄂᆞᆫ가 시브니 어엿버 ᄒᆞᄂᆡ</sent>
<sent type="main" lang="kor" page="13" n="09">나ᄂᆞᆫ 내내 셩ᄒᆞ더니</sent><!--'내내'에서 뒤에 오는 '내'는 재점(〃)으로 표기되어 있음-->
<sent type="main" lang="kor" page="13" n="10">이 초열흘셔븟터 음식를 못 먹고 더위예 보채이여</sent>
<sent type="main" lang="kor" page="13" n="11">더위예 보채이여 긔운이 심히 아니ᄭᅩ와</sent>
<sent type="main" lang="kor" page="13" n="12">이제도 ᄒᆞ리디 못ᄒᆞ여시니 민망ᄒᆡ</sent>
<sent type="main" lang="kor" page="13" n="13">계금이가 도망질ᄒᆞ엿던가 시브니</sent>
<sent type="main" lang="kor" page="13" n="14">통분ᄒᆡ 일뎡 도적질ᄒᆞ기예 덧드러나셔 그 노릇슬 ᄒᆞ엿던가 ᄒᆞ며</sent>
<sent type="main" lang="kor" page="13" n="15">임ᄉᆡᆼ의게도 당부ᄂᆞᆫ ᄒᆞ려니와</sent>
<sent type="main" lang="kor" page="13" n="16">실은 도망ᄒᆞᆫ들 제 바로 ᄂᆞ려가기 쉬올가 </sent>
<sent type="main" lang="kor" page="13" n="16">아모커나 죄 줄 제 주어도 샹시예 온졍을 두게 브려 보소</sent>
<sent type="main" lang="kor" page="13" n="17">니현ᄋᆡ 병은 이번 편지예ᄂᆞᆫ 잠 나엇ᄂᆞᆫ ᄃᆞ시 ᄒᆞ여시나</sent>
<sent type="main" lang="kor" page="13" n="18">턍증이 일양이로라 ᄒᆞ엿ᄂᆡ</sent>
<sent type="main" lang="kor" page="13" n="19">자ᄂᆡ ᄂᆞ려올 제 ᄂᆞ려오나지라 ᄒᆞ여시니 </sent>
<sent type="main" lang="kor" page="13" n="20">일뎡 제 집의 잇기도 어려워 그리ᄒᆞ엿ᄂᆞᆫ가 시븨</sent>
<sent type="main" lang="kor" page="13" n="21">예도 번노ᄒᆞ고 형셰 됴티 아니커니와</sent>
<sent type="main" lang="kor" page="13" n="22">ᄆᆡ양 가실 거시 아니니</sent><!--'아니니'에서 뒤에 오는 '니'는 재점(〃)으로 표기되어 있음-->
<sent type="main" lang="kor" page="13" n="23">닐 보와셔 그리ᄒᆞ고도 시븨 대예도 뎌를 ᄂᆞ리와 오게 되면 </sent>
<sent type="main" lang="kor" page="13" n="24">아직 갓ᄂᆞ니 그만ᄒᆞ여 두고 시븨</sent>
<sent type="main" lang="kor" page="13" n="25">홍집 더블러 초ᄉᆡᆼ의 사ᄅᆞᆷ 갈 거시니 그제 ᄯᅩ 아니 뎍을가</sent>
<sent type="main" lang="kor" page="13" n="26">ᄉᆞ연 다 못 뎍어 이만</sent>
<sent type="main" lang="kor" page="13" n="27">아마도 아ᄒᆡ 수이 ᄒᆞ리고</sent>
<sent type="main" lang="kor" page="13" n="28">누의님 몸도 조심ᄒᆞ여 이시소</sent>
<sent type="main" lang="kor" page="13" n="29">윤월 념이일</sent>
<sent type="main" lang="kor" page="13" n="30">동ᄉᆡᆼ 영</sent>
<sent type="main" lang="kor" page="13" n="31">젼라도 긔별 지금 못 드럿ᄂᆡ</sent>
</letter>

<letter n="14" sender="임영(남동생)" writer="임영(남동생)" receiver="나주임씨(막내누나)" year="1649~1696년">
<sent type="main" lang="kor" page="14" n="01">ᄯᅥ날 제 망극ᄒᆞ던 일이야</sent>
<sent type="main" lang="kor" page="14" n="02">어이 다 형용ᄒᆞ며</sent>
<sent type="main" lang="kor" page="14" n="03">서ᄅᆞ 니를 말이 □다가 못 ᄒᆞ여</sent>
<sent type="main" lang="kor" page="14" n="04">안ᄒᆡ 드러와 건넌 방ᄋᆡ 바자니며</sent>
<sent type="main" lang="kor" page="14" n="05">ᄒᆞᆫ갓 곡□□□ 집안히 다 뷘 듯ᄒᆞ고</sent>
<sent type="main" lang="kor" page="14" n="06">안잔최 그처디니</sent>
<sent type="main" lang="kor" page="14" n="07">어이 ᄒᆞᆫ갓 동ᄉᆡᆼ ᄯᅥ□□고</sent>
<sent type="main" lang="kor" page="14" n="08">길ᄒᆡ셔 뎍은 것 보고 더욱 블샹ᄒᆞ며</sent>
<sent type="main" lang="kor" page="14" n="09">이제ᄂᆞᆫ ᄇᆞᆯ셔 두□□</sent>
<sent type="main" lang="kor" page="14" n="10">브질업슨 디난 일 애ᄃᆞ디 말고</sent>
<sent type="main" lang="kor" page="14" n="11">몸이나 잘 됴리ᄒᆞ여 잇다가</sent>
<sent type="main" lang="kor" page="14" n="12">겨을□ᄅᆡ ᄂᆞ려오소</sent>
<sent type="main" lang="kor" page="14" n="13">발인이 수일이 격ᄒᆞ여 겨시니</sent>
<sent type="main" lang="kor" page="14" n="14">졀졀이 못 견ᄃᆡᆫ 일□산흔날 결관ᄒᆞ엿ᄉᆞᆸᄂᆡ</sent><!--'졀졀이'에서 뒤에 오는 '졀'은 재점(〃)으로 표기되어 있음-->
<sent type="main" lang="kor" page="14" n="15">ᄇᆡ짐이 드러오니 더옥 ᄆᆞ음이 ᄀᆞ이□나ᄒᆡ </sent>
<sent type="main" lang="kor" page="14" n="16">동ᄉᆡᆼ이 만ᄒᆞ나 안말ᄒᆞ기 누의과 ᄀᆞᆺ디 아니ᄒᆞ고</sent>
<sent type="main" lang="kor" page="14" n="17">병□□나 다시 아ᄂᆞ니 업ᄉᆞ니</sent>
<sent type="main" lang="kor" page="14" n="18">ᄆᆞ음을 더옥 브텨 여러 볼 셰 □□도</sent>
<sent type="main" lang="kor" page="14" n="19">내 궁독ᄒᆞᆫ 신셰예 ᄃᆞᆯ닌 일인가 ᄒᆞ여 </sent>
<sent type="main" lang="kor" page="14" n="20">ᄒᆞᆯ 말이 극히 만□니 언문 편지를 사 ᄡᅳ랴 ᄒᆞ니</sent>
<sent type="main" lang="kor" page="14" n="21">주술이 고슈ᄒᆞ이여 못 다 뎍을ᄉᆡ 몸은 무ᄉᆞᄒᆞᄂᆡ</sent>
<sent type="main" lang="kor" page="14" n="22">대경이 수일을 눅눅 증으로 ᄆᆡ이 알파ᄒᆞ더니 □야 퍽 나엇ᄂᆡ</sent><!--'눅눅'에서 뒤에 오는 '눅'은 재점(〃)으로 표기되어 있음-->
<sent type="main" lang="kor" page="14" n="23">아모려나 사랏다가 쉬이 다시 만날가 ᄇᆞ라ᄂᆡ</sent>
<sent type="main" lang="kor" page="14" n="24">삼월 념오일</sent>
<sent type="main" lang="kor" page="14" n="25">동ᄉᆡᆼ □</sent>
<sent type="main" lang="kor" page="14" n="26">누의님 간 후 곳치 더어 궁셩ᄒᆞ니</sent>
<sent type="main" lang="kor" page="14" n="27">이런 거동을 ᄃᆡᄒᆞ여 □□견ᄃᆡᄂᆞᆫ 거신고</sent>
<sent type="main" lang="kor" page="14" n="28">뎐뎐 드르니 ᄉᆞ신 ᄒᆡᆼ듕ᄋᆡ 몽고반ᄒᆞ여 북□잇다 갈 이 이시니</sent><!--'뎐뎐'에서 뒤에 오는 '뎐'은 재점(〃)으로 표기되어 있음-->
<sent type="main" lang="kor" page="14" n="29">그러면 예 잇기도 오라기를 뎡티 못□</sent>
<sent type="main" lang="kor" page="14" n="30">장은 예 이신 제 못 밋처 어더 보려니와</sent>
<sent type="main" lang="kor" page="14" n="31">후의 편지ᄒᆞ□□이나 ᄌᆞ시 ᄒᆞ과뎌 ᄒᆞᄂᆡ</sent>
</letter>

<letter n="15" sender="임영(남동생)" writer="임영(남동생)" receiver="나주임씨(막내누나)" year="1683~1686년">
<sent type="envelop1-1" lang="kor" page="15" n="01">누의님 젼 소샹 셔방 ᄃᆡᆨ</sent>
<sent type="envelop1-1" lang="kor" page="15" n="02">봉</sent>
<sent type="main" lang="kor" page="15" n="03">금졍으로 두 슌 편지ᄒᆞ엿더니</sent>
<sent type="main" lang="kor" page="15" n="04">몬져 볼가 ᄒᆞ며 금쇠 뫼임 ᄃᆞᆫ니러 가매 ᄯᅩ 뎍ᄂᆡ</sent>
<sent type="main" lang="kor" page="15" n="05">예ᄂᆞᆫ 아직 대되 평안ᄒᆞ되</sent>
<sent type="main" lang="kor" page="15" n="06">내가 요ᄉᆞ이 ᄇᆞ람도 ᄆᆡ이 불매 ᄇᆞ람 ᄡᅩ여 그런디 머리도 앏프고</sent>
<sent type="main" lang="kor" page="15" n="07">어제 밤을 바히 자디 못ᄒᆞ여 몸이 대셩티 아니ᄒᆞ니 민망ᄒᆡ</sent>
<sent type="main" lang="kor" page="15" n="08">밥을 샹시도곤 더 잘 먹으매 긔운이 나을가 ᄒᆞ더니</sent>
<sent type="main" lang="kor" page="15" n="09">너모 잘 먹ᄂᆞᆫ 것도 병이런가 시븨</sent>
<sent type="main" lang="kor" page="15" n="10">젼나도 긔별 지금 못 드럿ᄂᆡ</sent>
<sent type="main" lang="kor" page="15" n="11">셔울 말은 자ᄂᆡ야 잘 어더 듯ᄂᆞᆫ가 시브니</sent>
<sent type="main" lang="kor" page="15" n="12">겸ᄉᆞ 말고 드른 말이어든 긔별ᄒᆞ소</sent>
<sent type="main" lang="kor" page="15" n="13">죠ᄒᆡ ᄒᆞᆫ 봉 젼라 감ᄉᆡ 보내엿거늘</sent>
<sent type="main" lang="kor" page="15" n="14">보내니 세 권이니 ᄒᆞᆫ 권은 자ᄂᆡ ᄡᅳ고</sent>
<sent type="main" lang="kor" page="15" n="15">ᄒᆞᆫ 권은 경예 주고 ᄒᆞᆫ 권 니현 주소</sent>
<sent type="main" lang="kor" page="15" n="16">밧브고 긔운도 블평ᄒᆞ여 잠 뎍ᄂᆡ</sent>
<sent type="main" lang="kor" page="15" n="17">계춘월 십삼</sent>
<sent type="main" lang="kor" page="15" n="18">동ᄉᆡᆼ 상인</sent>
</letter>

<letter n="16" sender="임영(남동생)" writer="임영(남동생)" receiver="나주임씨(막내누나)" year="1649~1696년">
<sent type="main" lang="kor" page="16" n="01">소식 젼의 ᄒᆞ□□□□ 편지ᄒᆞ엿더니 몬뎌□□□ ᄒᆞ며</sent>
<sent type="main" lang="kor" page="16" n="02">요ᄉᆞ이 고이ᄒᆞᆫ ᄇᆞ람ᄋᆡ □…□</sent>
<sent type="main" lang="kor" page="16" n="03">□…□ 뫼셔 평안이 디내ᄂᆞᆫ가 념녀 닛디 못ᄒᆞᄂᆡ</sent>
<sent type="main" lang="kor" page="16" n="04">나ᄂᆞᆫ □□□□내나 오ᄂᆡ</sent>
<sent type="main" lang="kor" page="16" n="05">복학이 지금 ᄒᆞ리디 못ᄒᆞ여 날□□□□□ᄂᆞᆫᄃᆡ</sent>
<sent type="main" lang="kor" page="16" n="06">긔약도 못 ᄒᆞ고 두워시니 그런 민망 념녜 □□</sent>
<sent type="main" lang="kor" page="16" n="07">경예ᄂᆞᆫ 됴히 잇ᄂᆞᆫ가</sent>
<sent type="main" lang="kor" page="16" n="08">몽필이 퍽 느□…□지ᄒᆞᆫ□□□□□으리ᄂᆞᆫ 이런 □…□낫디 아니 □…□난ᄒᆞ여□…□</sent>
<sent type="main" lang="kor" page="16" n="09">졈졈 후 □…□ 편지 ᄒᆞᆫ 댱도 □…□ 듕난티 박기ᄂᆡ</sent><!--'졈졈'에서 뒤에 오는 '졈'은 재점(〃)으로 표기되어 있음-->
<sent type="main" lang="kor" page="16" n="10">ᄉᆞ연도 다 못 ᄒᆞ니 ᄆᆡ양 □□□□□ᄂᆡ </sent>
<sent type="main" lang="kor" page="16" n="11">예셔ᄂᆞᆫ 녀ᄅᆞᆷ지ᄂᆞᆫ 것도 업서</sent>
<sent type="main" lang="kor" page="16" n="12">죵이□…□ 무임 가 보리나 어더시라 오나디라 □…□</sent>
<sent type="main" lang="kor" page="16" n="13">밧바 잠□□□□□마도 ᄆᆡ일 자러 □…□</sent>
</letter>

<letter n="17" sender="임영(남동생)" writer="임영(남동생)" receiver="나주임씨(막내누나)" year="1683~1686년">
<sent type="envelop1-1" lang="kor" page="17" n="01">누의님 젼 답소샹</sent>
<sent type="envelop1-1" lang="kor" page="17" n="02">됴 셔방 ᄃᆡᆨ</sent>
<sent type="main" lang="kor" page="17" n="03">뇽산 올 적 두 가지 편지과 이번 금졍 편의 ᄒᆞᆫ 편지 다 낫낫 ᄌᆞ시 보고 업시ᄒᆞ라 ᄒᆞᆫ 거슨 즉시 업시 ᄒᆞ엿ᄂᆡ</sent><!--'낫낫'에서 뒤에 오는 '낫'은 재점(〃)으로 표기되어 있음-->
<sent type="main" lang="kor" page="17" n="04">업시ᄒᆞ라 ᄒᆞᆫ 거슨 즉시 업시 ᄒᆞ엿ᄂᆡ</sent>
<sent type="main" lang="kor" page="17" n="05">답장을 브ᄃᆡ ᄌᆞ시 ᄒᆞ랴 ᄒᆞ엿더니</sent>
<sent type="main" lang="kor" page="17" n="06">내 병 지금 팀곤ᄒᆞ고 하 요요ᄒᆞ고</sent><!--'요요ᄒᆞ고'에서 뒤에 오는 '요'는 재점(〃)으로 표기되어 있음-->
<sent type="main" lang="kor" page="17" n="07">ᄆᆞ음 간 ᄃᆡ 업서 잠 뎍ᄂᆡ</sent>
<sent type="main" lang="kor" page="17" n="08">누의님 몬져 간 일은 이제로 ᄉᆡᆼ각ᄒᆞ면 ᄒᆞᆫ이 되거니와</sent>
<sent type="main" lang="kor" page="17" n="09">그ᄯᅢ예야 이럴 줄을 어이 알고</sent>
<sent type="main" lang="kor" page="17" n="10">그 일이 사ᄅᆞᆷ의 극ᄒᆞᆫ 관수ᄒᆞᆫ 일이니</sent>
<sent type="main" lang="kor" page="17" n="11">ᄆᆞ음대로 못 ᄒᆞᄂᆞᆫ 거시니</sent>
<sent type="main" lang="kor" page="17" n="12">이제 무익ᄒᆞᆫ ᄒᆞᆫ을 하 마소</sent>
<sent type="main" lang="kor" page="17" n="13">ᄂᆞᆷ인들 뉘라셔 부러 알고 그리 가다 ᄒᆞᆯ 니 이실고</sent>
<sent type="main" lang="kor" page="17" n="14">만쟝은 장동셔 그리 쥬션ᄒᆞ랴 ᄒᆞ시면 ᄒᆞ여 무던턴가 시브나</sent>
<sent type="main" lang="kor" page="17" n="15">이제ᄂᆞᆫ 더옥 밋디 못ᄒᆞᆯ 일이니 닐러 ᄡᅳᆯᄃᆡ업ᄂᆡ</sent>
<sent type="main" lang="kor" page="17" n="16">증직은 부모ᄭᅴ만 ᄒᆞ게 ᄒᆞ여시매</sent>
<sent type="main" lang="kor" page="17" n="17">조부모ᄭᅴᄂᆞᆫ 밋디 못ᄒᆞ엿ᄂᆡ</sent>
<sent type="main" lang="kor" page="17" n="18">장일은 삼월 초뉵일노 되게 ᄒᆞ엿ᄂᆡ </sent>
<sent type="main" lang="kor" page="17" n="19">내 병은 마치 져년 섯ᄃᆞᆯ 보ᄅᆞᆷᄭᅴ 즈음만은 ᄒᆞ되</sent>
<sent type="main" lang="kor" page="17" n="20">원긔 졈졈 못ᄒᆞ여 가니</sent><!--'졈졈'에서 뒤에 오는 '졈'은 재점(〃)으로 표기되어 있음-->
<sent type="main" lang="kor" page="17" n="21">초상을 바히 집상을 못 ᄒᆞᆯ ᄲᅮᆫ 아니라</sent>
<sent type="main" lang="kor" page="17" n="22">젼두 발인 시 엇디ᄒᆞ여 보젼ᄒᆞ며</sent>
<sent type="main" lang="kor" page="17" n="23">상의ᄒᆞᆯ디 모로니 민망기 ᄀᆞ업ᄉᆡ</sent>
<sent type="main" lang="kor" page="17" n="24">집을 아조 ᄑᆞᆯ고 ᄯᅥ나니 녜일이 자최도 업서디니</sent>
<sent type="main" lang="kor" page="17" n="25">이런 참혹ᄒᆞᆫ 일 ᄯᅩ □□ □실고</sent>
<sent type="main" lang="kor" page="17" n="26">우리ᄂᆞᆫ 나ᄌᆔ로 가려터니</sent>
<sent type="main" lang="kor" page="17" n="27">안골 족댱 네나 이다히 아ᄂᆞᆫ 사ᄅᆞᆷ덜이 □□예 아마도 남듕으로 가기 맛당티 아니타 말니고</sent>
<sent type="main" lang="kor" page="17" n="28">ᄇᆡ뫼셔나 평뎡 일쇽덜이나 다 뇽담다히로 오니</sent>
<sent type="main" lang="kor" page="17" n="29">올 제 ᄂᆞ려가기도 어렵고</sent>
<sent type="main" lang="kor" page="17" n="30">예ᄂᆞᆫ 사흘 길히니 </sent>
<sent type="main" lang="kor" page="17" n="31">ᄂᆞᆷ덜의 인마을 비러도 슈뎐이 잠ᄭᅡᆫ 쉬오매</sent>
<sent type="main" lang="kor" page="17" n="32">뫼임ᄃᆡᆨ과 니현은 몬져 보내여 회매 ᄇᆞᆯ셔 왓고</sent>
<sent type="main" lang="kor" page="17" n="33">예 잇ᄂᆞᆫ 가쇽을 발인 나신 날 뇽담으로 가게 ᄒᆞ고</sent>
<sent type="main" lang="kor" page="17" n="34">□ᄂᆡ 예 가나 뎨 가나</sent>
<sent type="main" lang="kor" page="17" n="35">나ᄂᆞᆫ 아므 곳도 ᄆᆞ음 브틸 고디 업ᄉᆞ니 팔ᄌᆞ라 ᄒᆞᆯ 일 업ᄂᆡ</sent>
<sent type="main" lang="kor" page="17" n="36">뇽담은 셔울은 잠간 갓가오나</sent>
<sent type="main" lang="kor" page="17" n="37">쇼식 통키 어렵기ᄂᆞᆫ 더옥 심ᄒᆞᆯ 거시니</sent>
<sent type="main" lang="kor" page="17" n="38">편지도 이후 쉽디 아닐가 더옥 셜위</sent>
<sent type="main" lang="kor" page="17" n="39">경예 편지 반기며 붓은 안 슬픠</sent>
<sent type="main" lang="kor" page="17" n="40">경업서 아ᄒᆡ 답장 못 ᄒᆞ니 후의 ᄒᆞᆷ새</sent>
<sent type="main" lang="kor" page="17" n="41">통쳔 ᄇᆡ□ᄂᆞᆫ □여 보내ᄂᆡ 이 아니라□□□□가 ᄏᆞ니와</sent>
<sent type="main" lang="kor" page="17" n="42">논 지을 대로 다 드리고</sent>
<sent type="main" lang="kor" page="17" n="43">저도 브경이 ᄉᆞ환ᄒᆞ여 드리라 ᄒᆞ엿ᄂᆡ</sent>
<sent type="main" lang="kor" page="17" n="44">닙안 ᄒᆞᆫ가지로 가매 봉ᄒᆞ엿ᄂᆡ</sent>
<sent type="main" lang="kor" page="17" n="45">시절이나 편ᄒᆞ고 뇽담곳 이시면</sent>
<sent type="main" lang="kor" page="17" n="46">이제ᄂᆞᆫ 내게 복매 이시니</sent>
<sent type="main" lang="kor" page="17" n="47">누의님 ᄂᆞ려오게 ᄒᆞ미 어렵디 아닐 거시니</sent>
<sent type="main" lang="kor" page="17" n="48">ᄀᆞ을노나 와셔 ᄃᆞᆫ녀가과뎌 ᄒᆞᄂᆡ</sent>
<sent type="main" lang="kor" page="17" n="49">대쇼샹의 오랴 ᄒᆞ면 □□□려니와</sent>
<sent type="main" lang="kor" page="17" n="50">무시라도 ᄂᆞ려와 올코 ᄒᆞᆫ대나 든든ᄒᆞᆯ 거시니</sent><!--'든든ᄒᆞᆯ'에서 뒤에 오는 '든'은 재점(〃)으로 표기되어 있음-->
<sent type="main" lang="kor" page="17" n="51">그리 ᄉᆡᆼ각고 잇소</sent>
<sent type="main" lang="kor" page="17" n="52">박뫼 누의님은 자ᄂᆡ을 못내 불워ᄒᆞ여시니 더옥 블샹ᄒᆡ</sent>
<sent type="main" lang="kor" page="17" n="53">누의님도 그리 ᄉᆡᆼ각고 관회ᄒᆞ여 몸 부디ᄒᆞ여 디내소</sent>
<sent type="main" lang="kor" page="17" n="54">됴 셔방이 내 병 념녀ᄒᆞ여</sent>
<sent type="main" lang="kor" page="17" n="55">도련이 편지ᄒᆞ고 병녹ᄒᆞ여 보내라 ᄒᆞ여 극히 고마오ᄃᆡ</sent>
<sent type="main" lang="kor" page="17" n="56">졍신이 이 편지예 다 ᄒᆞ여시니</sent>
<sent type="main" lang="kor" page="17" n="57">진셔를 못 ᄒᆞᆯ가 시븨</sent>
<sent type="main" lang="kor" page="17" n="58">아마도 부디ᄒᆞ여 잇소</sent>
<sent type="main" lang="kor" page="17" n="59">사월 십오일</sent>
<sent type="main" lang="kor" page="17" n="60">동ᄉᆡᆼ 상인 영</sent>
<sent type="main" lang="kor" page="17" n="61">□□□게 가ᄂᆞᆫ ᄇᆡᄌᆞ 고텨 덧 봉ᄒᆞ여 □□</sent>
</letter>

<letter n="18" sender="임영(삼촌)" writer="임영(삼촌)" receiver="미상(조카)" year="1649~1696년">
<sent type="main" lang="kor" page="18" n="01">이 편지 슈지ᄅᆞᆯ 보아라</sent>
<sent type="main" lang="kor" page="18" n="02">ᄌᆞᄌᆞ히 졍을 머곰으신 말ᄉᆞᆷ이오</sent><!--'ᄌᆞᄌᆞ히'에서 뒤에 오는 'ᄌᆞ'는 재점(〃)으로 표기되어 있음-->
<sent type="main" lang="kor" page="18" n="03">말ᄉᆞᆷ마다 긔특ᄒᆞ오시니</sent>
<sent type="main" lang="kor" page="18" n="04">이ᄅᆞᆯ 보면 내의 셜워ᄒᆞᄂᆞᆫ 졍셩과 너 향ᄒᆞᆫ 졍이 녜ᄉᆞ 동ᄉᆞᆼ 족하과 다ᄅᆞᆯ 줄 아니 알냐</sent>
<sent type="main" lang="kor" page="18" n="05">샹시 셔ᄉᆞ과 언어 간의 일호도 실의셔 과도ᄒᆞᆫ 말이 아니 겨시던 거시니</sent>
<sent type="main" lang="kor" page="18" n="06">이ᄅᆞᆯ 보오면 너도 날을 녜ᄉᆞ 삼촌으로 아니 알년마ᄂᆞᆫ</sent>
<sent type="main" lang="kor" page="18" n="07">고젹을 들머겨 아ᄒᆡ 셜움을 도돌가 아니 뵈엿더니</sent>
<sent type="main" lang="kor" page="18" n="08">네 고집이 하 ᄀᆞᆨ골 ᄀᆞᆸᄀᆞᆸᄒᆞ여 보내니</sent><!--'ᄀᆞᆸᄀᆞᆸᄒᆞ여'에서 뒤에 오는 'ᄀᆞᆸ'은 재점(〃)으로 표기되어 있음-->
<sent type="main" lang="kor" page="18" n="09">브ᄃᆡ브ᄃᆡ 내 말을 드러 부디ᄒᆞ여</sent><!--'브ᄃᆡ브ᄃᆡ'에서 뒤에 오는 '브ᄃᆡ'는 재점(〃)으로 표기되어 있음-->
<sent type="main" lang="kor" page="18" n="10">병 업ᄉᆞᆫ 사ᄅᆞᆷ이 되어</sent>
<sent type="main" lang="kor" page="18" n="11">쟝ᄂᆡ 효도ᄅᆞᆯ 기리 닐위여라</sent>
<sent type="main" lang="kor" page="18" n="12">ᄉᆡᆼ시의 영양을 못 ᄒᆞ온ᄃᆞᆯ ᄉᆞ휜ᄃᆞᆯ ᄌᆞ식의 영홰 엇더ᄒᆞ니</sent>
<sent type="main" lang="kor" page="18" n="13">내 ᄆᆞᄋᆞᆷ의도 나ᄂᆞᆫ 쥭어도 ᄌᆞ식들이 반셕 ᄀᆞᄐᆞ면 긔 즐거올ᄃᆞᆺ 시브더라</sent>
<sent type="main" lang="kor" page="18" n="14">이 슈지ᄂᆞᆫ 쳔 번은 보아도 슌마다 울니니 내내 슝장ᄒᆞ여터니</sent><!--'울니니'에서 뒤에 오는 '니'는 재점(〃)으로 표기되어 있음-->
<sent type="main" lang="kor" page="18" n="15">네 두고 보긔 보ᄂᆡ노라</sent>
</letter>
