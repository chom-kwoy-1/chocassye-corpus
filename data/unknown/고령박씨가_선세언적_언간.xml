<letter n="01" sender="청송심씨(어머니)" writer="청송심씨(어머니)" receiver="박장원(아들)" year="1660~1663년">
<sent type="envelop1-1" lang="kor" page="01" n="01">녕감 젼 답셔</sent>
<sent type="envelop1-1" lang="kor" page="01" n="02">근봉</sent>
<sent type="main" lang="kor" page="01" n="03">여날 긔별 못 드ᄅᆞ니</sent>
<sent type="main" lang="kor" page="01" n="04">엇디 인ᄂᆞᆫ고 분별이 그지업서 ᄒᆞ며</sent>
<sent type="main" lang="kor" page="01" n="05">김셩으로셔 두 번 ᄒᆞᆫ 편지 보고 난 디 오란 편지라</sent>
<sent type="main" lang="kor" page="01" n="06">반갑기 ᄀᆞ이업서 ᄒᆞ노라</sent>
<sent type="main" lang="kor" page="01" n="07">드ᄅᆞ니 ᄇᆡ 편티 아녀ᄒᆞ더라 ᄒᆞ니</sent>
<sent type="main" lang="kor" page="01" n="08">엇디 ᄃᆞᆫ니던고 념녀 ᄀᆞ이업서 ᄒᆞ노라</sent>
<sent type="main" lang="kor" page="01" n="09">예ᄂᆞᆫ 계유 숨만 이셔 듀야 편티 아니니 민망ᄒᆞ야 디내노라</sent><!--'아니니'에서 뒤에 오는 '니'는 재점으로 표기되어 있음-->
<sent type="main" lang="kor" page="01" n="10">날이 요ᄉᆞ이ᄂᆞᆫ 하 더오니 엇디 ᄃᆞᆫ녀올고 분별이 ᄀᆞ이업다</sent>
<sent type="main" lang="kor" page="01" n="11">아므려나 조심ᄒᆞ야 무ᄉᆞ히 ᄃᆞᆫ녀오믈 ᄇᆞ라노라</sent>
<sent type="main" lang="kor" page="01" n="12">그지업ᄉᆞ나 뎐뎐이라 이만 뎍노라</sent><!--'뎐뎐이라'에서 뒤에 오는 '뎐'은 재점으로 표기되어 있음-->
<sent type="main" lang="kor" page="01" n="13">ᄉᆞ월 슌ᄉᆞ일 모 심</sent>  

</letter>

<letter n="02" sender="청송심씨(증조모)" writer="청송심씨(증조모)" receiver="박성한(증손자)" year="1670년">
<sent type="envelop1-1" lang="kor" page="02" n="01">김셩손ᄃᆡ 답셔</sent>
<sent type="envelop1-1" lang="kor" page="02" n="02">근봉</sent>
<sent type="main" lang="kor" page="02" n="03">요ᄉᆞ이ᄂᆞᆫ 긔별도 못 듣고</sent>
<sent type="main" lang="kor" page="02" n="04">날이 하 치오니 엇디콤 인ᄂᆞᆫ</sent>
<sent type="main" lang="kor" page="02" n="05">듀야 분별이 ᄀᆞ이업서 ᄒᆞ더니</sent>
<sent type="main" lang="kor" page="02" n="06">사ᄅᆞᆷ 오나ᄂᆞᆯ 뎌근 것 보고</sent> 
<sent type="main" lang="kor" page="02" n="07">본 ᄃᆞᆺ 탐탐 반겨 다시곰 보고 대되</sent><!--'탐탐'에서 뒤에 오는 '탐'은 재점으로 표기되어 있음-->
<sent type="main" lang="kor" page="02" n="08">무ᄉᆞ히 이시니 깃거ᄒᆞ노라</sent>
<sent type="main" lang="kor" page="02" n="09">예ᄂᆞᆫ 계유 숨은 이시ᄃᆡ</sent>
<sent type="main" lang="kor" page="02" n="10">나ᄂᆞᆫ 병이 날로 더 듕ᄒᆞ니</sent>
<sent type="main" lang="kor" page="02" n="11">듀야 알코 이제ᄂᆞᆫ 주글 날만 ᄇᆞ라노라</sent>
<sent type="main" lang="kor" page="02" n="12">졔믈은 ᄌᆞ셰 바다 디내오랴 깃거ᄒᆞ노라</sent>
<sent type="main" lang="kor" page="02" n="13">조ᄡᆞᆯ은 곳재 건너 두노라</sent>
<sent type="main" lang="kor" page="02" n="14">통쳔셔 온 것 명태 닷 동도 아니 왓고</sent>
<sent type="main" lang="kor" page="02" n="15">대구 두 마리 ᄉᆡᆼ합은 ᄒᆞ 다ᄉᆞᆺ도 아니 왓다</sent>
<sent type="main" lang="kor" page="02" n="16">ᄒᆡ 진ᄒᆞ니 더옥 ᄆᆞᄋᆞᆷ이ᄂᆞ 미섭긔 ᄒᆞ노라</sent>
<sent type="main" lang="kor" page="02" n="17">전년이 감동 디히ᄂᆞᆫ 세 드러시니</sent>
<sent type="main" lang="kor" page="02" n="18">쇠나 녀허 먹게 단지예 봉ᄒᆞ야 간다</sent>
<sent type="main" lang="kor" page="02" n="19">건시 ᄒᆞᆫ 뎝 감ᄌᆞ 다ᄉᆞᆺ 민어 자반 ᄒᆞ나 간다</sent>
<sent type="main" lang="kor" page="02" n="20">그지업소ᄃᆡ 스디 못ᄒᆞ야 이만</sent>
<sent type="main" lang="kor" page="02" n="21">쇼듀도 업고 블 펼 ᄉᆞᄅᆞᆷ도 업ᄉᆞ니 민망ᄒᆞ다</sent>
<sent type="main" lang="kor" page="02" n="22">아므려나 됴히들 잇거ᄉᆞ라</sent>
<sent type="main" lang="kor" page="02" n="23">경슐 납월 념일 진조모</sent>
</letter>

<letter n="03" sender="해평윤씨(어머니)" writer="해평윤씨(어머니)" receiver="박심(아들)" year="1670~1685년">
<sent type="envelop1-1" lang="kor" page="03" n="01">김셩손ᄃᆡ 답</sent>
<sent type="envelop1-1" lang="kor" page="03" n="02">근봉</sent>
<sent type="main" lang="kor" page="03" n="03">요ᄉᆞ이 일졀 긔별 못 드르니 답답 민망ᄒᆞ더니</sent><!--'답답'에서 뒤에 오는 '답'은 재점으로 표기되어 있음--> 
<sent type="main" lang="kor" page="03" n="04">하인 오나ᄂᆞᆯ 뎍그니 보고 본 ᄃᆞᆺ 반기며</sent>
<sent type="main" lang="kor" page="03" n="05">편히 드러가 이시니 깃거ᄒᆞ노라</sent>
<sent type="main" lang="kor" page="03" n="06">옛 병환은 이 사흘재ᄂᆞᆫ 대셰ᄂᆞᆫ 잠간 나으신 ᄃᆞᆺᄒᆞ고</sent>
<sent type="main" lang="kor" page="03" n="07">아젹이면 퍽 나으시다가 오후면 아젹만 못ᄒᆞ며</sent>
<sent type="main" lang="kor" page="03" n="08">무흔 몸을 셜워ᄒᆞ시고 음식을 쥭믈도 자시기ᄅᆞᆯ 아니ᄒᆞ시니</sent>
<sent type="main" lang="kor" page="03" n="09">무흔 몸을 셜워ᄒᆞ시고 음식을 쥭믈도 자시기ᄅᆞᆯ 아니ᄒᆞ시니</sent>
<sent type="main" lang="kor" page="03" n="10">민망민망ᄒᆞ기 ᄀᆞ이업다</sent><!--'민망민망ᄒᆞ기'에서 뒤에 오는 '민망'은 재점으로 표기되어 있음-->
<sent type="main" lang="kor" page="03" n="11">아므 알프신 ᄃᆡᆫ 줄도 모ᄅᆞ고 가지가지로 ᄀᆞᆸᄀᆞᆸᄒᆞ다</sent><!--'가지가지로'와 ‘ᄀᆞᆸᄀᆞᆸᄒᆞ다’에서 뒤에 오는 '가지'와 ‘ᄀᆞᆸ’은 재점으로 표기되어 있음--> 
<sent type="main" lang="kor" page="03" n="12">열아흐랜날 스므날 년ᄒᆞ여사 가거ᄂᆞᆯ 유무ᄒᆞ더니 갓더냐</sent>
<sent type="main" lang="kor" page="03" n="13">홍ᄃᆡᆨ은 스므날 ᄆᆡᆫᄃᆞᄃᆡ ᄒᆞ여</sent>
<sent type="main" lang="kor" page="03" n="14">가기ᄂᆞᆫ 너모 잘ᄒᆞ고 가시ᄃᆡ 수이 오나지라 ᄒᆞᄃᆡ</sent>
<sent type="main" lang="kor" page="03" n="15">집안도 병환은 아므란 줄 모ᄅᆞ고 계셔도 보내</sent>
<sent type="main" lang="kor" page="03" n="16">아직 보내디 못ᄒᆞᆯ로다 ᄒᆞ니</sent>
<sent type="main" lang="kor" page="03" n="17">아직 그저 이시니 보와온져 모려 ᄒᆞ노라</sent>
<sent type="main" lang="kor" page="03" n="18">뎐서ᄅᆞᆯ 수이 보내여라</sent>
<sent type="main" lang="kor" page="03" n="19">졀양ᄒᆞ여시니 그 조ᄡᆞᆯ 말이나 어더 ᄡᅳ쟈</sent>
<sent type="main" lang="kor" page="03" n="20">ᄏᆞ니와 오면 더 슬ᄒᆞᆯ가 시브다</sent>
<sent type="main" lang="kor" page="03" n="21">쇼ᄌᆔ ᄒᆞ나토 업서디고 자실 거시 업ᄉᆞ니</sent>
<sent type="main" lang="kor" page="03" n="22">쇼쥬ᄅᆞᆯ 수이 오ᄂᆞᆫ 사ᄅᆞᆷ의 어더 보내여라</sent>
<sent type="main" lang="kor" page="03" n="23">이 사ᄅᆞᆷ 즉시 사ᄅᆞᆷ 간다코 유무 맛드니</sent>
<sent type="main" lang="kor" page="03" n="24">이만 긔별ᄒᆞᆫ 말란 긔별ᄒᆞᆫ ᄯᅢ로 사월 쵸로 아므려나 평ᄒᆞᄆᆞᆯ ᄇᆞ라노라</sent>
<sent type="main" lang="kor" page="03" n="25">ᄉᆞ월 념오일 모</sent>
</letter>

<letter n="04" sender="해평윤씨(할머니)" writer="해평윤씨(할머니)" receiver="박성한(손자)" year="1681년">
<sent type="envelop1-1" lang="kor" page="04" n="01">삼쟈의게</sent>
<sent type="main" lang="kor" page="04" n="02">요ᄉᆞ이 긔별 못 드ᄅᆞ니</sent>
<sent type="main" lang="kor" page="04" n="03">봄 치위예 엇디 인ᄂᆞᆫ고 념녀 ᄀᆞ이업서 ᄒᆞ노라</sent>
<sent type="main" lang="kor" page="04" n="04">예셔 여러 번 사ᄅᆞᆷ 가더니 본다</sent>
<sent type="main" lang="kor" page="04" n="05">요ᄉᆞ이ᄂᆞᆫ 엇디 디내ᄂᆞᆫ고</sent><!--'엇디 디내ᄂᆞᆫ고'에서 뒤에 오는 '디'는 재점으로 표기되어 있음--> 
<sent type="main" lang="kor" page="04" n="06">닛든 못ᄒᆞᄃᆡ ᄇᆞ람이 업서 ᄒᆞ노라</sent>
<sent type="main" lang="kor" page="04" n="07">이리 오난디 다ᄉᆞᆺ ᄃᆞᆯ이 못ᄒᆞᄃᆡ</sent>
<sent type="main" lang="kor" page="04" n="08">삼 년이나 ᄒᆞᆫ ᄃᆞᆺᄒᆞ고</sent>
<sent type="main" lang="kor" page="04" n="09">두로 그리오니 못 견ᄃᆡᆯ가 시브다</sent>
<sent type="main" lang="kor" page="04" n="10">길히나 가ᄌᆞᆨᄒᆞᆫ ᄃᆡ면 ᄌᆞᆨᄒᆞ랴</sent>
<sent type="main" lang="kor" page="04" n="11">간만 간다 ᄒᆞ더니 엇디 ᄒᆞ고 온다</sent>
<sent type="main" lang="kor" page="04" n="12">뫼히나 어든가 못 어드가 아므란 줄 모ᄅᆞ니 답답ᄒᆞ다</sent>
<sent type="main" lang="kor" page="04" n="13">챤억은 김쳔 가 그저 인ᄂᆞ냐</sent>
<sent type="main" lang="kor" page="04" n="14">됴히나 인ᄂᆞᆫ가 두 고ᄃᆞ로 ᄂᆞᆫ화 주고 ᄌᆞᆨ히 민망ᄒᆞᆫ 일이 만흐랴</sent>
<sent type="main" lang="kor" page="04" n="15">닛디 못ᄒᆞ여 ᄒᆞ노라</sent>
<sent type="main" lang="kor" page="04" n="16">슈한도 ᄒᆞᆫ가지로 보와라</sent>
<sent type="main" lang="kor" page="04" n="17">어득ᄒᆞ니 말도 다 니저 이만 뎍노라</sent>
<sent type="main" lang="kor" page="04" n="18">아므려나 무ᄉᆞ히 디내ᄆᆞᆯ ᄇᆞ라노라</sent>
<sent type="main" lang="kor" page="04" n="19">신유 원월 십팔일 할미</sent>
</letter>

<letter n="05" sender="청주한씨(아내)" writer="청주한씨(아내)" receiver="박빈(남편)" year="1629~1673년">
<sent type="envelop1-1" lang="kor" page="05" n="01">답샹장</sent>
<sent type="envelop1-1" lang="kor" page="05" n="02">근봉</sent>
<sent type="main" lang="kor" page="05" n="03">긔별 모ᄅᆞ와 ᄉᆞ모 극ᄒᆞᄋᆞᆸ다니</sent>
<sent type="main" lang="kor" page="05" n="04">급쟝이 오와ᄂᆞᆯ 뎍ᄉᆞ오시니 보ᄋᆞᆸ고 반갑ᄉᆞ오며</sent>
<sent type="main" lang="kor" page="05" n="05">날이 극한이온ᄃᆡ 뫼오셔 평안ᄒᆞ오신 일 아ᄋᆞᆸ고</sent>
<sent type="main" lang="kor" page="05" n="06">몬ᄂᆡ 깃ᄉᆞ와 ᄒᆞᄋᆞᆸᄂᆞ이다</sent>
<sent type="main" lang="kor" page="05" n="07">스므ᄒᆞᄅᆞᆫ날 문안 가ᄂᆞᆫ 사ᄅᆞᆷ의 옷ᄃᆞᆯ을 보ᄂᆡᄋᆞᆸ더니 갓ᄉᆞᆸ던가 ᄒᆞᄋᆞᆸ</sent>
<sent type="main" lang="kor" page="05" n="08">우리ᄂᆞᆫ 무ᄉᆞ히 잇ᄉᆞᆸ</sent>
<sent type="main" lang="kor" page="05" n="09">술은 비저시ᄃᆡ 날이 치워 일졀 수이 되디 아니니</sent><!--'아니니'에서 뒤에 오는 '니'는 재점으로 표기되어 있음--> 
<sent type="main" lang="kor" page="05" n="10">이번 못 보ᄂᆡ오니 댱듕 미처 못 가게 ᄒᆞ여시니 민망ᄒᆞᄋᆞᆸ</sent>
<sent type="main" lang="kor" page="05" n="11">건ᄃᆡᄂᆞᆫ 오ᄂᆞᆯ ᄠᅳ니 후인의 ᄆᆞᆯᄅᆡ여 보ᄂᆡ오리이다</sent>
<sent type="main" lang="kor" page="05" n="12">댱옷 ᄀᆞᄋᆞᆷ은 보ᄅᆞᆷᄭᅴ 어마님ᄭᅴ로 보ᄂᆡ엿ᄉᆞᆸᄂᆞ니이다</sent>
<sent type="main" lang="kor" page="05" n="13">면화ᄂᆞᆫ 죄 ᄒᆞ여 올니니</sent>
<sent type="main" lang="kor" page="05" n="14">닐굽 근 두 냥이ᄋᆞᆸ</sent>
<sent type="main" lang="kor" page="05" n="15">댱옷 ᄀᆞᄋᆞᆷ 치마 ᄀᆞᄋᆞᆷ ᄂᆞ려오면 지어 보ᄂᆡ려 ᄃᆡ령ᄒᆞ엿ᄉᆞᆸ</sent>
<sent type="main" lang="kor" page="05" n="16">ᄯᅴᄃᆞᆯ은 ᄎᆞᄌᆞ신가 ᄒᆞᄋᆞᆸ긔 셩부 보ᄂᆡ기 밧바 기ᄃᆞ리ᄋᆞᆸ</sent>
<sent type="main" lang="kor" page="05" n="17">오ᄂᆞᆯ 사ᄅᆞᆷ 간다 ᄒᆞ오니 밧바 이만</sent>
<sent type="main" lang="kor" page="05" n="18">댱듕 평안이 들러ᄉᆞ 만이 오실가 ᄇᆞ라ᄋᆞᆸ</sent>
<sent type="main" lang="kor" page="05" n="19">시월 념육일 아ᄂᆡ 셔</sent>
</letter>

<letter n="06" sender="청주한씨(아내)" writer="청주한씨(아내)" receiver="박빈(남편)" year="1629~1671년*">
<sent type="envelop1-2" lang="kor" page="06" n="01">답샹장</sent>
<sent type="main" lang="kor" page="06" n="02">몬졔 편지 보오니 아바님 니질이 극듕ᄒᆞ오시다 ᄒᆞᄋᆞᆸ고</sent>
<sent type="main" lang="kor" page="06" n="03">그 후 긔별 모ᄅᆞ와 밤낫 ᄀᆞᆸᄀᆞᆸ 민망ᄒᆞ오니</sent><!--'ᄀᆞᆸᄀᆞᆸ'에서 뒤에 오는 'ᄀᆞᆸ'은 재점으로 표기되어 있음-->
<sent type="main" lang="kor" page="06" n="04">ᄆᆞᄋᆞᆷ을 잡디 못ᄒᆞᄋᆞᆸ다니</sent>
<sent type="main" lang="kor" page="06" n="05">사ᄅᆞᆷ 오와ᄂᆞᆯ 편지 보ᄋᆞᆸ고 잠ᄭᅡᆫ 우연ᄒᆞ오시다 ᄒᆞ오니</sent>
<sent type="main" lang="kor" page="06" n="06">깃브오미 ᄀᆞ이ᄀᆞ이업ᄉᆞ오며</sent><!--'ᄀᆞ이ᄀᆞ이업ᄉᆞ오며'에서 뒤에 오는 'ᄀᆞ이'는 재점으로 표기되어 있음-->
<sent type="main" lang="kor" page="06" n="07">인ᄒᆞ여 요ᄉᆞ이 수일간 더 낫ᄌᆞ오신가 ᄒᆞ오며</sent>
<sent type="main" lang="kor" page="06" n="08">ᄆᆞᄋᆞᆷ이 죠곰 누거 ᄒᆞ오이다</sent>
<sent type="main" lang="kor" page="06" n="09">아마도 날마다 문안을 모ᄅᆞ오니</sent>
<sent type="main" lang="kor" page="06" n="10">답답기 ᄀᆞ이ᄀᆞ이업ᄉᆞ오이다</sent><!--'답답기'와 ‘ᄀᆞ이ᄀᆞ이업ᄉᆞ오이다’에서 뒤에 오는 '답'과 ‘가이’는 재점으로 표기되어 있음--> 
<sent type="main" lang="kor" page="06" n="11">뫼ᄎᆞ라기과 도요란 거ᄉᆞᆯ 어더 자바ᄃᆞᆫ</sent>
<sent type="main" lang="kor" page="06" n="12">ᄯᅩ 사ᄅᆞᆷ을 보내려 ᄒᆞᄋᆞᆸ거니와</sent>
<sent type="main" lang="kor" page="06" n="13">도요란 새도 잇고 믈올히도 도요라 ᄒᆞ오니</sent>
<sent type="main" lang="kor" page="06" n="14">하인ᄃᆞᆯ이 분간티 못ᄒᆞ여 ᄒᆞᄋᆞᆸ</sent>
<sent type="main" lang="kor" page="06" n="15">나ᄂᆞᆫ 믈의 올히라 ᄒᆞᄋᆞᆸ노이다</sent>
<sent type="main" lang="kor" page="06" n="16">게저ᄉᆞᆯ 보내라 ᄒᆞ오신다 ᄒᆞ오니</sent>
<sent type="main" lang="kor" page="06" n="17">저ᄉᆞᆫ 관겨티 아니ᄒᆞ오듸 긔운이 낫ᄌᆞ오셔</sent>
<sent type="main" lang="kor" page="06" n="18">녜ᄅᆞᆯ ᄉᆡᆼ각ᄒᆞ오신가 ᄒᆞ와 즐겁ᄉᆞ오이다</sent>
<sent type="main" lang="kor" page="06" n="19">회복이 긔쳑이 업ᄉᆞ오니</sent>
<sent type="main" lang="kor" page="06" n="20">오ᄂᆞᆯ 곳 아니 오면 유족이ᄅᆞᆯ 보내오려 ᄒᆞᄋᆞᆸ</sent>
<sent type="main" lang="kor" page="06" n="21">아ᄆᆞ려나 나날 소복ᄒᆞ오시ᄆᆞᆯ 듀야 ᄇᆞ라오며</sent>
<sent type="main" lang="kor" page="06" n="22">뫼셔 겨시니 그로 올ᄉᆞ오시랴 ᄒᆞᄋᆞᆸ</sent>
<sent type="main" lang="kor" page="06" n="23">녀남의 양식도 느일 보내오리이다</sent>
<sent type="main" lang="kor" page="06" n="24">슌ᄉᆞ일 아ᄂᆡ 셔</sent>
</letter>

<letter n="07" sender="남양홍씨(아내)" writer="남양홍씨(아내)" receiver="박성한(남편)" year="1680~1692년">
<sent type="envelop1-1" lang="kor" page="07" n="01">답샹장</sent>
<sent type="main" lang="kor" page="07" n="02">긔별 모ᄅᆞ와 듀야 답답 용심ᄒᆞ올 ᄎᆞ</sent><!--'답답'에서 뒤에 오는 '답'은 재점으로 표기되어 있음--> 
<sent type="main" lang="kor" page="07" n="03">초닷샌날 나온 뎍ᄉᆞ오시니 보ᄋᆞᆸ고</sent>
<sent type="main" lang="kor" page="07" n="04">일긔 사오납ᄉᆞ온ᄃᆡ</sent>
<sent type="main" lang="kor" page="07" n="05">긔운이 그만이나 무ᄉᆞᄒᆞ오신가 시브오니</sent>
<sent type="main" lang="kor" page="07" n="06">다ᄒᆡᆼ 깃브와 ᄒᆞ오며</sent>
<sent type="main" lang="kor" page="07" n="07">난 디 오란 편지 오니</sent>
<sent type="main" lang="kor" page="07" n="08">그 후 쇼식을 모ᄅᆞ오니 답답 념녀ᄅᆞᆯ 어이 다 뎍ᄉᆞ오리잇가</sent><!--'답답'에서 뒤에 오는 '답'은 재점으로 표기되어 있음-->
<sent type="main" lang="kor" page="07" n="09">새문밧 편지ᄅᆞᆯ 보오니</sent> 
<sent type="main" lang="kor" page="07" n="10">한식 미처 오신다 ᄒᆞ오니</sent>
<sent type="main" lang="kor" page="07" n="11">셔울도 ᄒᆞ마 와 겨오신가 모ᄅᆞ와 답답ᄒᆞ오며</sent><!--'답답ᄒᆞ오며'에서 뒤에 오는 '답'은 재점으로 표기되어 있음-->
<sent type="main" lang="kor" page="07" n="12">병환이 위듕ᄒᆞ여 겨오시다 ᄒᆞ오니</sent>
<sent type="main" lang="kor" page="07" n="13">듯ᄌᆞᆸ고 ᄀᆞᆸᄀᆞᆸ 민망ᄒᆞ오ᄆᆞᆯ 어이 다 뎍ᄉᆞᆸ</sent><!--'ᄀᆞᆸᄀᆞᆸ'에서 뒤에 오는 'ᄀᆞᆸ'은 재점으로 표기되어 있음-->
<sent type="main" lang="kor" page="07" n="14">증셰 엇디ᄒᆞ여 듕ᄒᆞ오시다 ᄒᆞᄋᆞᆸᄂᆞᆫ고</sent>
<sent type="main" lang="kor" page="07" n="15">아ᄆᆞ라ᄒᆞᆫ 줄을 모ᄅᆞ오니 더옥 ᄀᆞᆸᄀᆞᆸ</sent><!--'ᄀᆞᆸᄀᆞᆸ'에서 뒤에 오는 'ᄀᆞᆸ'은 재점으로 표기되어 있음-->
<sent type="main" lang="kor" page="07" n="16">안이 ᄐᆞᆯ ᄃᆞᆺ시브오이다</sent>
<sent type="main" lang="kor" page="07" n="17">요ᄉᆞ이 시령 곳블을 어더 그리 듕ᄒᆞ오신가</sent>
<sent type="main" lang="kor" page="07" n="18">이 ᄀᆞᆸᄀᆞᆸᄒᆞ오ᄆᆞᆯ 어이 간ᄒᆞᄋᆞᆸ</sent><!--'ᄀᆞᆸᄀᆞᆸᄒᆞ오ᄆᆞᆯ'에서 뒤에 오는 'ᄀᆞᆸ'은 재점으로 표기되어 있음-->
<sent type="main" lang="kor" page="07" n="19">그ᄉᆞ이 날포 되여ᄉᆞ오니 위연ᄒᆞ오신가</sent>
<sent type="main" lang="kor" page="07" n="20">이리 안자셔 가지가지 ᄀᆞᆸᄀᆞᆸᄒᆞ오니</sent><!--'가지가지'와 ‘ᄀᆞᆸᄀᆞᆸᄒᆞ오니’에서 뒤에 오는 '가지'와 ‘ᄀᆞᆸ’은 재점으로 표기되어 있음-->
<sent type="main" lang="kor" page="07" n="21">아마도 못 견ᄃᆡ올가 시브다</sent>
<sent type="main" lang="kor" page="07" n="22">ᄒᆞ오며 하 ᄀᆞᆸᄀᆞᆸᄒᆞ와 관노ᄅᆞᆯ 급급 보내오니</sent><!--'ᄀᆞᆸᄀᆞᆸᄒᆞ와'와 ‘급급’에서 뒤에 오는 'ᄀᆞᆸ'고 ‘급’은 재점으로 표기되어 있음-->
<sent type="main" lang="kor" page="07" n="23">병환 ᄌᆞ시 긔별ᄒᆞ오쇼셔</sent> 
<sent type="main" lang="kor" page="07" n="24">하 ᄀᆞᆸᄀᆞᆸᄒᆞ오니 이놈이 드러가ᄂᆞᆫ 날이라도</sent><!--'ᄀᆞᆸᄀᆞᆸᄒᆞ오니'에서 뒤에 오는 'ᄀᆞᆸ'은 재점으로 표기되어 있음-->
<sent type="main" lang="kor" page="07" n="25">날이 이ᄅᆞᄋᆞᆸ거든 죠곰 뎍어 급급 보ᄂᆡ오쇼셔</sent><!--'급급'에서 뒤에 오는 '급'은 재점으로 표기되어 있음-->
<sent type="main" lang="kor" page="07" n="26">아마도 ᄀᆞᆸᄀᆞᆸᄒᆞ여 못 견ᄃᆡ올소이다</sent><!--'ᄀᆞᆸᄀᆞᆸᄒᆞ여'에서 뒤에 오는 'ᄀᆞᆸ'은 재점으로 표기되어 있음--> 
<sent type="main" lang="kor" page="07" n="27">이런 ᄯᅢ 즉시 못 간 줄이 애ᄃᆞᆯ아ᄒᆞᆫᄃᆞᆯ 쇽졀 잇ᄉᆞᆸ</sent>
<sent type="main" lang="kor" page="07" n="28">나도 그 돌님 곳블을 어더 이리 ᄆᆞ이 알ᄉᆞᆸ고</sent>
<sent type="main" lang="kor" page="07" n="29">어린것 제ᄀᆞ티 알흐니 더옥 어득ᄒᆞ오이다</sent>
<sent type="main" lang="kor" page="07" n="30">스므나흔날 길흘 대되 나오니</sent>
<sent type="main" lang="kor" page="07" n="31">녀ᄌᆔᄀᆞ지 가셔 ᄎᆞ동이나 ᄃᆞ리고 셔울을 가오져 ᄒᆞᄋᆞᆸᄂᆞ이다</sent>
<sent type="main" lang="kor" page="07" n="32">ᄉᆞ연이 만ᄉᆞ오나 하 어득ᄒᆞ고 심난ᄒᆞ오니 잠 뎍ᄉᆞ오며</sent>
<sent type="main" lang="kor" page="07" n="33">아ᄆᆞ려나 병환이 낫ᄌᆞ오시다 듯ᄌᆞ오ᄆᆞᆯ 듀야 ᄇᆞ라ᄋᆞᆸᄂᆞ이다</sent>
<sent type="main" lang="kor" page="07" n="34">브ᄃᆡ 이놈 즉시 답장 ᄡᅥ 즉즉 보내오쇼셔</sent><!--'즉즉'에서 뒤에 오는 '즉'은 재점으로 표기되어 있음-->
<sent type="main" lang="kor" page="07" n="35">그ᄉᆞ이 간댱이 ᄆᆞᄅᆞᆫ ᄃᆞᆺ시브오이다</sent> 
<sent type="main" lang="kor" page="07" n="36">삼월 십뉵일 야 홍</sent>
</letter>

<letter n="08" sender="남양홍씨(아내)" writer="남양홍씨(아내)" receiver="박성한(남편)" year="1680~1692년">
<sent type="main" lang="kor" page="08" n="01">이리 오니 죵이나 먹을 일이 어렵ᄉᆞ오니</sent>
<sent type="main" lang="kor" page="08" n="02">댱단의 긔별ᄒᆞ여 아므거시나 가져오나야 견ᄃᆡ게 ᄒᆞ여ᄉᆞᆸ</sent>
<sent type="main" lang="kor" page="08" n="03">좁ᄡᆞᆯ ᄀᆞ튼 거시나 잇ᄉᆞᆸ던가 몰나 ᄒᆞᄋᆞᆸ</sent>
<sent type="main" lang="kor" page="08" n="04">며조ᄅᆞᆯ 녀ᄌᆔ셔 어더 왓더니</sent>
<sent type="main" lang="kor" page="08" n="05">쟝이 급ᄒᆞ니 즉시 ᄃᆞᆷ기쟈 ᄒᆞ오나</sent>
<sent type="main" lang="kor" page="08" n="06">소곰이 업서 ᄒᆞ올 ᄎᆞ</sent>
<sent type="main" lang="kor" page="08" n="07">녀ᄌᆔ ᄒᆞᆨ관ᄃᆡᆨ이 무명 사 달나 ᄒᆞ고 돈을 주거ᄂᆞᆯ 가져와ᄉᆞᆸ더니</sent>
<sent type="main" lang="kor" page="08" n="08">혹 무명을 어들 일 잇ᄉᆞ오니잇가</sent>
<sent type="main" lang="kor" page="08" n="09">무명을 어더 주고 그 돈을 ᄡᅳ고져 시브오이다</sent>
<sent type="main" lang="kor" page="08" n="10">발인 수이 ᄒᆞ게 되면 티뎐이 급히 되여ᄉᆞ오니</sent>
<sent type="main" lang="kor" page="08" n="11">미리 죠용ᄒᆞ여셔 ᄒᆞ고져 ᄒᆞ오니 엇더ᄒᆞ오니잇가</sent>
<sent type="main" lang="kor" page="08" n="12">알고 녀ᄌᆔᄅᆞᆯ 긔별ᄒᆞ고져 시브와 뎍ᄉᆞᆸ</sent>
<sent type="main" lang="kor" page="08" n="13">듕의 유쳥으로 ᄯᆞᆨᄒᆞᄋᆞᆸ더니</sent>
<sent type="main" lang="kor" page="08" n="14">유쳥을 두엇노라 ᄒᆞ오시니 다ᄒᆡᆼᄒᆞ오이다</sent>
<sent type="main" lang="kor" page="08" n="15">돈 ᄒᆞᆫ 돈이 업ᄉᆞ니 므어ᄉᆞᆯ 의지ᄅᆞᆯ ᄒᆞ올고 민망ᄒᆞᄋᆞᆸ</sent>
<sent type="main" lang="kor" page="08" n="16">내 몸이 이러ᄒᆞ오니 더옥 쥬변을 못ᄒᆞ게 되여시니</sent>
<sent type="main" lang="kor" page="08" n="17">가지가지 괴롭기 ᄀᆞ이업ᄉᆞ오이다</sent><!--'가지가지'에서 뒤에 오는 '가지'는 재점으로 표기되어 있음-->
<sent type="main" lang="kor" page="08" n="18">무명 금은 싀골다히ᄂᆞᆫ 져기 낫다 ᄒᆞᄋᆞᆸ더이다</sent>
<sent type="main" lang="kor" page="08" n="19">셔울의셔 ᄂᆡ도히 나은 줄은 모ᄅᆞ올너이다</sent>
</letter>

<letter n="09" sender="해주정씨(아내)" writer="해주정씨(아내)" receiver="박성한(남편)" year="1706년">
<sent type="envelop1-1" lang="kor" page="09" n="01">샹장</sent>
<sent type="envelop1-1" lang="kor" page="09" n="02">근봉</sent>
<sent type="main" lang="kor" page="09" n="03">디평 아ᄂᆡ</sent>
<sent type="main" lang="kor" page="09" n="04">챵뇽이 오온 후 날포 긔별 모ᄅᆞ와 념녀 깁ᄉᆞ오며</sent>
<sent type="main" lang="kor" page="09" n="05">요ᄉᆞ이ᄂᆞᆫ 날이 하 덥ᄉᆞ오니</sent>
<sent type="main" lang="kor" page="09" n="06">긔운이나 평안ᄒᆞ오신 일 아ᄋᆞᆸ고져 ᄒᆞᄋᆞᆸᄂᆞ이다</sent>
<sent type="main" lang="kor" page="09" n="07">예ᄂᆞᆫ 오ᄂᆞᆯ 졔ᄉᆞᄅᆞᆯ 못ᄌᆞ와 디내ᄋᆞᆸ고</sent>
<sent type="main" lang="kor" page="09" n="08">새로이 졍ᄉᆡ 슬프와 ᄒᆞᄋᆞᆸᄂᆞ이다</sent>
<sent type="main" lang="kor" page="09" n="09">새문의셔과 회동셔과 유집도 나왓ᄉᆞ오니 든든ᄒᆞ와 디내ᄋᆞᆸᄂᆞ이다</sent>
<sent type="main" lang="kor" page="09" n="10">하인들 가올 적 관복과 옷들을 지어 보내여ᄉᆞᆸ더니</sent>
<sent type="main" lang="kor" page="09" n="11">무ᄉᆞ히나 갓다가 드렷ᄂᆞᆫ디 하 애ᄡᅥ ᄒᆞ야 보내여ᄉᆞ오니</sent>
<sent type="main" lang="kor" page="09" n="12">혹 일ᄉᆞ올가 일념의 브리ᄋᆞᆸ디 못ᄒᆞ와 ᄒᆞᄋᆞᆸᄂᆞ이다</sent>
<sent type="main" lang="kor" page="09" n="13">뎐뎐 왕ᄂᆡ오 블관ᄒᆞ오나</sent><!--'뎐뎐'에서 뒤에 오는 '뎐'은 재점으로 표기되어 있음--> 
<sent type="main" lang="kor" page="09" n="14">민어 조긔 편포 게 업ᄉᆞᆫ 거시라 ᄡᅡ 보내ᄋᆞᆸᄂᆞ이다</sent>
<sent type="main" lang="kor" page="09" n="15">뎐뎐이라 이만 뎍ᄉᆞᆸ</sent><!--'뎐뎐이라'에서 뒤에 오는 '뎐'은 재점으로 표기되어 있음-->
<sent type="main" lang="kor" page="09" n="16">병슐 ᄉᆞ월 입일일 아현 셔</sent>
</letter>

<letter n="10" sender="삭녕최씨(아내)" writer="삭녕최씨(아내)" receiver="박광수(남편)" year="1690~1700년">
<sent type="main" lang="kor" page="10" n="01">수이 일간 뫼ᄋᆞ오셔 평안ᄒᆞ오신 일 아ᄋᆞᆸ고져 ᄒᆞ오며</sent>
<sent type="main" lang="kor" page="10" n="02">죵을 게ᄀᆞ디 ᄃᆞᆫ녀오라 하인 ᄒᆞᆷᄭᅴ 보내 보내얏ᄉᆞᆸ더니</sent>
<sent type="main" lang="kor" page="10" n="03">아바님겨셔 슌챵 와 겨오시더라</sent>
<sent type="main" lang="kor" page="10" n="04">슌챵만 ᄃᆞ녀왓ᄉᆞ오니 게별 모ᄅᆞ와 ᄒᆞᄋᆞᆸ</sent>
<sent type="main" lang="kor" page="10" n="05">아바님겨셔도 셔울 ᄒᆡᆼᄎᆞᄅᆞᆯ 급피 뎡ᄒᆞᄋᆞ오시다 ᄒᆞ오니</sent>
<sent type="main" lang="kor" page="10" n="06">날이 덥ᄉᆞ오니 어이 득달ᄒᆞ오실고 민망ᄒᆞ와 ᄒᆞᄋᆞᆸᄂᆞ이다</sent>
<sent type="main" lang="kor" page="10" n="07">어제 간 편지의 집 잡기 말ᄉᆞᆷ ᄌᆞ시 ᄒᆞ얏ᄉᆞᆸ고</sent>
<sent type="main" lang="kor" page="10" n="08">윤도 오라바님 편지예 ᄌᆞ시 ᄒᆞ시니 의논ᄒᆞ야 긔별ᄒᆞ시ᄋᆞᆸ</sent>
<sent type="main" lang="kor" page="10" n="09">건넌 ᄆᆞᄋᆞᆯ이 블안ᄒᆞ기로 념녀되여 그러ᄒᆞᄋᆞᆸ</sent>
<sent type="main" lang="kor" page="10" n="10">총망 그치ᄋᆞᆸ</sent>
<sent type="main" lang="kor" page="10" n="11">오월 초삼일 최</sent>
</letter>

<letter n="11" sender="여주이씨(시어머니)" writer="여주이씨(시어머니)" receiver="덕수이씨(며느리)" year="1726년">
<sent type="main" lang="kor" page="11" n="01">뎍은 글시 보고 에엿븐 얼굴을 ᄃᆡᄒᆞ야 보ᄂᆞᆫ ᄃᆞᆺ 든든 반기며</sent>
<sent type="main" lang="kor" page="11" n="02">이리 아ᄃᆞᆨ히 이셔 즉시 보디 못ᄒᆞ니</sent>
<sent type="main" lang="kor" page="11" n="03">섭섭 답답ᄒᆞ기ᄅᆞᆯ 어이 다 뎍으리</sent><!--'섭섭'과 ‘답답ᄒᆞ기ᄅᆞᆯ’에서 뒤에 오는 '섭'과 ‘답’은 재점으로 표기되어 있음--> 
<sent type="main" lang="kor" page="11" n="04">사돈 병환이 지금 차복디 못ᄒᆞ오셔</sent>
<sent type="main" lang="kor" page="11" n="05">가ᄇᆡ얍디 아니신가 시브니 념녀 ᄀᆞ이업ᄉᆞ며</sent>
<sent type="main" lang="kor" page="11" n="06">네 ᄌᆞᆨ히 졀박ᄒᆞ여 ᄒᆞ랴</sent>
<sent type="main" lang="kor" page="11" n="07">더옥 일시도 닛디 못ᄒᆞᆯ다</sent>
<sent type="main" lang="kor" page="11" n="08">듀야 ᄇᆞ라고 기ᄃᆞ리던 ᄆᆞᄋᆞᆷ의 너ᄅᆞᆯ 종시 보디 못ᄒᆞ니</sent>
<sent type="main" lang="kor" page="11" n="09">답답 굼거오믈 견ᄃᆡ디 못ᄒᆞ니</sent><!--'답답'에서 뒤에 오는 '답'은 재점으로 표기되어 있음--> 
<sent type="main" lang="kor" page="11" n="10">날이나 츈화ᄒᆞ고 병환 수이 낫ᄌᆞ오셔 수이 보기ᄅᆞᆯ ᄇᆞ라며</sent>
<sent type="main" lang="kor" page="11" n="11">아마도 뫼와 평안히 디내기ᄅᆞᆯ ᄇᆞ라노라</sent>
<sent type="main" lang="kor" page="11" n="12">병오 납월 념이일</sent>
<sent type="main" lang="kor" page="11" n="13">고 홍ᄌᆔ 편지ᄂᆞᆫ 뎐ᄒᆞ고 답장 조초 맛다 보내마</sent>
</letter>

<letter n="12" sender="여주이씨(시어머니)" writer="여주이씨(시어머니)" receiver="덕수이씨(며느리)" year="1727년">
<sent type="main" lang="kor" page="12" n="01">새ᄒᆡ예 뫼ᄋᆞᆸ고 만복ᄒᆞᆫ 일 알고져 ᄒᆞ며</sent>
<sent type="main" lang="kor" page="12" n="02">ᄒᆡ 밧고여 날포 되여시ᄃᆡ 긔별도 듯디 못ᄒᆞ니 답답 섭섭ᄒᆞ고</sent><!--'답답'과 ‘섭섭ᄒᆞ고’에서 뒤에 오는 '답'과 ‘섭’은 재점으로 표기되어 있음--> 
<sent type="main" lang="kor" page="12" n="03">요ᄉᆞ이ᄂᆞᆫ 사돈 병환은 가감이 엇더ᄒᆞ오신고</sent>
<sent type="main" lang="kor" page="12" n="04">긔별도 듯ᄌᆞᆸ디 못ᄒᆞ니 이리 답답 념녀 ᄀᆞ이업다</sent><!--'답답'에서 뒤에 오는 '답'은 재점으로 표기되어 있음-->
<sent type="main" lang="kor" page="12" n="05">ᄇᆞᆯ셔 ᄒᆡ가 밧고이ᄃᆡ 볼 길히 업ᄉᆞ니 이리 답답 섭섭ᄒᆞ며</sent><!--'답답'과 ‘섭섭ᄒᆞ며’에서 뒤에 오는 '답'과 ‘섭’은 재점으로 표기되어 있음--> 
<sent type="main" lang="kor" page="12" n="06">ᄂᆡ월노 ᄃᆞ려오랴 ᄒᆞᄃᆡ</sent>
<sent type="main" lang="kor" page="12" n="07">거긔 병환이 채 낫디 못ᄒᆞ야 겨오시면</sent>
<sent type="main" lang="kor" page="12" n="08">네 ᄯᅥ나오기ᄅᆞᆯ 졀박ᄒᆞ야 ᄒᆞᆯ 거시매</sent>
<sent type="main" lang="kor" page="12" n="09">이리 결ᄯᅡᆫ을 못 ᄒᆞ고 이셔 답답ᄒᆞ니</sent><!--'답답ᄒᆞ니'에서 뒤에 오는 '답'은 재점으로 표기되어 있음-->
<sent type="main" lang="kor" page="12" n="10">훗 왕ᄂᆡ예 병환 가감을 브ᄃᆡ ᄌᆞ시 긔별ᄒᆞ여라</sent>
<sent type="main" lang="kor" page="12" n="11">마ᄎᆞᆷ 뎐뎐 가ᄂᆞᆫ 사ᄅᆞᆷ 잇다 ᄒᆞ매 안부나 알냐</sent>
<sent type="main" lang="kor" page="12" n="12">잠 뎍으며 셰후 날 나 심히 치우니 뫼ᄋᆞᆸ고</sent>
<sent type="main" lang="kor" page="12" n="13">내내 평안ᄒᆞᆷ ᄇᆞ라노라</sent><!--'내내'에서 뒤에 오는 '내'는 재점으로 표기되어 있음-->
<sent type="main" lang="kor" page="12" n="14">뎡미 원월 초칠일 싀모</sent>
</letter>

<letter n="13" sender="안동권씨(며느리)" writer="안동권씨(며느리)" receiver="박성한(시아버지)" year="1704년">
<sent type="main" lang="kor" page="13" n="01">문안 알외ᄋᆞᆸ고 일긔 가지록 극열ᄒᆞ오니</sent>
<sent type="main" lang="kor" page="13" n="02">요ᄉᆞ이ᄂᆞᆫ 평티 못ᄒᆞᄋᆞ오신 긔휘 엇더ᄒᆞᄋᆞ오시니잇가</sent>
<sent type="main" lang="kor" page="13" n="03">일졀 문안도 모ᄅᆞ오니 답답 복모 일시도 부리ᄋᆞᆸ디 못ᄒᆞ와</sent><!--'답답'에서 뒤에 오는 '답'은 재점으로 표기되어 있음--> 
<sent type="main" lang="kor" page="13" n="04">디내오며 피졉을 나 겨ᄋᆞ오셔 긔휘 엇더ᄒᆞᄋᆞ오시니잇가</sent>
<sent type="main" lang="kor" page="13" n="05">문안이나 아ᄋᆞᆸ고 ᄇᆞ라ᄋᆞᆸᄂᆞ이다</sent>
<sent type="main" lang="kor" page="13" n="06">뎌적 아현으로셔 사ᄅᆞᆷ 가ᄋᆞᆸ거ᄂᆞᆯ 샹셔 알외와ᄉᆞᆸ더니</sent>
<sent type="main" lang="kor" page="13" n="07">감ᄒᆞ오신가 ᄒᆞᄋᆞᆸᄂᆞ이다</sent>
<sent type="main" lang="kor" page="13" n="08">식도 창동의 졔ᄉᆞ 디내오려 드러와ᄉᆞ와</sent>
<sent type="main" lang="kor" page="13" n="09">호동 형님도 와 겨오시고 ᄃᆡ되 못ᄌᆞ 든든ᄒᆞ오나</sent><!--'든든ᄒᆞ오나'에서 뒤에 오는 '든'은 재점으로 표기되어 있음-->
<sent type="main" lang="kor" page="13" n="10">졔ᄉᆞᄅᆞᆯ 디ᄂᆡ오니 새로이 슬프온 듕</sent>
<sent type="main" lang="kor" page="13" n="11">한마님 긔휘 지금 차복디 못ᄒᆞᄋᆞ오시니</sent>
<sent type="main" lang="kor" page="13" n="12">민망 졀박ᄒᆞ오ᄆᆞᆯ 어이 다 알외오리잇가</sent>
<sent type="main" lang="kor" page="13" n="13">알올 말ᄉᆞᆷ 감ᄒᆞᄋᆞ오심 젓ᄉᆞ와 이만 알외오며</sent>
<sent type="main" lang="kor" page="13" n="14">극열의 내내 긔후 안녕ᄒᆞᄋᆞ오심 ᄇᆞ라ᄋᆞᆸᄂᆞ이다</sent><!--'내내'에서 뒤에 오는 '내'는 재점으로 표기되어 있음-->
<sent type="main" lang="kor" page="13" n="15">갑신 칠월 초삼일 식 샹셔</sent> 
</letter>

<letter n="14" sender="안동권씨(할머니)" writer="안동권씨(할머니)" receiver="박경규(손자)" year="1762~1767년*">
<sent type="envelop1-1" lang="kor" page="14" n="01">손ᄌᆞ 답</sent>
<sent type="main" lang="kor" page="14" n="02">간 디 날포 되니 섭섭 못 닛ᄌᆞᆯ어니</sent><!--'섭섭'에서 뒤에 오는 '섭'은 재점으로 표기되어 있음-->  
<sent type="main" lang="kor" page="14" n="03">글시 보고 본 듯 반기며 됴히 이시니 든든 다ᄒᆡᆼᄒᆞᄃᆡ</sent><!--'든든'에서 뒤에 오는 '든'은 재점으로 표기되어 있음--> 
<sent type="main" lang="kor" page="14" n="04">공부도 그리 챡실치 못ᄒᆞᆫᄃᆡ</sent>
<sent type="main" lang="kor" page="14" n="05">번요ᄒᆞᆫ 집의 가 날포 겻기ᄂᆞᆫ 일 민망터니</sent>
<sent type="main" lang="kor" page="14" n="06">문의로 수이 가려노라 ᄒᆞ여시니</sent>
<sent type="main" lang="kor" page="14" n="07">게 가셔나 챡실히 지을가 다ᄒᆡᆼᄒᆞ다</sent>
<sent type="main" lang="kor" page="14" n="08">진ᄉᆞᄂᆞᆫ ᄯᅥ나간 디 날포 되고</sent>
<sent type="main" lang="kor" page="14" n="09">간 후 긔별도 듯디 못ᄒᆞ니 답답더니</sent><!--'답답더니'에서 뒤에 오는 '답'은 재점으로 표기되어 있음-->
<sent type="main" lang="kor" page="14" n="10">무ᄉᆞ히 가셔 두로 도라 ᄂᆡ일 오ᄂᆞᆫ가 시부니 든든 다ᄒᆡᆼᄒᆞ다</sent><!--'든든'에서 뒤에 오는 '든'은 재점으로 표기되어 있음-->
<sent type="main" lang="kor" page="14" n="11">여긔ᄂᆞᆫ 구샹도 나아셔 샹ᄒᆞ고 무ᄉᆞᄒᆞᄃᆡ</sent>
<sent type="main" lang="kor" page="14" n="12">형님긔셔 홍ᄌᆔ 상ᄉᆞ 긔별 들으시고 비텩ᄒᆞ오시니 블샹 ᄀᆞ이업다</sent>
<sent type="main" lang="kor" page="14" n="13">부침말은 챡실ᄒᆞ량이면 무명 필이나 보내여 무엇 ᄒᆞ여 오고 시부니</sent>
<sent type="main" lang="kor" page="14" n="14">가ᄂᆞᆫ 사ᄅᆞᆷᄃᆞ려도 잘ᄒᆞ여다가 줄가 뭇고</sent>
<sent type="main" lang="kor" page="14" n="15">네 쳐남ᄃᆞ려도 허소치 아니ᄒᆞ여 챡실히 ᄒᆞ여다가 줄가</sent>
<sent type="main" lang="kor" page="14" n="16">ᄌᆞ시히 의논ᄒᆞ여 의심 업ᄉᆞ리라 ᄒᆞ거든</sent>
<sent type="main" lang="kor" page="14" n="17">올 ᄯᅢ 그 사ᄅᆞᆷ을 보고 도라가셔 보낼 거시니</sent>
<sent type="main" lang="kor" page="14" n="18">만치 아닌 거시니 부ᄃᆡ 잘ᄒᆞ여 달나고 맛초고 와셔 의논ᄒᆞ여 보내쟈</sent>
<sent type="main" lang="kor" page="14" n="19">브ᄎᆡᄂᆞᆫ 셩ᄌᆔ셔 다ᄉᆞᆺ ᄌᆞ로 왓ᄂᆞᆫᄃᆡ</sent>
<sent type="main" lang="kor" page="14" n="20">이 뉴가 세히매 ᄒᆞ나 보낸다</sent>
<sent type="main" lang="kor" page="14" n="21">형님긔셔ᄂᆞᆫ 밤이라 답장 못ᄒᆞ신다</sent>
<sent type="main" lang="kor" page="14" n="22">니현 긔별 듯디 못ᄒᆞ니 답답ᄒᆞ며</sent><!--'답답ᄒᆞ며'에서 뒤에 오는 '답'은 재점으로 표기되어 있음--> 
<sent type="main" lang="kor" page="14" n="23">이 편지나 보내여 보게 ᄒᆞ여라</sent>
<sent type="main" lang="kor" page="14" n="24">구샹이ᄂᆞᆫ 아부지 애씨ᄂᆞᆫ 보고 시부디 아니코</sent>
<sent type="main" lang="kor" page="14" n="25">하아부지 보고 시부다 ᄒᆞ니 웃노라</sent>
<sent type="main" lang="kor" page="14" n="26">편지 너허 온 당ᄌᆞᆰ을 진동한동 푸러 보고</sent>
<sent type="main" lang="kor" page="14" n="27">아무것도 아니 왓다고 셩내여</sent>
<sent type="main" lang="kor" page="14" n="28">하아부지 편지나 날나고 우니 모다 ᄒᆞᆫ ᄎᆞ례 우섯다</sent>
<sent type="main" lang="kor" page="14" n="29">셔강 답장 보내여시니 무ᄉᆞᄒᆞᆫ 긔별 알고 깃부다</sent>
<sent type="main" lang="kor" page="14" n="30">내내 됴히 디내고 공부나 챡실히 ᄒᆞ기ᄅᆞᆯ ᄇᆞ라노라</sent><!--'내내'에서 뒤에 오는 '내'는 재점으로 표기되어 있음--> 
<sent type="main" lang="kor" page="14" n="31">십칠 야 조모</sent>
</letter>

<letter n="15" sender="덕수이씨(아내)" writer="덕수이씨(아내)" receiver="박춘영(남편)" year="1762~1785년">
<sent type="envelop1-2" lang="kor" page="15" n="01">ᄒᆡᆼᄎᆞ 입납</sent>
<sent type="envelop1-2" lang="kor" page="15" n="02">근봉</sent>
<sent type="main" lang="kor" page="15" n="03">ᄒᆡᆼᄎᆞ 들러 나오신 후 긔별 모ᄅᆞ오니</sent>
<sent type="main" lang="kor" page="15" n="04">날이 그동안 됴하ᄉᆞ오니 무ᄉᆞ히 가오시고</sent>
<sent type="main" lang="kor" page="15" n="05">엇지 디ᄂᆡ오시며</sent>
<sent type="main" lang="kor" page="15" n="06">갈망골은 ᄂᆡ일 가오시ᄂᆞᆫ가 답답 념이오며</sent><!--'답답'에서 뒤에 오는 '답'은 재점으로 표기되어 있음--> 
<sent type="main" lang="kor" page="15" n="07">경산셔 ᄒᆞ오신 편지ᄂᆞᆫ 보ᄋᆞᆸ고</sent>
<sent type="main" lang="kor" page="15" n="08">ᄀᆞᆺ은 즉시 주엇다 ᄒᆞᄋᆞᆸ</sent>
<sent type="main" lang="kor" page="15" n="09">우리ᄂᆞᆫ 아ᄒᆡ은 다 잘 잇ᄉᆞ오되</sent>
<sent type="main" lang="kor" page="15" n="10">구샹의 안부 지금 못 드러 그립ᄉᆞ오며</sent>
<sent type="main" lang="kor" page="15" n="11">가ᄂᆡ 고약을 ᄂᆡ일 보내랴 ᄒᆞ오니</sent>
<sent type="main" lang="kor" page="15" n="12">도라와야 구샹 긔별 듯게 ᄒᆞ여ᄉᆞᆸ</sent>
<sent type="main" lang="kor" page="15" n="13">쇠돌 가오니 뎍ᄉᆞ오며 평안히 도라오시기 ᄇᆞ라ᄋᆞᆸᄂᆞ이다</sent>
<sent type="main" lang="kor" page="15" n="14">이월 념뉵일 니</sent>
</letter>

<letter n="16" sender="덕수이씨(어머니)" writer="덕수이씨(어머니)" receiver="박경규(아들)" year="1784~1790년">
<sent type="envelop1-1" lang="kor" page="16" n="01">쳥양의게</sent>
<sent type="main" lang="kor" page="16" n="02">금쇠 ᄯᅥ나보내고 하인 다시 오기 기ᄃᆞ렷더니</sent>
<sent type="main" lang="kor" page="16" n="03">의외 하인 오고 무ᄉᆞ히 디ᄂᆡᄂᆞᆫ 안부 아니 싀훤 깃부다</sent>
<sent type="main" lang="kor" page="16" n="04">날이 비 오게 ᄒᆞ여시니</sent>
<sent type="main" lang="kor" page="16" n="05">길희셔 묵ᄂᆞᆫ다 ᄒᆞ고</sent>
<sent type="main" lang="kor" page="16" n="06">ᄂᆡ일 못 들가 시부다</sent>
<sent type="main" lang="kor" page="16" n="07">예도 일양 잘 디ᄂᆡ며 진ᄉᆞ집 ᄒᆡ산 긔미 업다</sent>
<sent type="main" lang="kor" page="16" n="08">진ᄉᆞᄂᆞᆫ 합고의 올나 못 ᄒᆞ고</sent>
<sent type="main" lang="kor" page="16" n="09">오ᄂᆞᆯ 긔동의 가 자고 식후 나와 삭갑 만나고</sent>
<sent type="main" lang="kor" page="16" n="10">어ᄂᆞ날 ᄯᅩ 급히 갈 줄 모ᄅᆞ니 민망ᄒᆞ다</sent>
<sent type="main" lang="kor" page="16" n="11">ᄀᆞᆯ니 오ᄌᆞᆨ히 굴그냐</sent>
<sent type="main" lang="kor" page="16" n="12">ᄂᆡ고 샹이 됴치 못ᄒᆞ고 못 내여 ᄡᅳ고 건에 사고 고ᄒᆞ니</sent><!--'사고 고ᄒᆞ니'에서 뒤에 오는 '고'는 재점으로 표기되어 있음-->  
<sent type="main" lang="kor" page="16" n="13">동서 온다니 ᄋᆡ봉의 ᄀᆞᄅᆞ 다엿 마 보ᄂᆡ면 깃불다</sent>
<sent type="main" lang="kor" page="16" n="14">ᄋᆡ봉의 죄상은 괘심ᄒᆞ나</sent>
<sent type="main" lang="kor" page="16" n="15">도시 미련ᄒᆞ여 냥반이 무엇 둇다고 됴히 넉여 그리ᄒᆞ여시니</sent>
<sent type="main" lang="kor" page="16" n="16">듕히 알코 나시니</sent>
<sent type="main" lang="kor" page="16" n="17">브ᄃᆡ 듕히 치죄 말고 본이나 뵈여라</sent>
<sent type="main" lang="kor" page="16" n="18">섭섭 잠 뎍ᄂᆞᆫ다 ᄇᆡᆨ지 다 ᄡᅥ시니 보내여라</sent><!--'섭섭'에서 뒤에 오는 '섭'은 재점으로 표기되어 있음--> 
<sent type="main" lang="kor" page="16" n="19">칠월 십이일 모</sent>
<sent type="main" lang="kor" page="16" n="20">대단 치죄ᄒᆞ면 샹뎐 원ᄒᆞ여 됴히 넉이다가 블샹ᄒᆞ니 감ᄒᆞ여라</sent>
</letter>

<letter n="17" sender="덕수이씨(할머니)" writer="덕수이씨(할머니)" receiver="박종순(손자)" year="1783~1790년">
<sent type="envelop1-2" lang="kor" page="17" n="01">진ᄉᆞ의게</sent>
<sent type="main" lang="kor" page="17" n="02">날포 긔별 다시 업ᄉᆞ니 답답 기ᄃᆞ리며</sent><!--'답답'에서 뒤에 오는 '답'은 재점으로 표기되어 있음--> 
<sent type="main" lang="kor" page="17" n="03">여긔 편지ᄂᆞᆫ 년ᄒᆞ여 보아실 거시니</sent>
<sent type="main" lang="kor" page="17" n="04">외오셔 념녀ᄒᆞᄂᆞᆫ 일 도로혀 민망ᄒᆞ다</sent>
<sent type="main" lang="kor" page="17" n="05">그동안 뫼시고 엇지 잇ᄂᆞ니</sent>
<sent type="main" lang="kor" page="17" n="06">비 오고 졸연 과히 치워시니</sent>
<sent type="main" lang="kor" page="17" n="07">옷도 엷고 곳불이 응당 드러시리라</sent>
<sent type="main" lang="kor" page="17" n="08">ᄃᆞᆯ이 밧고이니 날 가기만 기ᄃᆞ린다</sent>
<sent type="main" lang="kor" page="17" n="09">사돈 긔운은 엇더ᄒᆞ신고 ᄒᆡᆼ역은 엇지ᄒᆞ오실고</sent>
<sent type="main" lang="kor" page="17" n="10">졈은 ᄃᆡᆨ 치미ᄂᆞᆫ 거ᄉᆞᆫ 덜ᄒᆞᆫ가</sent>
<sent type="main" lang="kor" page="17" n="11">ᄲᅵ텨 오시기 어렵ᄉᆞ오실 거시니</sent>
<sent type="main" lang="kor" page="17" n="12">식보나 ᄒᆞ오셔야 길ᄒᆡ셔 큰일 나리라</sent>
<sent type="main" lang="kor" page="17" n="13">나ᄂᆞᆫ 수일재도 술 덜니고</sent>
<sent type="main" lang="kor" page="17" n="14">범졀이 ᄎᆞᄎᆞ 나아갈 쟉시ᄂᆞᆫ 먹기ᄂᆞᆫ 샹ᄒᆡ나 다ᄅᆞ지 아니나</sent><!--'ᄎᆞᄎᆞ'에서 뒤에 오는 'ᄎᆞ'는 재점으로 표기되어 있음--> 
<sent type="main" lang="kor" page="17" n="15">쾌히 낫지 아니키 괴롭다</sent>
<sent type="main" lang="kor" page="17" n="16">네 부다니ᄂᆞᆫ 나아셔도 굴신이 임의 보이지 아니라</sent>
<sent type="main" lang="kor" page="17" n="17">이졔 쇼ᄌᆡ ᄂᆡ일은 드러갈 거시니</sent>
<sent type="main" lang="kor" page="17" n="18">쇼식 듯게 ᄒᆞ여시니 ᄌᆞᆨ히 기ᄃᆞ리랴</sent>
<sent type="main" lang="kor" page="17" n="19">죳그만 년 모여 됴히 잇고</sent>
<sent type="main" lang="kor" page="17" n="20">조년 가 볼 적 아ᄌᆞ미ᄭᅴ셔</sent>
<sent type="main" lang="kor" page="17" n="21">이거시 개냐 사ᄅᆞᆷ이냐 그리ᄒᆞᄂᆞᆫᄃᆡ</sent>
<sent type="main" lang="kor" page="17" n="22">너ᄂᆞᆫ 무어시라 ᄒᆞ니 사ᄅᆞᆷ이라 ᄒᆞ엿노라 ᄒᆞ고</sent>
<sent type="main" lang="kor" page="17" n="23">소문을 ᄎᆞᄎᆞᄒᆞ니 웃노라</sent>
<sent type="main" lang="kor" page="17" n="24">ᄉᆡᆼ원님 수일 후 ᄯᅥ나가랴</sent>
<sent type="main" lang="kor" page="17" n="25">죵은 아직도 그 서러저 가ᄂᆞᆫ 심ᄉᆞ 하 긋치시니</sent>
<sent type="main" lang="kor" page="17" n="26">그런 악연ᄒᆞᆫ 일 어듸 이리 삭ᄉᆞ로 아긔ᄂᆡ 가니</sent>
<sent type="main" lang="kor" page="17" n="27">잠 뎍으며 됴히 디내기 ᄇᆞ란다</sent>
<sent type="main" lang="kor" page="17" n="28">구월 초일일 조모</sent>
</letter>

<letter n="18" sender="경주이씨(며느리)" writer="경주이씨(며느리)" receiver="박춘영(시아버지)" year="1760년">
<sent type="envelop1-2" lang="kor" page="18" n="01">아바님 젼 답샹ᄉᆞᆯ이</sent>
<sent type="envelop1-2" lang="kor" page="18" n="02">근봉</sent>
<sent type="main" lang="kor" page="18" n="03">문안 알외ᄋᆞᆸ고</sent>
<sent type="main" lang="kor" page="18" n="04">셜한의 긔후 안녕ᄒᆞ오신 문안 아ᄋᆞᆸ고져 ᄇᆞ라오며</sent>
<sent type="main" lang="kor" page="18" n="05">뎌적 죵 오ᄋᆞᆸᄂᆞᆫᄃᆡ 하셔 밧ᄌᆞ와 보ᄋᆞᆸ고</sent>
<sent type="main" lang="kor" page="18" n="06">그ᄯᅢ 긔후 안녕ᄒᆞ오신 문안 아ᄋᆞᆸ고</sent>
<sent type="main" lang="kor" page="18" n="07">하졍의 더옥 다ᄒᆡᆼ 못내 알외와 ᄒᆞᄋᆞᆸᄂᆞ이다</sent>
<sent type="main" lang="kor" page="18" n="08">알외올 말ᄉᆞᆷ 하감ᄒᆞ오심 젓ᄉᆞ와 이만 알외오며</sent>
<sent type="main" lang="kor" page="18" n="09">내내 긔톄 안녕ᄒᆞ오심 ᄇᆞ라ᄋᆞᆸᄂᆞ이다</sent><!--'내내'에서 뒤에 오는 '내'는 재점으로 표기되어 있음--> 
<sent type="main" lang="kor" page="18" n="10">경진 원월 십팔일 ᄌᆞ부 ᄉᆞᆯ이</sent>
</letter>

<letter n="19" sender="경주이씨(며느리)" writer="경주이씨(며느리)" receiver="박춘영(시아버지)" year="1761년">
<sent type="main" lang="kor" page="19" n="01">문안 알외ᄋᆞᆸ고 사ᄅᆞᆷ 오와ᄂᆞᆯ 하셔 밧ᄌᆞ와 보ᄋᆞᆸ고</sent>
<sent type="main" lang="kor" page="19" n="02">일긔 덥ᄉᆞ온ᄃᆡ 긔후 안녕ᄒᆞ오신 문안 아ᄋᆞᆸ고</sent>
<sent type="main" lang="kor" page="19" n="03">하졍의 다ᄒᆡᆼ 못내 알외와 ᄒᆞ오며</sent>
<sent type="main" lang="kor" page="19" n="04">병보션 ᄯᅳ지ᄂᆞᆫ ᄌᆞ시 밧ᄌᆞ왓ᄉᆞᆸᄂᆞ이다</sent>
<sent type="main" lang="kor" page="19" n="05">그ᄅᆞᄉᆞᆫ 하교대로 ᄑᆞ올가 ᄒᆞᄋᆞᆸᄂᆞ이다</sent>
<sent type="main" lang="kor" page="19" n="06">ᄌᆞ부ᄂᆞᆫ 요ᄉᆞ이ᄂᆞᆫ 낫ᄌᆞ와 디내ᄋᆞᆸᄂᆞ이다</sent>
<sent type="main" lang="kor" page="19" n="07">알외올 말ᄉᆞᆷ 하감ᄒᆞ오심 젓ᄉᆞ와 이만 알외오며</sent>
<sent type="main" lang="kor" page="19" n="08">내내 긔쳬 안녕ᄒᆞ오심 ᄇᆞ라ᄋᆞᆸᄂᆞ이다</sent><!--'내내'에서 뒤에 오는 '내'는 재점으로 표기되어 있음-->
<sent type="main" lang="kor" page="19" n="09">신ᄉᆞ ᄉᆞ월 초일일 ᄌᆞ부 ᄉᆞᆯ이</sent>
</letter>

<letter n="20" sender="연산서씨(어머니)" writer="연산서씨(어머니)" receiver="박종순(아들)" year="1795년">
<sent type="envelop1-1" lang="kor" page="20" n="01">평ᄉᆞ 답</sent>
<sent type="envelop1-1" lang="kor" page="20" n="02">봉</sent>
<sent type="main" lang="kor" page="20" n="03">거월 십 이십날 편지 석 쟝 초ᄉᆞ일 낭쳥집으로 어더 보고</sent>
<sent type="main" lang="kor" page="20" n="04">답장 부치고 ᄯᅩ 편지 기ᄃᆞ리더니</sent>
<sent type="main" lang="kor" page="20" n="05">거월 념이일 편지 므ᄉᆞᆫ 쟝계편인지</sent>
<sent type="main" lang="kor" page="20" n="06">십칠 일 만의 편지 어더 보니 신긔 반갑고 겸ᄒᆞ야</sent>
<sent type="main" lang="kor" page="20" n="07">몸이 무ᄉᆞᄒᆞ게 지ᄂᆡ노라 ᄒᆞ여시니 다ᄒᆡᆼ다ᄒᆡᆼ 깃부기 ᄀᆞ이업ᄉᆞ며</sent><!--'다ᄒᆡᆼ다ᄒᆡᆼ'에서 뒤에 오는 '다ᄒᆡᆼ'은 재점으로 표기되어 있음--> 
<sent type="main" lang="kor" page="20" n="08">개시ᄂᆞᆫ 쥬야의 념녀가 되고</sent>
<sent type="main" lang="kor" page="20" n="09">엇지 지나칠 거시ᄆᆡ 민망터니</sent>
<sent type="main" lang="kor" page="20" n="10">편지 ᄉᆞ연 보니 다ᄒᆡᆼᄒᆞᄃᆡ</sent>
<sent type="main" lang="kor" page="20" n="11">ᄇᆞᆯ 흥졍은 엇지 되여 ᄀᆞᄂᆞᆫ다</sent>
<sent type="main" lang="kor" page="20" n="12">ᄆᆞᆺ츤 긔별 다시 듯지 못ᄒᆞ니</sent>
<sent type="main" lang="kor" page="20" n="13">이리 굼굼ᄒᆡ 왕ᄂᆡ예 그런 극한의 감긔나 업ᄂᆞᆫ가</sent><!--'굼굼히'에서 뒤에 오는 '굼'은 재점으로 표기되어 있음-->
<sent type="main" lang="kor" page="20" n="14">념녀 노히들 아니ᄒᆞᄂᆡ</sent>
<sent type="main" lang="kor" page="20" n="15">집의셔도 ᄒᆞᆫ가지로 지ᄂᆡ고</sent>
<sent type="main" lang="kor" page="20" n="16">슈쳑 오ᄂᆞᆯ이야 오니 고젹ᄒᆞ던 집안이 웃음이 절노 나</sent>
<sent type="main" lang="kor" page="20" n="17">고젹ᄒᆞᆫ 줄을 닛고 든든ᄒᆞ나</sent><!--'든든ᄒᆞ나'에서 뒤에 오는 '든'은 재점으로 표기되어 있음-->
<sent type="main" lang="kor" page="20" n="18">안질 슈쳑은 오ᄂᆞᆯ부터 죠곰 낫고 증이ᄂᆞᆫ 고극ᄒᆞ니 민망ᄒᆞ고</sent>
<sent type="main" lang="kor" page="20" n="19">이리도 더ᄒᆞᆫ 일은 업ᄉᆞᄃᆡ 낫지 아니ᄒᆞ니 민망ᄒᆡ</sent>
<sent type="main" lang="kor" page="20" n="20">증낭은 아니된다 ᄒᆞ되 셰후 즉시 ᄯᅥ나올 ᄃᆞᆺᄒᆞᄃᆡ</sent>
<sent type="main" lang="kor" page="20" n="21">셰후 치위도 하 무셔우니</sent>
<sent type="main" lang="kor" page="20" n="22">그 가히ᄂᆞᆫ 더ᄒᆞᆯ ᄃᆞᆺ 이러ᄒᆞ면 못 ᄯᅥ날 거시니</sent>
<sent type="main" lang="kor" page="20" n="23">날셰 보아 가며 ᄯᅥ나오게 ᄒᆞ고</sent>
<sent type="main" lang="kor" page="20" n="24">이 편지 가노라면 길희셔 볼 ᄃᆞᆺᄒᆡ</sent>
<sent type="main" lang="kor" page="20" n="25">졔ᄉᆞ도 ᄉᆞ오일 격ᄒᆞ야 겨오시니</sent>
<sent type="main" lang="kor" page="20" n="26">년년의 심ᄉᆞ 형용치 못ᄒᆞ던ᄃᆡ</sent><!--'년년의'에서 뒤에 오는 '년'은 재점으로 표기되어 있음--> 
<sent type="main" lang="kor" page="20" n="27">올흔 ᄒᆞᆫ가지로 못 지내ᄋᆞᆸ게시니 미리 섭섭 다 못 뎍ᄂᆡ</sent><!--'섭섭'에서 뒤에 오는 '섭'은 재점으로 표기되어 있음--> 
<sent type="main" lang="kor" page="20" n="28">을묘 원월 초팔일 야 모</sent>
</letter>

<letter n="21" sender="연산서씨(어머니)" writer="연산서씨(어머니)" receiver="박종순(아들)" year="1775~1803년*">
<sent type="envelop1-1" lang="kor" page="21" n="01">원의게</sent>
<sent type="envelop1-1" lang="kor" page="21" n="02">봉 봉</sent>
<sent type="main" lang="kor" page="21" n="03">날포 길ᄒᆡ 엇지 가ᄂᆞᆫ고 념녀 노히들 아니ᄒᆞ며</sent>
<sent type="main" lang="kor" page="21" n="04">오ᄂᆞᆯ은 드러가려니와</sent>
<sent type="main" lang="kor" page="21" n="05">ᄯᅥ난 후 날이 그리 칩지 아니ᄒᆞ니 다ᄒᆡᆼᄒᆞ며</sent>
<sent type="main" lang="kor" page="21" n="06">쳬증이나 업ᄂᆞᆫ가</sent>
<sent type="main" lang="kor" page="21" n="07">아듕은 대되 므ᄉᆞᄒᆞ고</sent>
<sent type="main" lang="kor" page="21" n="08">부인 젹괴ᄂᆞᆫ 죵시 쾌히 낫지 아니ᄒᆞ니 민망ᄒᆞ여 뵈ᄂᆡ</sent>
<sent type="main" lang="kor" page="21" n="09">문안 하인 가더니 아니 오니</sent>
<sent type="main" lang="kor" page="21" n="10">오ᄂᆞᆯ ᄉᆞ이나 올가 기ᄃᆞ리ᄂᆡ</sent>
<sent type="main" lang="kor" page="21" n="11">문안 하인 간다기 잠 뎍으며 므ᄉᆞ히 쉬이 오기 기ᄃᆞ리ᄂᆡ</sent>
<sent type="main" lang="kor" page="21" n="12">십월 념구일 모</sent>
</letter>
